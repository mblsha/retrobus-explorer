use shared_components::{
    message_stream::{ByteMsgStreamOut, ByteMsgStreamState, TxReq8, tx_req_indexed, tx_req_none},
};

use super::bus_debug::SaleaeState;

type ConsoleIdx = uint<16>;

fn max_wait_digit() -> uint<8> {
    9
}

pub(lib) enum ConsoleCmd {
    None,
    Arm,
    Lock,
    RemoteOn,
    RemoteOff,
    FtOn,
    FtOff,
    Help,
    Status,
    PinMap,
    Unknown,
}

pub(lib) enum ConsoleMsg {
    None,
    Ok,
    Err,
    Help,
    Status,
    PinMap,
}

impl ConsoleCmd {
    fn key(self) -> uint<8> {
        match self {
            Self::None => 0,
            Self::Arm => b'a',
            Self::Lock => b'k',
            Self::RemoteOn => b'p',
            Self::RemoteOff => b'o',
            Self::FtOn => b'f',
            Self::FtOff => b'x',
            Self::Help => b'h',
            Self::Status => b'q',
            Self::PinMap => b'l',
            Self::Unknown => 0,
        }
    }
}

impl ConsoleMsg {
    fn is_none(self) -> bool {
        if let Self::None = self { true } else { false }
    }

    fn byte(self, idx: ConsoleIdx, ctx: ConsoleMsgContext) -> TxReq8 {
        match self {
            Self::None => tx_req_none(),
            Self::Ok => tx_req_indexed(b"ok\r\n", idx),
            Self::Err => tx_req_indexed(b"err\r\n", idx),
            Self::Help => help_msg_byte(idx),
            Self::Status => ctx.status_byte(idx),
            Self::PinMap => ctx.saleae_state.map_byte(idx),
        }
    }
}

pub(lib) fn console_cmd_from_byte(byte: uint<8>) -> ConsoleCmd {
    match byte.to_upper() {
        b if b == ConsoleCmd::Arm.key().to_upper() => ConsoleCmd::Arm(),
        b if b == ConsoleCmd::Lock.key().to_upper() => ConsoleCmd::Lock(),
        b if b == ConsoleCmd::RemoteOn.key().to_upper() => ConsoleCmd::RemoteOn(),
        b if b == ConsoleCmd::RemoteOff.key().to_upper() => ConsoleCmd::RemoteOff(),
        b if b == ConsoleCmd::FtOn.key().to_upper() => ConsoleCmd::FtOn(),
        b if b == ConsoleCmd::FtOff.key().to_upper() => ConsoleCmd::FtOff(),
        b if b == ConsoleCmd::Help.key().to_upper() => ConsoleCmd::Help(),
        b if b == ConsoleCmd::Status.key().to_upper() => ConsoleCmd::Status(),
        b if b == ConsoleCmd::PinMap.key().to_upper() => ConsoleCmd::PinMap(),
        _ => ConsoleCmd::Unknown(),
    }
}

pub(lib) struct ConsoleMsgContext {
    wait_enabled: uint<8>,
    saleae_state: SaleaeState,
    ft_enabled: bool,
    ft_remote_allowed: bool,
    ft_armed: bool,
}

impl ConsoleMsgContext {
    fn wait_char(self) -> uint<8> {
        let max_wait = max_wait_digit();
        let d = if self.wait_enabled > max_wait {
            max_wait
        } else {
            self.wait_enabled
        };
        b'0' +. d
    }

    fn status_byte(self, idx: ConsoleIdx) -> TxReq8 {
        let msg = b"stat f="
            .concat([self.ft_enabled.digit_char()])
            .concat(b" r=").concat([self.ft_remote_allowed.digit_char()])
            .concat(b" a=").concat([self.ft_armed.digit_char()])
            .concat(b" w=").concat([self.wait_char()])
            .concat(b" m=").concat([self.saleae_state.mode_char()])
            .concat(b"\r\n");
        tx_req_indexed(msg, idx)
    }
}

impl SaleaeState {
    fn mode_char(self) -> uint<8> {
        match self {
            Self::DataSignals => b'd',
            Self::SyncSignals => b's',
            Self::EdgeSignals => b'e',
            Self::RawSignals => b'r',
            Self::Counter => b'c',
        }
    }

    fn map_byte(self, idx: ConsoleIdx) -> TxReq8 {
        let msg = b"map mode="
            .concat([self.mode_char()]).concat(b"\r\n")
            .concat(b"d: d0=wr_sync d1=rd_sync d2=iorq_sync d3=mreq_sync\r\n")
            .concat(b"   d4=m1_sync d5=data_uart d6=char_uart d7=addr_uart\r\n")
            .concat(b"s: d0=wr_rise d1=rd_rise d2=mreq_fall d3=m1_sync d4=wr_sync d5=rd_sync d6=iorq_sync d7=mreq_sync\r\n")
            .concat(b"e: d0=wr_rise d1=rd_rise d2=iorq_fall d3=mreq_fall d4=wr_sync d5=rd_sync d6=iorq_sync d7=mreq_sync\r\n")
            .concat(b"r: d0=wr_raw d1=rd_raw d2=iorq_raw d3=mreq_raw d4=wr_sync d5=rd_sync d6=iorq_sync d7=mreq_sync\r\n")
            .concat(b"c: d0..d7=ctr[0..7]\r\n")
            .concat(b"legend: u=uart s=sync ^=fall n=active_low\r\n")
            .concat(b"legend char_uart: M=op_fetch R=mem_rd r=io_rd W=mem_wr w=io_wr\r\n");
        tx_req_indexed(msg, idx)
    }
}

/// ` <key><text>`, the shape of every single-key help line.
#[inline]
fn key_line<#uint N>(key: uint<8>, text: [uint<8>; N]) -> [uint<8>; {N + 2}] {
    b" ".concat([key]).concat(text)
}

/// ` <on>/<off><text>`, the shape of every help line that names a pair.
#[inline]
fn key_pair_line<#uint N>(on: uint<8>, off: uint<8>, text: [uint<8>; N]) -> [uint<8>; {N + 4}] {
    b" ".concat([on]).concat(b"/").concat([off]).concat(text)
}

/// `<char><text>`, one entry of the saleae-mode legend.
#[inline]
fn mode_legend_entry<#uint N>(state: SaleaeState, text: [uint<8>; N]) -> [uint<8>; {N + 1}] {
    [state.mode_char()].concat(text)
}

fn help_msg_byte(idx: ConsoleIdx) -> TxReq8 {
    let mode_keys = [
        SaleaeState::DataSignals().mode_char(),
        b'/',
        SaleaeState::SyncSignals().mode_char(),
        b'/',
        SaleaeState::EdgeSignals().mode_char(),
        b'/',
        SaleaeState::RawSignals().mode_char(),
        b'/',
        SaleaeState::Counter().mode_char(),
    ];
    let msg = b"Help:\r\n"
        .concat(key_line(ConsoleCmd::Help().key(), b" : show help\r\n"))
        .concat(key_line(ConsoleCmd::Status().key(), b" : show status (f,r,a,w,m)\r\n"))
        .concat(key_line(ConsoleCmd::PinMap().key(), b" : show saleae map + legend\r\n"))
        .concat(b" ").concat(mode_keys).concat(b" : select saleae mode\r\n")
        .concat(b"   ")
        .concat(mode_legend_entry(SaleaeState::DataSignals(), b"=data "))
        .concat(mode_legend_entry(SaleaeState::SyncSignals(), b"=sync "))
        .concat(mode_legend_entry(SaleaeState::EdgeSignals(), b"=edge "))
        .concat(mode_legend_entry(SaleaeState::RawSignals(), b"=raw "))
        .concat(mode_legend_entry(SaleaeState::Counter(), b"=counter\r\n"))
        .concat(b" 0..9 : set wait level (0=min wait)\r\n")
        .concat(key_pair_line(ConsoleCmd::Arm().key(), ConsoleCmd::Lock().key(),
            b" : arm or lock FT control\r\n"))
        .concat(key_pair_line(ConsoleCmd::RemoteOn().key(), ConsoleCmd::RemoteOff().key(),
            b" : allow or block FT remote\r\n"))
        .concat(key_pair_line(ConsoleCmd::FtOn().key(), ConsoleCmd::FtOff().key(),
            b" : force FT stream on/off\r\n"))
        .concat(b" legend char_uart: M=op_fetch R=mem_rd r=io_rd W=mem_wr w=io_wr\r\n")
        .concat(b" note: commands are case-insensitive\r\n");
    tx_req_indexed(msg, idx)
}

pub(lib) fn console_stream_step(
    stream: ByteMsgStreamState<ConsoleMsg, 16>,
    ctx: ConsoleMsgContext,
    block_tx: bool,
    next_msg_valid: bool,
    next_msg: ConsoleMsg,
) -> ByteMsgStreamOut<ConsoleMsg, 16> {
    stream.step_with(
        ConsoleMsg::None(),
        fn |msg| { msg.is_none() },
        fn |msg, idx| { msg.byte(idx, ctx) },
        block_tx,
        next_msg_valid,
        next_msg,
    )
}
