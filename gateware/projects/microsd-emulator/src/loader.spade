use std::mem::{clocked_memory, read_memory};
use shared_components::sd::crc32_byte;

// Fixed packet: MSD1, opcode, three zero bytes, sector u32, sequence u32,
// 512 payload bytes, IEEE CRC32 over the first 528 bytes. All integers LE.
// 1=write 512-byte resident sector; 2=arm after all 128 sectors; 3=disarm/reset map.
// No image memory writes occur until packet CRC and bounds have been validated.
#[no_mangle(all)]
pub entity image_loader(
    clk: clock,
    rst: bool,
    status_word: uint<32>,
    rx_valid: bool,
    rx_byte: uint<8>,
    tx_ready: bool,
    tx_valid: inv &bool,
    tx_byte: inv &uint<8>,
    load_ready: bool,
    load_valid: inv &bool,
    load_address: inv &uint<32>,
    load_byte: inv &uint<8>,
    armed: inv &bool,
    status_selector: inv &uint<7>,
) {
    let WRITE_SECTOR: uint<8> = 1;
    let ARM_CARD: uint<8> = 2;
    let DISARM_CARD: uint<8> = 3;
    let READ_STATUS: uint<8> = 4;

    let RECEIVE_PACKET: uint<3> = 0;
    let VALIDATE_PACKET: uint<3> = 1;
    let COPY_PAYLOAD: uint<3> = 2;
    let SEND_ACK: uint<3> = 3;
    let DISPATCH_PACKET: uint<3> = 4;

    // Receive the complete packet before validation can affect memory.
    decl state, count, crc, timeout, copy_index, reply_index, ack_crc, arm, loaded, saved_status;
    let receiving = state == RECEIVE_PACKET;
    let expected_magic: uint<8> = match count {
        0 => 0x4d,
        1 => 0x53,
        2 => 0x44,
        _ => 0x31
    };
    reg(clk) count: uint<10> reset(rst: 0) = {
        if !receiving || timeout == 1_000_000 {
            0
        } else if rx_valid {
            if count < 4 && rx_byte != expected_magic {
                if rx_byte == 0x4d {
                    1
                } else {
                    0
                }
            } else if count == 531 {
                0
            } else {
                count +. 1
            }
        } else {
            count
        }
    };
    reg(clk) timeout: uint<20> reset(rst: 0) = if !receiving || count == 0 || rx_valid || timeout == 1_000_000 {
        0
    } else {
        timeout +. 1
    };
    reg(clk) crc: uint<32> reset(rst: 0xffffffff) = {
        if receiving && rx_valid && (count == 0 || (count < 4 && rx_byte != expected_magic && rx_byte == 0x4d)) {
            crc32_byte(0xffffffff, rx_byte)
        } else if receiving && rx_valid && count < 528 {
            crc32_byte(crc, rx_byte)
        } else {
            crc
        }
    };
    reg(clk) expected_crc: uint<32> reset(rst: 0) = if receiving && rx_valid && count >= 528 {
        (expected_crc >> 8) | (zext(rx_byte) << 24)
    } else {
        expected_crc
    };
    reg(clk) header: uint<96> reset(rst: 0) = if receiving && rx_valid && count >= 4 && count < 16 {
        (header >> 8) | (zext(rx_byte) << 88)
    } else {
        header
    };
    let opcode: uint<8> = trunc(header);
    let sector: uint<32> = trunc(header >> 32);
    let sequence: uint<32> = trunc(header >> 64);
    let header_ok = (header & 0xffffff00) == 0;
    let packet_memory: Memory<uint<8>, 512> = inst clocked_memory(
        clk,
        [(receiving && rx_valid && count >= 16 && count < 528, trunc::<uint<10>, uint<9>>(count -. 16), rx_byte)],
    );
    let packet_byte = inst read_memory(packet_memory, copy_index);
    let complete = receiving && rx_valid && count == 531 && timeout != 1_000_000;
    let crc_ok = expected_crc == (crc ^ 0xffffffff);
    let all_loaded = loaded == 0xffffffffffffffffffffffffffffffff;
    let status: uint<8> = if !crc_ok {
        1
    } else if !header_ok || opcode < WRITE_SECTOR || opcode > READ_STATUS || sector >= 128 {
        2
    } else if opcode == WRITE_SECTOR && arm {
        3
    } else if opcode == ARM_CARD && !all_loaded {
        4
    } else {
        0
    };
    reg(clk) loaded: uint<128> reset(rst: 0) = {
        if state == DISPATCH_PACKET && saved_status == 0 && opcode == DISARM_CARD {
            0
        } else if state == COPY_PAYLOAD && load_ready && copy_index == 511 {
            loaded | (zext::<1, 128>(1) << zext::<32, 128>(sector))
        } else {
            loaded
        }
    };
    reg(clk) arm reset(rst: false) = if state == DISPATCH_PACKET && saved_status == 0 {
        if opcode == ARM_CARD {
            true
        } else if opcode == DISARM_CARD {
            false
        } else {
            arm
        }
    } else {
        arm
    };
    reg(clk) saved_status: uint<8> reset(rst: 0) = if state == VALIDATE_PACKET {
        status
    } else {
        saved_status
    };
    // Validation and dispatch are distinct cycles; retain both stages.
    reg(clk) state: uint<3> reset(rst: RECEIVE_PACKET) = {
        if complete {
            VALIDATE_PACKET
        } else if state == VALIDATE_PACKET {
            DISPATCH_PACKET
        } else if state == DISPATCH_PACKET {
            if saved_status == 0 && opcode == WRITE_SECTOR {
                COPY_PAYLOAD
            } else {
                SEND_ACK
            }
        } else if state == COPY_PAYLOAD && load_ready && copy_index == 511 {
            SEND_ACK
        } else if state == SEND_ACK && tx_ready && reply_index == 15 {
            RECEIVE_PACKET
        } else {
            state
        }
    };
    reg(clk) copy_index: uint<9> reset(rst: 0) = if state != COPY_PAYLOAD {
        0
    } else if load_ready {
        copy_index +. 1
    } else {
        copy_index
    };
    reg(clk) reply_index: uint<4> reset(rst: 0) = if state != SEND_ACK {
        0
    } else if tx_ready {
        reply_index +. 1
    } else {
        reply_index
    };
    reg(clk) snapshot: uint<32> reset(rst: 0) = if state == VALIDATE_PACKET {
        status_word
    } else {
        snapshot
    };
    let reply_sequence = if opcode == READ_STATUS && saved_status == 0 {
        snapshot
    } else {
        sequence
    };
    // Serialize the captured result and its acknowledgement CRC.
    let reply: uint<96> = 0x3141534d | (zext(opcode) << 32) | (zext(saved_status) << 40) | (zext(reply_sequence) << 64);
    let out_byte: uint<8> = if reply_index < 12 {
        trunc(reply >> (zext::<4, 96>(reply_index) << 3))
    } else {
        trunc((ack_crc ^ 0xffffffff) >> (zext::<4, 32>(reply_index -. 12) << 3))
    };
    reg(clk) ack_crc: uint<32> reset(rst: 0xffffffff) = if state != SEND_ACK {
        0xffffffff
    } else if tx_ready && reply_index < 12 {
        crc32_byte(ack_crc, out_byte)
    } else {
        ack_crc
    };
    set tx_valid = &(state == SEND_ACK);
    set tx_byte = &out_byte;
    set load_valid = &(state == COPY_PAYLOAD);
    set load_address = &((sector << 9) | zext(copy_index));
    set load_byte = &packet_byte;
    set armed = &arm;
    set status_selector = &trunc(sector);
}
