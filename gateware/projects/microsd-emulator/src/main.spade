pub mod cdc;
pub mod clock_meter;
pub mod bist;
pub mod loader;
pub mod storage;
pub mod write_rx;
pub mod write_response;
pub mod write_transaction;
use shared_components::sd::{crc7_bit, crc16_bit, response48};

// Protocol status bits are combinational; the caller owns response capture.
fn card_status_word(
    card_state: uint<4>,
    committing: bool,
    write_active: bool,
    reading: bool,
    write_crc_error: bool,
) -> uint<32> {
    let SENDING_DATA: uint<4> = 5;
    let RECEIVING_DATA: uint<4> = 6;
    let PROGRAMMING: uint<4> = 7;
    let current_state = if committing {
        PROGRAMMING
    } else if write_active {
        RECEIVING_DATA
    } else if reading {
        SENDING_DATA
    } else {
        card_state
    };
    (zext(current_state) << 9)
        | (if write_active { 0 } else { 0x100 })
        | (if write_crc_error { 1 << 23 } else { 0 })
}

// Select a four-bit transfer or DAT0 bit without changing serializer state.
fn read_data_nibble(data_byte: uint<8>, bit_index: uint<12>, wide: bool) -> uint<4> {
    if wide {
        if bit_index.to_bits()[2] {
            trunc(data_byte)
        } else {
            trunc(data_byte >> 4)
        }
    } else {
        if data_byte.to_bits()[7 -. trunc::<uint<12>, uint<3>>(bit_index)] {
            15
        } else {
            14
        }
    }
}

// Slow mode advances serialization on synchronized SD falling-edge events.
// Fast mode advances preparation on synchronized SD rising-edge events,
// then launches prepared values from falling-edge fabric registers.
// fast_mode is fixed by the hardware wrapper.
//
// Backend owns a stable 512-byte sector until release/cancel; byte_index
// looks up that buffer asynchronously. No stalls during sector serialization.
#[no_mangle(all)]
pub entity sd_frontend(

    // Clock and card control
    clk: clock,
    rst: bool,
    armed: bool,

    // SD pins
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,

    // Read-buffer exchange
    request_valid: inv &bool,
    request_lba: inv &uint<32>,
    generation: inv &uint<32>,
    sector_ready: bool,
    sector_generation: uint<32>,
    sector_byte: uint<8>,
    byte_index: inv &uint<9>,
    sector_release: inv &bool,

    // Mode and write-side inputs
    fast_mode: bool,
    h700_mode: bool,
    h700_falling_phase: bool,
    h700_early_command: bool,
    sd_csd: uint<128>,
    mmc_only: bool,
    writable: bool,
    dat_in: uint<4>,

    // DDR write command
    write_cmd_valid: inv &bool,
    write_cmd_ready: bool,
    write_cmd_address: inv &uint<24>,

    // DDR write data
    write_data_valid: inv &bool,
    write_data_ready: bool,
    write_data: inv &uint<128>,
    write_mask: inv &uint<16>,
    write_busy: inv &bool,

    // Passive command-observation taps for external diagnostics.
    trace_clock_tick: inv &bool,
    trace_frame: inv &bool,
    trace_valid: inv &bool,
    trace_command: inv &uint<6>,
    trace_argument: inv &uint<32>,
    trace_response: inv &bool,
    trace_response_complete: inv &bool,
    trace_response_payload: inv &uint<32>,
    trace_data_release: inv &bool,
    trace_protocol_status: inv &uint<32>,
    trace_pin_response: inv &uint<32>,
    trace_pin_response_mismatch: inv &uint<32>,
    trace_pin_data: inv &uint<32>,
    trace_pin_data_mismatch: inv &uint<32>,
) {
    let CMD_GO_IDLE: uint<6> = 0;
    let CMD_SEND_OP_COND: uint<6> = 1;
    let CMD_ALL_SEND_CID: uint<6> = 2;
    let CMD_SEND_RCA: uint<6> = 3;
    let ACMD_SET_BUS_WIDTH: uint<6> = 6;
    let CMD_SELECT_CARD: uint<6> = 7;
    let CMD_SEND_IF_COND: uint<6> = 8;
    let CMD_SEND_CSD: uint<6> = 9;
    let CMD_STOP_TRANSMISSION: uint<6> = 12;
    let CMD_SEND_STATUS: uint<6> = 13;
    let CMD_READ_SINGLE: uint<6> = 17;
    let CMD_READ_MULTIPLE: uint<6> = 18;
    let CMD_SET_BLOCK_COUNT: uint<6> = 23;
    let CMD_WRITE_SINGLE: uint<6> = 24;
    let CMD_WRITE_MULTIPLE: uint<6> = 25;
    let ACMD_SEND_OP_COND: uint<6> = 41;
    let ACMD_SEND_SCR: uint<6> = 51;
    let CMD_APP: uint<6> = 55;

    let WRITE_IDLE: uint<2> = 0;
    let WRITE_SINGLE: uint<2> = 1;
    let WRITE_MULTIPLE: uint<2> = 2;

    let READ_IDLE: uint<3> = 0;
    let READ_PAYLOAD: uint<3> = 1;
    let READ_CRC: uint<3> = 2;
    let READ_END_BIT: uint<3> = 3;
    let READ_RELEASE: uint<3> = 4;

    let CARD_IDLE: uint<4> = 0;
    let CARD_READY: uint<4> = 1;
    let CARD_IDENTIFICATION: uint<4> = 2;
    let CARD_STANDBY: uint<4> = 3;
    let CARD_TRANSFER: uint<4> = 4;

    let STATUS_SWITCH_ERROR: uint<32> = 1 << 7;

    // Input synchronization and SD sampling/output-advance events.
    reg(clk) clk_meta reset(rst: false) = sd_clk;
    reg(clk) clk_sync reset(rst: false) = clk_meta;
    reg(clk) clk_prev reset(rst: false) = clk_sync;
    reg(clk) cmd_meta reset(rst: true) = cmd_in;
    reg(clk) cmd_sync reset(rst: true) = cmd_meta;
    reg(clk) dat_meta: uint<4> reset(rst: 15) = dat_in;
    reg(clk) dat_sync: uint<4> reset(rst: 15) = dat_meta;
    let (write_transaction_active, write_transaction_active_w): (&bool, inv &bool) = port;
    let (committing, committing_w): (&bool, inv &bool) = port;
    let (write_done, write_done_w): (&bool, inv &bool) = port;
    let (write_good, write_good_w): (&bool, inv &bool) = port;
    let (write_response_data, write_response_data_w): (&uint<4>, inv &uint<4>) = port;
    let (write_response_enable, write_response_enable_w): (&uint<4>, inv &uint<4>) = port;
    let (commit_done, commit_done_w): (&bool, inv &bool) = port;
    decl write_mode, write_lba;
    let prepared_data_mode = fast_mode || h700_mode || mmc_only;
    // A packet spans hundreds of SD edges. Register its aggregate activity
    // in prepared-data modes to keep reset/CRC-response decode out of read arbitration.
    reg(clk) delayed_write_transaction_active reset(rst || !armed: false) = *write_transaction_active;
    let write_active = write_mode != WRITE_IDLE || (if prepared_data_mode { delayed_write_transaction_active } else { *write_transaction_active });
    let sd_sample_tick = clk_sync && !clk_prev;
    // A live host clocks SD_CLK continuously; an unpowered one leaves the line
    // floating, where measured noise still produces a few hundred transitions
    // per second. Any compatibility drive is therefore gated on an edge *rate*
    // rather than on a single recent edge: at least four transitions inside a
    // 4096-cycle window, about 64 us. The slowest host clock observed on the
    // RG35XX puts roughly thirty transitions in that window while the measured
    // floating-input noise puts a thousandth of one. The decision is
    // registered, so an armed FPGA stops driving an unpowered target within
    // two windows, about 128 us.
    reg(clk) host_clock_window: uint<12> reset(rst || !armed: 0) =
        host_clock_window +. 1;
    let host_clock_window_end = host_clock_window == 0;
    reg(clk) host_clock_edges: uint<3> reset(rst || !armed: 0) =
        if host_clock_window_end {
            0
        } else if clk_sync != clk_prev && host_clock_edges != 7 {
            host_clock_edges +. 1
        } else {
            host_clock_edges
        };
    reg(clk) host_clock_active reset(rst || !armed: false) =
        if host_clock_window_end {
            host_clock_edges >= 4
        } else {
            host_clock_active
        };
    // Prepared outputs launch after the synchronized rising edge. Their
    // opposite-edge pad registers provide setup time before the next host
    // rising edge; command responses can retain the proven slow path.
    let command_output_advance = if fast_mode || (h700_mode && h700_early_command) {
        sd_sample_tick
    } else {
        !clk_sync && clk_prev
    };
    // Prepared profiles advance immediately after the synchronized host
    // sample. The opposite-edge pad register then holds the next value for a
    // full external clock cycle before the host's following rising edge.
    let data_output_advance = if h700_mode && h700_falling_phase {
        !clk_sync && clk_prev
    } else if prepared_data_mode {
        sd_sample_tick
    } else {
        !clk_sync && clk_prev
    };
    // Prepared output registers use the opposite fabric edge. The mode is
    // static in hardware wrappers and is checked in the routed netlist.
    let command_output_clk = unsafe {
        let level = inst std::conv::clock_to_bool(clk);
        inst std::conv::bool_to_clock(if fast_mode { !level } else { level })
    };
    let data_output_clk = unsafe {
        let level = inst std::conv::clock_to_bool(clk);
        inst std::conv::bool_to_clock(if prepared_data_mode { !level } else { level })
    };
    let local_rst = rst || !armed;
    reg(clk) registered_output_reset reset(rst: true) = !armed;
    let command_output_reset = if fast_mode {
        registered_output_reset
    } else {
        local_rst
    };
    let data_output_reset = if prepared_data_mode {
        registered_output_reset
    } else {
        local_rst
    };
    decl response_left, response_delay, data_state, lba, epoch, pending, multi, sending_scr, sending_sd_status, app, bit_index, crc_index;

    // Command reception and registered decode.
    reg(clk) remaining: uint<6> reset(local_rst: 0) = {
        if sd_sample_tick && response_left == 0 {
            if remaining == 0 {
                if cmd_sync {
                    0
                } else {
                    47
                }
            } else {
                remaining -. 1
            }
        } else {
            remaining
        }
    };
    reg(clk) command: uint<48> reset(local_rst: 0) = if sd_sample_tick && response_left == 0 {
        (command << 1) | (if cmd_sync { 1 } else { 0 })
    } else {
        command
    };
    reg(clk) command_crc: uint<7> reset(local_rst: 0) = {
        if sd_sample_tick && remaining == 0 {
            0
        } else if sd_sample_tick && remaining >= 9 {
            crc7_bit(command_crc, cmd_sync)
        } else {
            command_crc
        }
    };
    let frame_complete = armed && sd_sample_tick && response_left == 0 && remaining == 1;
    let raw_valid = frame_complete && cmd_sync &&
    trunc::<uint<48>, uint<7>>(command) == command_crc && command.to_bits()[45] && !command.to_bits()[46];
    // Complete CRC/framing validation before executing a command. SD edges
    // are about 40 ns apart at the fast target; validation adds one fabric cycle.
    reg(clk) valid reset(local_rst: false) = raw_valid;
    reg(clk) observed_frame reset(local_rst: false) = frame_complete;
    reg(clk) command_index: uint<6> reset(local_rst: 0) = if raw_valid {
        trunc(command >> 39)
    } else {
        command_index
    };
    reg(clk) command_argument: uint<32> reset(local_rst: 0) = if raw_valid {
        trunc(command >> 7)
    } else {
        command_argument
    };
    // Reduce the full argument before it fans out into stop/reset decoding.
    reg(clk) command_argument_zero reset(local_rst: true) = if raw_valid {
        trunc::<uint<48>, uint<32>>(command >> 7) == 0
    } else {
        command_argument_zero
    };

    // Card state and address/command legality retain their protocol encodings.
    decl state;
    reg(clk) mmc_mode reset(local_rst: false) = if valid {
        if command_index == CMD_GO_IDLE {
            false
        } else if command_index == CMD_SEND_OP_COND &&
            (state == CARD_IDLE || state == CARD_READY) {
            true
        } else {
            mmc_mode
        }
    } else {
        mmc_mode
    };
    reg(clk) mmc_sector_mode reset(local_rst: false) = if valid {
        if command_index == CMD_GO_IDLE {
            false
        } else if command_index == CMD_SEND_OP_COND {
            // The H700 BootROM performs a single zero-argument probe. Report
            // the DDR-backed card's fixed sector-addressed mode immediately.
            true
        } else {
            mmc_sector_mode
        }
    } else {
        mmc_sector_mode
    };
    reg(clk) rca: uint<16> reset(local_rst: 1) = if valid &&
        command_index == CMD_SEND_RCA && state == CARD_IDENTIFICATION {
        if mmc_mode { trunc(command_argument >> 16) } else { 1 }
    } else {
        rca
    };
    reg(clk) state: uint<4> reset(local_rst: CARD_IDLE) = {
        if valid {
            if command_index == CMD_GO_IDLE {
                CARD_IDLE
            } else if command_index == CMD_SEND_OP_COND &&
                (state == CARD_IDLE || state == CARD_READY) {
                CARD_READY
            } else if command_index == ACMD_SEND_OP_COND && app && state == CARD_IDLE && (command_argument & 0x00ff8000) != 0 {
                CARD_READY
            } else if command_index == CMD_ALL_SEND_CID && state == CARD_READY {
                CARD_IDENTIFICATION
            } else if command_index == CMD_SEND_RCA && state == CARD_IDENTIFICATION {
                CARD_STANDBY
            } else if command_index == CMD_SELECT_CARD && state == CARD_STANDBY &&
                trunc::<uint<32>, uint<16>>(command_argument >> 16) == rca {
                CARD_TRANSFER
            } else if command_index == CMD_SELECT_CARD && state == CARD_TRANSFER && command_argument_zero {
                CARD_STANDBY
            } else {
                state
            }
        } else {
            state
        }
    };
    reg(clk) app reset(local_rst: false) = if valid {
        command_index == CMD_APP
    } else {
        app
    };
    let transfer_idle = state == CARD_TRANSFER && !pending && data_state == READ_IDLE && !write_active;
    let read_command = command_index == CMD_READ_SINGLE || command_index == CMD_READ_MULTIPLE;
    let write_command = command_index == CMD_WRITE_SINGLE || command_index == CMD_WRITE_MULTIPLE;
    let deselect = command_index == CMD_SELECT_CARD && command_argument_zero;
    let reset_command = command_index == CMD_GO_IDLE || deselect;
    reg(clk) wide reset(local_rst: false) = {
        if valid && command_index == CMD_GO_IDLE {
            false
        } else if valid && app && command_index == ACMD_SET_BUS_WIDTH && transfer_idle && (command_argument_zero || command_argument == 2) {
            command_argument == 2
        } else if valid && mmc_mode && command_index == ACMD_SET_BUS_WIDTH && transfer_idle &&
            trunc::<uint<32>, uint<8>>(command_argument >> 16) == 183 &&
            (trunc::<uint<32>, uint<8>>(command_argument >> 8) == 0 ||
                trunc::<uint<32>, uint<8>>(command_argument >> 8) == 1) &&
            (!h700_mode || trunc::<uint<32>, uint<8>>(command_argument >> 8) == 0) {
            trunc::<uint<32>, uint<8>>(command_argument >> 8) == 1
        } else {
            wide
        }
    };
    let command_stop = valid && command_index == CMD_STOP_TRANSMISSION;
    let reset_stop = valid && reset_command;
    let stop = reset_stop || command_stop;
    let last_lba: uint<32> = if writable {
        524287
    } else {
        16383
    };
    // Some H700 firmware selects the legacy MMC 256-byte block length even
    // after requesting sector addressing. Keep DDR physically organized as
    // 512-byte sectors and expose either half for reads. Writes remain 512
    // bytes so the existing atomic write/commit contract does not change.
    reg(clk) block_length_256 reset(local_rst: false) = if valid {
        if command_index == CMD_GO_IDLE {
            false
        } else if command_index == 16 && state == CARD_TRANSFER &&
            !write_active && (command_argument == 256 || command_argument == 512) {
            command_argument == 256
        } else {
            block_length_256
        }
    } else {
        block_length_256
    };
    let sector_addressing = mmc_mode && mmc_sector_mode;
    let command_lba = if sector_addressing {
        if block_length_256 { command_argument >> 1 } else { command_argument }
    } else {
        command_argument >> 9
    };
    let command_half = if sector_addressing {
        block_length_256 && (command_argument & 1) != 0
    } else {
        block_length_256 && (command_argument & 256) != 0
    };
    let address_misaligned = !sector_addressing && if block_length_256 {
        (command_argument & 255) != 0
    } else {
        (command_argument & 511) != 0
    };
    // Both supported capacities are powers of two. Test their unused upper
    // address bits directly instead of putting two 32-bit comparators on the
    // command-validation path.
    let address_out_of_range = if writable {
        (command_lba & 0xfff80000) != 0
    } else {
        (command_lba & 0xffffc000) != 0
    };
    let read = valid && transfer_idle && read_command && !address_misaligned && !address_out_of_range;
    // Keep this observation for diagnostics, but do not use it to alter the
    // protocol. Hardware trials showed that the H700 payload chooses its MMC
    // fallback even when the card continues to answer ordinary SD probes.
    reg(clk) boot_read_seen reset(local_rst: false) = if read {
        true
    } else {
        boot_read_seen
    };
    let initial_sd_command = command_index == CMD_SEND_IF_COND ||
        command_index == CMD_APP || command_index == ACMD_SEND_OP_COND;
    let suppress_sd_probe = !mmc_mode && state == CARD_IDLE &&
        mmc_only && initial_sd_command;
    let scr = valid && transfer_idle && app && command_index == ACMD_SEND_SCR;
    let ssr = valid && transfer_idle && app && command_index == CMD_SEND_STATUS && command_argument_zero;
    let range_error = address_misaligned || address_out_of_range;

    // Write-transaction controls: accepted commits outlive protocol cancellation.
    let raw_write_request = valid && transfer_idle && writable && write_command &&
        !block_length_256 && !range_error;
    let raw_write_next = *write_done && *write_good && write_mode == WRITE_MULTIPLE && write_lba < last_lba && !stop;
    // Register fast command-to-receiver controls rather than letting
    // command decoding and response-active logic feed a receiver-wide reset.
    reg(clk) queued_write_request reset(local_rst: false) = raw_write_request;
    reg(clk) queued_write_next reset(local_rst: false) = raw_write_next;
    reg(clk) queued_write_cancel reset(local_rst: true) = local_rst || (valid && reset_command);
    reg(clk) queued_write_stop reset(local_rst: false) = valid && command_index == CMD_STOP_TRANSMISSION;
    let write_request = if prepared_data_mode {
        queued_write_request
    } else {
        raw_write_request
    };
    let write_next = if prepared_data_mode {
        queued_write_next
    } else {
        raw_write_next
    };
    let write_cancel = if prepared_data_mode {
        queued_write_cancel || local_rst
    } else {
        local_rst || (valid && reset_command)
    };
    let write_stop = if prepared_data_mode {
        queued_write_stop
    } else {
        valid && command_index == CMD_STOP_TRANSMISSION
    };
    reg(clk) write_mode: uint<2> reset(local_rst: WRITE_IDLE) = if stop {
        WRITE_IDLE
    } else if write_request {
        if command_index == CMD_WRITE_MULTIPLE {
            WRITE_MULTIPLE
        } else {
            WRITE_SINGLE
        }
    } else if *write_done && !raw_write_next {
        WRITE_IDLE
    } else {
        write_mode
    };
    reg(clk) write_lba: uint<32> reset(local_rst: 0) = if write_request {
        command_lba
    } else if write_next {
        write_lba +. 1
    } else {
        write_lba
    };
    let _ = inst write_transaction::sd_write_transaction$(
        clk,
        rst,
        prepared_mode: prepared_data_mode,
        start: write_request || write_next,
        cancel: write_cancel,
        stop: write_stop,
        wide,
        lba: if write_request {
            command_lba
        } else {
            write_lba +. 1
        },
        sample: sd_sample_tick,
        fall: data_output_advance,
        dat: dat_sync,
        dat_out: write_response_data_w,
        dat_oe: write_response_enable_w,
        active: write_transaction_active_w,
        complete: write_done_w,
        good: write_good_w,
        commit_busy: committing_w,
        commit_complete: commit_done_w,
        cmd_valid: write_cmd_valid,
        cmd_ready: write_cmd_ready,
        cmd_address: write_cmd_address,
        wdata_valid: write_data_valid,
        wdata_ready: write_data_ready,
        wdata: write_data,
        wdata_mask: write_mask,
    );
    set write_busy = committing;
    set trace_clock_tick = &sd_sample_tick;
    set trace_frame = &observed_frame;
    set trace_valid = &valid;
    set trace_command = &command_index;
    set trace_argument = &command_argument;
    reg(clk) write_crc_error reset(local_rst: false) = if valid && (command_index == CMD_GO_IDLE || (command_index == CMD_SEND_STATUS && !app)) {
        false
    } else if *write_done && !*write_good {
        true
    } else {
        write_crc_error
    };

    // U-Boot decides whether an MMC CMD6 switch succeeded from SWITCH_ERROR
    // in its following CMD13 poll. ILLEGAL_COMMAND in the CMD6 response alone
    // does not stop the host from changing its controller to the requested
    // width. Retain this error through that status response, then clear it.
    let mmc_width_switch = valid && mmc_mode && !app &&
        command_index == ACMD_SET_BUS_WIDTH && transfer_idle &&
        trunc::<uint<32>, uint<8>>(command_argument >> 24) == 3 &&
        trunc::<uint<32>, uint<8>>(command_argument >> 16) == 183;
    let requested_mmc_width = trunc::<uint<32>, uint<8>>(command_argument >> 8);
    let unsupported_mmc_width = mmc_width_switch &&
        (requested_mmc_width > 1 || (h700_mode && requested_mmc_width != 0));
    reg(clk) switch_error reset(local_rst: false) = {
        if valid && command_index == CMD_GO_IDLE {
            false
        } else if unsupported_mmc_width {
            true
        } else if valid && !app && command_index == CMD_SEND_STATUS {
            false
        } else {
            switch_error
        }
    };

    // Command legality, status, and response payload selection.
    let base_status: uint<32> = card_status_word$(
        card_state: state,
        committing: *committing,
        write_active,
        reading: data_state != READ_IDLE || pending,
        write_crc_error,
    );
    let status = base_status | (if switch_error { STATUS_SWITCH_ERROR } else { 0 });
    let addressed = trunc::<uint<32>, uint<16>>(command_argument >> 16) == rca;
    let legal = match command_index {
        // CMD0: GO_IDLE_STATE
        0 => true,
        // MMC CMD1: SEND_OP_COND. Accept READY so an SD probe can fall back
        // without requiring another CMD0.
        1 => state == CARD_IDLE || state == CARD_READY,
        // SD CMD8: SEND_IF_COND; MMC CMD8: SEND_EXT_CSD.
        8 => state == CARD_IDLE || (mmc_mode && transfer_idle),
        // ACMD41: SD_SEND_OP_COND
        41 => app && state == CARD_IDLE,
        // CMD2: ALL_SEND_CID
        2 => state == CARD_READY,
        // SD CMD3 returns an RCA; MMC CMD3 assigns a nonzero host RCA.
        3 => state == CARD_IDENTIFICATION && (!mmc_mode || command_argument >> 16 != 0),
        // CMD9: SEND_CSD
        9 => state == CARD_STANDBY && addressed,
        // CMD7: SELECT/DESELECT_CARD
        7 => (state == CARD_STANDBY && addressed) || (state == CARD_TRANSFER && command_argument_zero),
        // CMD13: SEND_STATUS, or ACMD13: SD_STATUS (ssr)
        13 => (addressed && (state == CARD_STANDBY || state == CARD_TRANSFER)) || ssr,
        // CMD55: APP_CMD
        55 => state == CARD_IDLE || addressed,
        // CMD16: SET_BLOCKLEN
        16 => state == CARD_TRANSFER && !write_active &&
            (command_argument == 256 || command_argument == 512),
        // CMD24: WRITE_BLOCK
        24 => writable && transfer_idle && !block_length_256,
        // CMD25: WRITE_MULTIPLE_BLOCK
        25 => writable && transfer_idle && !block_length_256,
        // CMD17: READ_SINGLE_BLOCK
