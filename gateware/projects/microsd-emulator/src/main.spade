pub mod cdc;
pub mod clock_meter;
pub mod bist;
pub mod loader;
pub mod storage;
pub mod write_rx;
pub mod write_response;
pub mod write_transaction;
use shared_components::sd::{crc7_bit, crc16_bit, response48};

// Protocol status bits are combinational; the caller owns response capture.
fn card_status_word(
    card_state: uint<4>,
    committing: bool,
    write_active: bool,
    reading: bool,
    write_crc_error: bool,
) -> uint<32> {
    let SENDING_DATA: uint<4> = 5;
    let RECEIVING_DATA: uint<4> = 6;
    let PROGRAMMING: uint<4> = 7;
    let current_state = if committing {
        PROGRAMMING
    } else if write_active {
        RECEIVING_DATA
    } else if reading {
        SENDING_DATA
    } else {
        card_state
    };
    (zext(current_state) << 9)
        | (if write_active { 0 } else { 0x100 })
        | (if write_crc_error { 1 << 23 } else { 0 })
}

// Select a four-bit transfer or DAT0 bit without changing serializer state.
fn read_data_nibble(data_byte: uint<8>, bit_index: uint<12>, wide: bool) -> uint<4> {
    if wide {
        if bit_index.to_bits()[2] {
            trunc(data_byte)
        } else {
            trunc(data_byte >> 4)
        }
    } else {
        if data_byte.to_bits()[7 -. trunc::<uint<12>, uint<3>>(bit_index)] {
            15
        } else {
            14
        }
    }
}

// Management clock 80 MHz or faster; the 12 MHz candidate requires SD high/low
// pulses >= 41 ns. Hardware qualification is recorded separately. Outputs
// change after synchronized falling edges.
// Backend owns a complete 512-byte sector until release/cancel. byte_index is
// asynchronous lookup into that stable buffer. No mid-sector backend stalls.
#[no_mangle(all)]
pub entity sd_frontend(
    clk: clock,
    rst: bool,
    armed: bool,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    request_valid: inv &bool,
    request_lba: inv &uint<32>,
    generation: inv &uint<32>,
    sector_ready: bool,
    sector_generation: uint<32>,
    sector_byte: uint<8>,
    byte_index: inv &uint<9>,
    sector_release: inv &bool,
    fast_mode: bool,
    writable: bool,
    dat_in: uint<4>,
    write_cmd_valid: inv &bool,
    write_cmd_ready: bool,
    write_cmd_address: inv &uint<24>,
    write_data_valid: inv &bool,
    write_data_ready: bool,
    write_data: inv &uint<128>,
    write_mask: inv &uint<16>,
    write_busy: inv &bool,
) {
    let CMD_GO_IDLE: uint<6> = 0;
    let CMD_ALL_SEND_CID: uint<6> = 2;
    let CMD_SEND_RCA: uint<6> = 3;
    let ACMD_SET_BUS_WIDTH: uint<6> = 6;
    let CMD_SELECT_CARD: uint<6> = 7;
    let CMD_SEND_IF_COND: uint<6> = 8;
    let CMD_SEND_CSD: uint<6> = 9;
    let CMD_STOP_TRANSMISSION: uint<6> = 12;
    let CMD_SEND_STATUS: uint<6> = 13;
    let CMD_READ_SINGLE: uint<6> = 17;
    let CMD_READ_MULTIPLE: uint<6> = 18;
    let CMD_WRITE_SINGLE: uint<6> = 24;
    let CMD_WRITE_MULTIPLE: uint<6> = 25;
    let ACMD_SEND_OP_COND: uint<6> = 41;
    let ACMD_SEND_SCR: uint<6> = 51;
    let CMD_APP: uint<6> = 55;

    let WRITE_IDLE: uint<2> = 0;
    let WRITE_SINGLE: uint<2> = 1;
    let WRITE_MULTIPLE: uint<2> = 2;

    let READ_IDLE: uint<3> = 0;
    let READ_PAYLOAD: uint<3> = 1;
    let READ_CRC: uint<3> = 2;
    let READ_END_BIT: uint<3> = 3;
    let READ_RELEASE: uint<3> = 4;

    let CARD_IDLE: uint<4> = 0;
    let CARD_READY: uint<4> = 1;
    let CARD_IDENTIFICATION: uint<4> = 2;
    let CARD_STANDBY: uint<4> = 3;
    let CARD_TRANSFER: uint<4> = 4;


    // Input synchronization and SD sampling/output-advance events.
    reg(clk) clk_meta reset(rst: false) = sd_clk;
    reg(clk) clk_sync reset(rst: false) = clk_meta;
    reg(clk) clk_prev reset(rst: false) = clk_sync;
    reg(clk) cmd_meta reset(rst: true) = cmd_in;
    reg(clk) cmd_sync reset(rst: true) = cmd_meta;
    reg(clk) dat_meta: uint<4> reset(rst: 15) = dat_in;
    reg(clk) dat_sync: uint<4> reset(rst: 15) = dat_meta;
    let (writing, writing_w): (&bool, inv &bool) = port;
    let (committing, committing_w): (&bool, inv &bool) = port;
    let (write_done, write_done_w): (&bool, inv &bool) = port;
    let (write_good, write_good_w): (&bool, inv &bool) = port;
    let (write_dat, write_dat_w): (&uint<4>, inv &uint<4>) = port;
    let (write_oe, write_oe_w): (&uint<4>, inv &uint<4>) = port;
    let (commit_done, commit_done_w): (&bool, inv &bool) = port;
    decl write_mode, write_lba;
    // A packet spans hundreds of SD edges. Register its aggregate activity
    // in fast mode to keep reset/CRC-response decode out of read arbitration.
    reg(clk) delayed_writing reset(rst || !armed: false) = *writing;
    let write_active = write_mode != WRITE_IDLE || (if fast_mode { delayed_writing } else { *writing });
    let sd_sample_tick = clk_sync && !clk_prev;
    // Fast mode launches the next output bit after the synchronized rising
    // edge. With falling-edge pad registers at 100 MHz, the 15..25 ns
    // input-to-output pipeline targets the falling edge of a 25 MHz SD clock.
    let sd_output_advance = if fast_mode {
        sd_sample_tick
    } else {
        !clk_sync && clk_prev
    };
    // In fast mode the output registers use the opposite fabric edge. The
    // synchronized edge pulse is already stable, giving the pads another 5 ns
    // before the host's next sample. The mode is static in hardware wrappers.
    let output_clk = unsafe {
        let level = inst std::conv::clock_to_bool(clk);
        inst std::conv::bool_to_clock(if fast_mode { !level } else { level })
    };
    let local_rst = rst || !armed;
    reg(clk) registered_output_reset reset(rst: true) = !armed;
    let output_reset = if fast_mode {
        registered_output_reset
    } else {
        local_rst
    };
    decl response_left, response_delay, data_state, lba, epoch, pending, multi, short_data, status_data, app, bit_index, crc_index;

    // Command reception and registered decode.
    reg(clk) remaining: uint<6> reset(local_rst: 0) = {
        if sd_sample_tick && response_left == 0 {
            if remaining == 0 {
                if cmd_sync {
                    0
                } else {
                    47
                }
            } else {
                remaining -. 1
            }
        } else {
            remaining
        }
    };
    reg(clk) command: uint<48> reset(local_rst: 0) = if sd_sample_tick && response_left == 0 {
        (command << 1) | (if cmd_sync { 1 } else { 0 })
    } else {
        command
    };
    reg(clk) command_crc: uint<7> reset(local_rst: 0) = {
        if sd_sample_tick && remaining == 0 {
            0
        } else if sd_sample_tick && remaining >= 9 {
            crc7_bit(command_crc, cmd_sync)
        } else {
            command_crc
        }
    };
    let raw_valid = armed && sd_sample_tick && response_left == 0 && remaining == 1 && cmd_sync &&
    trunc::<uint<48>, uint<7>>(command) == command_crc && command.to_bits()[45] && !command.to_bits()[46];
    // Complete CRC/framing validation before executing a command. SD edges
    // are about 40 ns apart at the fast target; validation adds one fabric cycle.
    reg(clk) valid reset(local_rst: false) = raw_valid;
    reg(clk) command_index: uint<6> reset(local_rst: 0) = if raw_valid {
        trunc(command >> 39)
    } else {
        command_index
    };
    reg(clk) command_argument: uint<32> reset(local_rst: 0) = if raw_valid {
        trunc(command >> 7)
    } else {
        command_argument
    };
    // Reduce the full argument before it fans out into stop/reset decoding.
    reg(clk) command_argument_zero reset(local_rst: true) = if raw_valid {
        trunc::<uint<48>, uint<32>>(command >> 7) == 0
    } else {
        command_argument_zero
    };

    // Card state and address/command legality retain their protocol encodings.
    reg(clk) state: uint<4> reset(local_rst: CARD_IDLE) = {
        if valid {
            if command_index == CMD_GO_IDLE {
                CARD_IDLE
            } else if command_index == ACMD_SEND_OP_COND && app && state == CARD_IDLE && (command_argument & 0x00ff8000) != 0 {
                CARD_READY
            } else if command_index == CMD_ALL_SEND_CID && state == CARD_READY {
                CARD_IDENTIFICATION
            } else if command_index == CMD_SEND_RCA && state == CARD_IDENTIFICATION {
                CARD_STANDBY
            } else if command_index == CMD_SELECT_CARD && state == CARD_STANDBY && command_argument == 0x00010000 {
                CARD_TRANSFER
            } else if command_index == CMD_SELECT_CARD && state == CARD_TRANSFER && command_argument_zero {
                CARD_STANDBY
            } else {
                state
            }
        } else {
            state
        }
    };
    reg(clk) app reset(local_rst: false) = if valid {
        command_index == CMD_APP
    } else {
        app
    };
    let transfer_idle = state == CARD_TRANSFER && !pending && data_state == READ_IDLE && !write_active;
    let read_command = command_index == CMD_READ_SINGLE || command_index == CMD_READ_MULTIPLE;
    let write_command = command_index == CMD_WRITE_SINGLE || command_index == CMD_WRITE_MULTIPLE;
    let deselect = command_index == CMD_SELECT_CARD && command_argument_zero;
    let reset_command = command_index == CMD_GO_IDLE || deselect;
    reg(clk) wide reset(local_rst: false) = {
        if valid && command_index == CMD_GO_IDLE {
            false
        } else if valid && app && command_index == ACMD_SET_BUS_WIDTH && transfer_idle && (command_argument_zero || command_argument == 2) {
            command_argument == 2
        } else {
            wide
        }
    };
    let stop = valid && (reset_command || command_index == CMD_STOP_TRANSMISSION);
    let capacity_bytes: uint<32> = if writable {
        268_435_456
    } else {
        8_388_608
    };
    let last_lba: uint<32> = if writable {
        524287
    } else {
        16383
    };
    let read = valid && transfer_idle && read_command &&
    (command_argument & 511) == 0 && command_argument < capacity_bytes;
    let scr = valid && transfer_idle && app && command_index == ACMD_SEND_SCR;
    let ssr = valid && transfer_idle && app && command_index == CMD_SEND_STATUS && command_argument_zero;
    let range_error = (command_argument & 511) != 0 || command_argument >= capacity_bytes;

    // Write-transaction controls: accepted commits outlive protocol cancellation.
    let raw_write_request = valid && transfer_idle && writable && write_command && !range_error;
    let raw_write_next = *write_done && *write_good && write_mode == WRITE_MULTIPLE && write_lba < last_lba && !stop;
    // Register fast command-to-receiver controls rather than letting
    // command decoding and response-active logic feed a receiver-wide reset.
    reg(clk) queued_write_request reset(local_rst: false) = raw_write_request;
    reg(clk) queued_write_next reset(local_rst: false) = raw_write_next;
    reg(clk) queued_write_cancel reset(local_rst: true) = local_rst || (valid && reset_command);
    reg(clk) queued_write_stop reset(local_rst: false) = valid && command_index == CMD_STOP_TRANSMISSION;
    let write_request = if fast_mode {
        queued_write_request
    } else {
        raw_write_request
    };
    let write_next = if fast_mode {
        queued_write_next
    } else {
        raw_write_next
    };
    let write_cancel = if fast_mode {
        queued_write_cancel || local_rst
    } else {
        local_rst || (valid && reset_command)
    };
    let write_stop = if fast_mode {
        queued_write_stop
    } else {
        valid && command_index == CMD_STOP_TRANSMISSION
    };
    reg(clk) write_mode: uint<2> reset(local_rst: WRITE_IDLE) = if stop {
        WRITE_IDLE
    } else if write_request {
        if command_index == CMD_WRITE_MULTIPLE {
            WRITE_MULTIPLE
        } else {
            WRITE_SINGLE
        }
    } else if *write_done && !raw_write_next {
        WRITE_IDLE
    } else {
        write_mode
    };
    reg(clk) write_lba: uint<32> reset(local_rst: 0) = if write_request {
        command_argument >> 9
    } else if write_next {
        write_lba +. 1
    } else {
        write_lba
    };
    let _ = inst write_transaction::sd_write_transaction$(
        clk,
        rst,
        prepared_mode: fast_mode,
        start: write_request || write_next,
        cancel: write_cancel,
        stop: write_stop,
        wide,
        lba: if write_request {
            command_argument >> 9
        } else {
            write_lba +. 1
        },
        sample: sd_sample_tick,
        fall: sd_output_advance,
        dat: dat_sync,
        dat_out: write_dat_w,
        dat_oe: write_oe_w,
        active: writing_w,
        complete: write_done_w,
        good: write_good_w,
        commit_busy: committing_w,
        commit_complete: commit_done_w,
        cmd_valid: write_cmd_valid,
        cmd_ready: write_cmd_ready,
        cmd_address: write_cmd_address,
        wdata_valid: write_data_valid,
        wdata_ready: write_data_ready,
        wdata: write_data,
        wdata_mask: write_mask,
    );
    set write_busy = committing;
    reg(clk) write_crc_error reset(local_rst: false) = if valid && (command_index == CMD_GO_IDLE || (command_index == CMD_SEND_STATUS && !app)) {
        false
    } else if *write_done && !*write_good {
        true
    } else {
        write_crc_error
    };

    // Command legality, status, and response payload selection.
    let status: uint<32> = card_status_word$(
        card_state: state,
        committing: *committing,
        write_active,
        reading: data_state != READ_IDLE || pending,
        write_crc_error,
    );
    let addressed = command_argument == 0x00010000;
    let legal = match command_index {
        0 => true,
        8 => state == CARD_IDLE,
        41 => app && state == CARD_IDLE,
        2 => state == CARD_READY,
        3 => state == CARD_IDENTIFICATION,
        9 => state == CARD_STANDBY && addressed,
        7 => (state == CARD_STANDBY && addressed) || (state == CARD_TRANSFER && command_argument_zero),
        13 => (addressed && (state == CARD_STANDBY || state == CARD_TRANSFER)) || ssr,
        55 => state == CARD_IDLE || addressed,
        16 => state == CARD_TRANSFER && !write_active && command_argument == 512,
        24 => writable && transfer_idle,
        25 => writable && transfer_idle,
        17 => transfer_idle,
        18 => transfer_idle,
        12 => state == CARD_TRANSFER,
        51 => app && transfer_idle,
        6 => app && transfer_idle && (command_argument_zero || command_argument == 2),
        _ => false,
    };
    let error: uint<32> = if write_command && !writable {
        1 << 26
    } else if !legal {
        1 << 22
    } else if (read_command || write_command) && range_error {
        if (command_argument & 511) != 0 {
            1 << 30
        } else {
            1 << 31
        }
    } else {
        0
    };
    let payload: uint<32> = if error != 0 {
        status | error
    } else if command_index == CMD_SEND_IF_COND {
        command_argument & 0xfff
    } else if command_index == CMD_SEND_RCA {
        0x00010700
    } else if command_index == CMD_APP {
        status | 0x20
    } else {
        status
    };
    let r3: uint<48> = if (command_argument & 0x00ff8000) != 0 {
        0x3f80ff8000ff
    } else {
        0x3f00ff8000ff
    };
    // Capture response inputs before the CRC network. The extra <=12 ns stage
    // completes before the next SD falling edge at the 12 MHz candidate limit.
    reg(clk) saved_index: uint<6> reset(local_rst: 0) = if valid {
        command_index
    } else {
        saved_index
    };
    reg(clk) saved_payload: uint<32> reset(local_rst: 0) = if valid {
        payload
    } else {
        saved_payload
    };
    reg(clk) saved_r3: uint<48> reset(local_rst: 0) = if valid {
        r3
    } else {
        saved_r3
    };
    reg(clk) r3_reply reset(local_rst: false) = if valid {
        command_index == ACMD_SEND_OP_COND && legal
    } else {
        r3_reply
    };
    reg(clk) long_reply reset(local_rst: false) = if valid {
        legal && (command_index == CMD_ALL_SEND_CID || command_index == CMD_SEND_CSD)
    } else {
        long_reply
    };
    let long_header: uint<136> = 0x3f00000000000000000000000000000000;
    let cid: uint<136> = 0x7f52425350414445101234567801916b;
    let csd: uint<136> = if !writable {
        0x260009105903ffc000000002402033
    } else if fast_mode {
        0x0026001a115903ffc002800002400023
    } else {
        0x00260012115903ffc0028000024000d5
    };
    let answer: uint<136> = if long_reply {
        (long_header << 8) | (if saved_index == 2 { cid } else { csd })
    } else {
        zext(if r3_reply { saved_r3 } else { response48(saved_index, saved_payload) }) << 88
    };
    reg(clk) reply reset(local_rst: false) = valid && command_index != CMD_GO_IDLE && !deselect;
    reg(clk) response_delay reset(local_rst: false) = if reply {
        true
    } else if sd_output_advance {
        false
    } else {
        response_delay
    };
    let response_bit_ready = response_left > 0 && !response_delay;
    reg(clk) response: uint<136> reset(local_rst: 0) = {
        if reply {
            answer
        } else if sd_output_advance && response_bit_ready {
            response << 1
        } else {
            response
        }
    };
    reg(clk) response_left: uint<8> reset(local_rst: 0) = {
        if valid && command_index == CMD_GO_IDLE {
            0
        } else if reply {
            if long_reply {
                136
            } else {
                48
            }
        } else if sd_output_advance && response_bit_ready {
            response_left -. 1
        } else {
            response_left
        }
    };
    reg(clk) command_drive reset(local_rst: false) = if sd_output_advance {
        response_bit_ready
    } else {
        command_drive
    };
    reg(clk) prepared_command_enable reset(local_rst: false) = response_bit_ready;
    reg(clk) prepared_command_bit reset(local_rst: true) = response.to_bits()[135];
    let pad_command_enable = if fast_mode {
        prepared_command_enable
    } else {
        response_bit_ready
    };
    let pad_command_bit = if fast_mode {
        prepared_command_bit
    } else {
        response.to_bits()[135]
    };
    reg(output_clk) command_output reset(output_reset: true) = if sd_output_advance {
        if pad_command_enable {
            pad_command_bit
        } else {
            true
        }
    } else {
        command_output
    };
    reg(output_clk) command_pin_drive reset(output_reset: false) = if sd_output_advance {
        pad_command_enable
    } else {
        command_pin_drive
    };
    set cmd_oe = &(command_pin_drive && armed);
    set cmd_out = &command_output;


    // Read requests, sector ownership, and data serialization.
    let data_end = sd_output_advance && data_state == READ_RELEASE;
    let next_sector = data_end && multi && lba < last_lba;
    reg(clk) epoch: uint<32> reset(rst: 0) = if stop || !armed || read || next_sector {
        epoch +. 1
    } else {
        epoch
    };
    reg(clk) lba: uint<32> reset(local_rst: 0) = if read {
        command_argument >> 9
    } else if next_sector {
        lba +. 1
    } else {
        lba
    };
    reg(clk) pending reset(local_rst: false) = if stop {
        false
    } else if read || next_sector {
        true
    } else if sector_ready && sector_generation == epoch {
        false
    } else {
        pending
    };
    reg(clk) buffer_valid reset(local_rst: false) = if stop || data_end {
        false
    } else if pending && sector_ready && sector_generation == epoch {
        true
    } else {
        buffer_valid
    };
    reg(clk) multi reset(local_rst: false) = if stop {
        false
    } else if read {
        command_index == CMD_READ_MULTIPLE
    } else {
        multi
    };
    reg(clk) short_data reset(local_rst: false) = if read || ssr {
        false
    } else if scr {
        true
    } else if data_end {
        false
    } else {
        short_data
    };
    reg(clk) status_data reset(local_rst: false) = if read || scr || data_end {
        false
    } else if ssr {
        true
    } else {
        status_data
    };
    reg(clk) scr_pending reset(local_rst: false) = if stop || data_end {
        false
    } else if scr || ssr {
        true
    } else {
        scr_pending
    };
    let raw_data_start = response_left == 0 && !command_drive && (buffer_valid || scr_pending);
    reg(clk) prepared_data_start reset(local_rst: false) = raw_data_start;
    let data_start = if fast_mode {
        prepared_data_start
    } else {
        raw_data_start
    };
    reg(clk) data_state: uint<3> reset(local_rst: READ_IDLE) = {
        if stop {
            READ_IDLE
        } else if sd_output_advance {
            if data_state == READ_IDLE && data_start {
                READ_PAYLOAD
            } else if data_state == READ_PAYLOAD && bit_index == (if short_data {
                    63
                } else if status_data {
                    511
                } else {
                    4095
                }) {
                READ_CRC
            } else if data_state == READ_CRC && crc_index == 15 {
                READ_END_BIT
            } else if data_state == READ_END_BIT {
                READ_RELEASE
            } else if data_state == READ_RELEASE {
                READ_IDLE
            } else {
                data_state
            }
        } else {
            data_state
        }
    };
    reg(clk) bit_index: uint<12> reset(local_rst: 0) = {
        if stop || data_state == READ_IDLE {
            if wide {
                3
            } else {
                0
            }
        } else if sd_output_advance && data_state == READ_PAYLOAD {
            bit_index +. (if wide { 4 } else { 1 })
        } else {
            bit_index
        }
    };
    let offset: uint<9> = trunc(bit_index >> 3);
    let scr_value: uint<64> = 0x0105000000000000;
    let selected_byte: uint<8> = if short_data {
        trunc(scr_value >> (56 -. (zext(offset) << 3)))
    } else if status_data {
        if offset == 0 && wide {
            0x80
        } else {
            0
        }
    } else {
        sector_byte
    };
    let nibble: uint<4> = read_data_nibble(selected_byte, bit_index, wide);
    reg(clk) crcs: [uint<16>; 4] reset(local_rst: [0; 4]) = {
        if data_state == READ_IDLE {
            [0; 4]
        } else if sd_output_advance && data_state == READ_PAYLOAD {
            crcs.enumerate().map(fn |(lane, crc)| {
                    crc16_bit(crc, nibble.to_bits()[lane])
                })
        } else {
            crcs
        }
    };
    reg(clk) crc_index: uint<4> reset(local_rst: 0) = if data_state != READ_CRC {
        0
    } else if sd_output_advance {
        crc_index +. 1
    } else {
        crc_index
    };
    let crc_bits = crcs.map(fn |crc| {
            crc.to_bits()[15 -. crc_index]
        });
    // Decode during a full fabric cycle; opposite-edge pad registers only
    // select prepared values. Index/CRC state advances after each pad launch.

    // Prepared data and opposite-edge pad registers.
    reg(clk) prepared_nibble: uint<4> reset(local_rst: 15) = nibble;
    reg(clk) prepared_crc: uint<4> reset(local_rst: 15) = std::conv::bits_to_uint(crc_bits);
    let pad_nibble = if fast_mode {
        prepared_nibble
    } else {
        nibble
    };
    let pad_crc = if fast_mode {
        prepared_crc
    } else {
        std::conv::bits_to_uint(crc_bits)
    };
    let read_data_bit: uint<4> = if data_state == READ_PAYLOAD {
        pad_nibble
    } else if data_state == READ_CRC {
        pad_crc
    } else {
        15
    };
    let read_data_start = data_state == READ_IDLE && data_start;
    let read_data_drive = read_data_start || data_state == READ_PAYLOAD || data_state == READ_CRC || data_state == READ_END_BIT;
    reg(clk) prepared_pad_write reset(local_rst: false) = *write_oe != 0;
    reg(clk) prepared_pad_data: uint<4> reset(local_rst: 15) = if *write_oe != 0 {
        *write_dat
    } else {
        read_data_bit
    };
    reg(clk) registered_output_stop reset(local_rst: false) = stop;
    let output_stop = if fast_mode {
        registered_output_stop
    } else {
        stop
    };
    reg(output_clk) data_output: uint<4> reset(output_reset: 15) = {
        if output_stop && !(fast_mode && prepared_pad_write) {
            15
        } else if sd_output_advance {
            if fast_mode && prepared_pad_write {
                prepared_pad_data
            } else if read_data_start {
                if wide {
                    0
                } else {
                    14
                }
            } else if fast_mode {
                prepared_pad_data
            } else {
                read_data_bit
            }
        } else {
            data_output
        }
    };
    reg(output_clk) data_drive reset(output_reset: false) = if output_stop {
        false
    } else if sd_output_advance {
        read_data_drive
    } else {
        data_drive
    };
    reg(output_clk) pad_data_enable: uint<4> reset(output_reset: 0) = if output_stop && !prepared_pad_write {
        0
    } else if sd_output_advance {
        if prepared_pad_write {
            1
        } else if read_data_drive {
            if wide {
                15
            } else {
                1
            }
        } else {
            0
        }
    } else {
        pad_data_enable
    };
    // In fast mode DAT values leave the final registers directly, without a
    // read/write-response mux between the registers and the output buffers.
    set dat_out = &(if fast_mode {
            data_output
        } else if *write_oe != 0 {
            *write_dat
        } else {
            data_output
        });
    set dat_oe = &(if !armed {
            0
        } else if fast_mode {
            pad_data_enable
        } else if *write_oe != 0 {
            *write_oe
        } else if data_drive {
            if wide {
                15
            } else {
                1
            }
        } else {
            0
        });
    set byte_index = &offset;
    set request_valid = &pending;
    set request_lba = &lba;
    set generation = &epoch;
    // Break command-decode fanout into backend control. Generation changes on
    // the original event, so a late backend response is already stale before
    // this registered release arrives one management cycle later.
    reg(clk) release_event reset(rst: false) = stop || data_end;
    set sector_release = &release_event;
}

#[no_mangle(all)]
entity bram_emulator(
    clk: clock,
    rst: bool,
    rx_valid: bool,
    rx_byte: uint<8>,
    tx_ready: bool,
    tx_valid: inv &bool,
    tx_byte: inv &uint<8>,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    let (card_armed, card_armed_w): (&bool, inv &bool) = port;
    let (loader_valid, loader_valid_w): (&bool, inv &bool) = port;
    let (loader_address, loader_address_w): (&uint<32>, inv &uint<32>) = port;
    let (loader_byte, loader_byte_w): (&uint<8>, inv &uint<8>) = port;
    let (loader_ready, loader_ready_w): (&bool, inv &bool) = port;
    let (read_request, read_request_w): (&bool, inv &bool) = port;
    let (read_lba, read_lba_w): (&uint<32>, inv &uint<32>) = port;
    let (read_generation, read_generation_w): (&uint<32>, inv &uint<32>) = port;
    let (read_ready, read_ready_w): (&bool, inv &bool) = port;
    let (buffer_generation, buffer_generation_w): (&uint<32>, inv &uint<32>) = port;
    let (read_byte_index, read_byte_index_w): (&uint<9>, inv &uint<9>) = port;
    let (read_byte, read_byte_w): (&uint<8>, inv &uint<8>) = port;
    let (read_release, read_release_w): (&bool, inv &bool) = port;
    let (_, unused_selector): (&uint<7>, inv &uint<7>) = port;
    let _ = inst loader::image_loader$(
        clk,
        rst,
        status_word: 0,
        rx_valid,
        rx_byte,
        tx_ready,
        tx_valid,
        tx_byte,
        load_ready: *loader_ready,
        load_valid: loader_valid_w,
        load_address: loader_address_w,
        load_byte: loader_byte_w,
        armed: card_armed_w,
        status_selector: unused_selector,
    );
    let _ = inst storage::bram_backend$(
        clk,
        rst,
        armed: *card_armed,
        load_valid: *loader_valid,
        load_address: *loader_address,
        load_byte: *loader_byte,
        load_ready: loader_ready_w,
        request_valid: *read_request,
        request_lba: *read_lba,
        generation: *read_generation,
        buffer_release: *read_release,
        sector_ready: read_ready_w,
        sector_generation: buffer_generation_w,
        byte_index: *read_byte_index,
        sector_byte: read_byte_w,
    );
    let (unused_wc, unused_wc_w): (&bool, inv &bool) = port;
    let (unused_wa, unused_wa_w): (&uint<24>, inv &uint<24>) = port;
    let (unused_wv, unused_wv_w): (&bool, inv &bool) = port;
    let (unused_wd, unused_wd_w): (&uint<128>, inv &uint<128>) = port;
    let (unused_wm, unused_wm_w): (&uint<16>, inv &uint<16>) = port;
    let (unused_wb, unused_wb_w): (&bool, inv &bool) = port;
    let _ = inst sd_frontend$(
        clk,
        rst,
        armed: *card_armed,
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,
        request_valid: read_request_w,
        request_lba: read_lba_w,
        generation: read_generation_w,
        sector_ready: *read_ready,
        sector_generation: *buffer_generation,
        sector_byte: *read_byte,
        byte_index: read_byte_index_w,
        sector_release: read_release_w,
        fast_mode: false,
        writable: false,
        dat_in: 15,
        write_cmd_valid: unused_wc_w,
        write_cmd_ready: false,
        write_cmd_address: unused_wa_w,
        write_data_valid: unused_wv_w,
        write_data_ready: false,
        write_data: unused_wd_w,
        write_mask: unused_wm_w,
        write_busy: unused_wb_w,
    );
    set armed_status = card_armed;
}

#[no_mangle(all)]
entity emulator_uart(
    clk: clock,
    rst_n: bool,
    usb_rx: bool,
    usb_tx: inv &bool,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    let rst = !rst_n;
    let rx = inst shared_components::serial::uart_rx::<8>$(
        clk,
        rst,
        rx: usb_rx,
        bit_time: 100,
        parity: false,
        stop_bits: 1,
    );
    let (valid, valid_w): (&bool, inv &bool) = port;
    let (byte, byte_w): (&uint<8>, inv &uint<8>) = port;
    let (busy, busy_w): (&bool, inv &bool) = port;
    reg(clk) issued reset(rst: false) = *valid && !*busy && !issued;
    let send = *valid && !*busy && !issued;
    let _ = inst bram_emulator$(
        clk,
        rst,
        rx_valid: rx.valid && !rx.parity_error,
        rx_byte: rx.byte,
        tx_ready: send,
        tx_valid: valid_w,
        tx_byte: byte_w,
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,
        armed_status,
    );
    let tx = inst shared_components::serial::uart_tx::<100_000_000, 1_000_000, 8>$(
        clk,
        rst,
        block: false,
        data: *byte,
        new_data: send,
    );
    set busy_w = &tx.busy;
    set usb_tx = &tx.tx;
}

#[no_mangle(all)]
entity ddr_emulator(
    clk: clock,
    rst: bool,
    initialized: bool,
    diagnostic_status: uint<27>,
    status_selector: inv &uint<7>,
    fast_mode: bool,
    writable: bool,
    dat_in: uint<4>,
    ddr_cmd_valid: inv &bool,
    ddr_cmd_ready: bool,
    ddr_cmd_address: inv &uint<24>,
    ddr_cmd_write: inv &bool,
    ddr_rdata_valid: bool,
    ddr_rdata_ready: inv &bool,
    ddr_rdata: uint<128>,
    ddr_wdata_valid: inv &bool,
    ddr_wdata_ready: bool,
    ddr_wdata: inv &uint<128>,
    ddr_wdata_mask: inv &uint<16>,
    rx_valid: bool,
    rx_byte: uint<8>,
    tx_ready: bool,
    tx_valid: inv &bool,
    tx_byte: inv &uint<8>,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    let (card_armed, card_armed_w): (&bool, inv &bool) = port;
    let (loader_valid, loader_valid_w): (&bool, inv &bool) = port;
    let (loader_address, loader_address_w): (&uint<32>, inv &uint<32>) = port;
    let (loader_byte, loader_byte_w): (&uint<8>, inv &uint<8>) = port;
    let (loader_ready, loader_ready_w): (&bool, inv &bool) = port;
    let (read_request, read_request_w): (&bool, inv &bool) = port;
    let (read_lba, read_lba_w): (&uint<32>, inv &uint<32>) = port;
    let (read_generation, read_generation_w): (&uint<32>, inv &uint<32>) = port;
    let (read_ready, read_ready_w): (&bool, inv &bool) = port;
    let (buffer_generation, buffer_generation_w): (&uint<32>, inv &uint<32>) = port;
    let (read_byte_index, read_byte_index_w): (&uint<9>, inv &uint<9>) = port;
    let (read_byte, read_byte_w): (&uint<8>, inv &uint<8>) = port;
    let (read_release, read_release_w): (&bool, inv &bool) = port;
    let _ = inst loader::image_loader$(
        clk,
        rst,
        status_word: (zext::<27, 32>(diagnostic_status) << 5) | zext(std::conv::bits_to_uint([initialized, ddr_cmd_ready, ddr_wdata_ready, *card_armed, ddr_rdata_valid])),
        rx_valid,
        rx_byte,
        tx_ready,
        tx_valid,
        tx_byte,
        load_ready: *loader_ready,
        load_valid: loader_valid_w,
        load_address: loader_address_w,
        load_byte: loader_byte_w,
        armed: card_armed_w,
        status_selector,
    );
    let (read_cmd_valid, read_cmd_valid_w): (&bool, inv &bool) = port;
    let (read_cmd_address, read_cmd_address_w): (&uint<24>, inv &uint<24>) = port;
    let (loader_cmd_valid, loader_cmd_valid_w): (&bool, inv &bool) = port;
    let (loader_cmd_address, loader_cmd_address_w): (&uint<24>, inv &uint<24>) = port;
    let (sd_write_cmd_valid, sd_write_cmd_valid_w): (&bool, inv &bool) = port;
    let (sd_write_cmd_address, sd_write_cmd_address_w): (&uint<24>, inv &uint<24>) = port;
    let (sd_write_data_valid, sd_write_data_valid_w): (&bool, inv &bool) = port;
    let (sd_write_data, sd_write_data_w): (&uint<128>, inv &uint<128>) = port;
    let (sd_write_mask, sd_write_mask_w): (&uint<16>, inv &uint<16>) = port;
    let (sd_commit_busy, sd_commit_busy_w): (&bool, inv &bool) = port;
    let (loader_data_valid, loader_data_valid_w): (&bool, inv &bool) = port;
    let (loader_data, loader_data_w): (&uint<128>, inv &uint<128>) = port;
    let (loader_mask, loader_mask_w): (&uint<16>, inv &uint<16>) = port;
    // The sector writer stages 16 bytes before issuing its first DDR beat.
    // Register ownership during that staging time, cutting final-CRC decode
    // out of the wide data mux/FIFO enables. Keep it through the final beat
    // and one following idle cycle. Raw busy still blocks a new UART load
    // immediately when SD accepts a packet on the same edge as disarm.
    reg(clk) sd_commit_owner reset(rst: false) = *sd_commit_busy;
    let sd_owner = if fast_mode {
        sd_commit_owner
    } else {
        *sd_commit_busy
    };
    // Accepted SD commits retain ownership even if the loader disarms SD.
    // native_stage orders the final buffered write ahead of subsequent reads.
    // Pipeline the whole request/cancellation bundle together. Generation
    // tagging still rejects a stale buffer immediately at the SD frontend.
    reg(clk) backend_inputs: (bool, bool, bool, uint<32>, uint<32>, bool)
    reset(rst: (false, false, false, 0, 0, true)) = (*card_armed, initialized, *read_request, *read_lba, *read_generation, *read_release);
    let (backend_arm, backend_initialized, backend_request, backend_lba, backend_epoch, backend_release) = if fast_mode {
        backend_inputs
    } else {
        (*card_armed, initialized, *read_request, *read_lba, *read_generation, *read_release)
    };
    let _ = inst storage::ddr_backend$(
        clk,
        rst,
        armed: backend_arm,
        initialized: backend_initialized,
        resident_bytes: 268_435_456,
        request_valid: backend_request,
        request_lba: backend_lba,
        generation: backend_epoch,
        buffer_release: backend_release,
        sector_ready: read_ready_w,
        sector_generation: buffer_generation_w,
        byte_index: *read_byte_index,
        sector_byte: read_byte_w,
        cmd_valid: read_cmd_valid_w,
        cmd_ready: ddr_cmd_ready && *card_armed && !sd_owner,
        cmd_address: read_cmd_address_w,
        rdata_valid: ddr_rdata_valid,
        rdata_ready: ddr_rdata_ready,
        rdata: ddr_rdata,
    );
    let _ = inst storage::ddr_byte_writer$(
        clk,
        rst,
        enabled: !*card_armed && initialized && !*sd_commit_busy && !sd_owner,
        load_valid: *loader_valid,
        load_address: *loader_address,
        load_byte: *loader_byte,
        load_ready: loader_ready_w,
        cmd_valid: loader_cmd_valid_w,
        cmd_ready: ddr_cmd_ready && !*card_armed && !sd_owner,
        cmd_address: loader_cmd_address_w,
        wdata_valid: loader_data_valid_w,
        wdata_ready: ddr_wdata_ready && !sd_owner,
        wdata: loader_data_w,
        wdata_mask: loader_mask_w,
    );
    set ddr_cmd_valid = &(if sd_owner {
            *sd_write_cmd_valid
        } else if *card_armed {
            *read_cmd_valid
        } else {
            *loader_cmd_valid
        });
    set ddr_cmd_address = &(if sd_owner {
            *sd_write_cmd_address
        } else if *card_armed {
            *read_cmd_address
        } else {
            *loader_cmd_address
        });
    set ddr_cmd_write = &(sd_owner || !*card_armed);
    set ddr_wdata_valid = &(if sd_owner { *sd_write_data_valid } else { *loader_data_valid });
    set ddr_wdata = &(if sd_owner { *sd_write_data } else { *loader_data });
    set ddr_wdata_mask = &(if sd_owner { *sd_write_mask } else { *loader_mask });
    let _ = inst sd_frontend$(
        clk,
        rst,
        armed: *card_armed && initialized,
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,
        request_valid: read_request_w,
        request_lba: read_lba_w,
        generation: read_generation_w,
        sector_ready: *read_ready,
        sector_generation: *buffer_generation,
        sector_byte: *read_byte,
        byte_index: read_byte_index_w,
        sector_release: read_release_w,
        fast_mode,
        writable,
        dat_in,
        write_cmd_valid: sd_write_cmd_valid_w,
        write_cmd_ready: ddr_cmd_ready && sd_owner,
        write_cmd_address: sd_write_cmd_address_w,
        write_data_valid: sd_write_data_valid_w,
        write_data_ready: ddr_wdata_ready && sd_owner,
        write_data: sd_write_data_w,
        write_mask: sd_write_mask_w,
        write_busy: sd_commit_busy_w,
    );
    set armed_status = &(*card_armed && initialized);
}

// UART divisors track the selected DDR system clock.
entity ddr_uart_core<#uint CLK_FREQ>(
    clk: clock,
    rst: bool,
    initialized: bool,
    diagnostic_status: uint<27>,
    status_selector: inv &uint<7>,
    fast_mode: bool,
    writable: bool,
    dat_in: uint<4>,
    usb_rx: bool,
    usb_tx: inv &bool,
    ddr_cmd_valid: inv &bool,
    ddr_cmd_ready: bool,
    ddr_cmd_address: inv &uint<24>,
    ddr_cmd_write: inv &bool,
    ddr_rdata_valid: bool,
    ddr_rdata_ready: inv &bool,
    ddr_rdata: uint<128>,
    ddr_wdata_valid: inv &bool,
    ddr_wdata_ready: bool,
    ddr_wdata: inv &uint<128>,
    ddr_wdata_mask: inv &uint<16>,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    let rx_cycles: uint<32> = CLK_FREQ `std::ops::comb_div` 1_000_000;
    let rx = inst shared_components::serial::uart_rx::<8>$(
        clk,
        rst,
        rx: usb_rx,
        bit_time: trunc(rx_cycles),
        parity: false,
        stop_bits: 1,
    );
    let (valid, valid_w): (&bool, inv &bool) = port;
    let (byte, byte_w): (&uint<8>, inv &uint<8>) = port;
    let (busy, busy_w): (&bool, inv &bool) = port;
    reg(clk) issued reset(rst: false) = *valid && !*busy && !issued;
    let send = *valid && !*busy && !issued;
    let _ = inst ddr_emulator$(
        clk,
        rst,
        initialized,
        diagnostic_status,
        status_selector,
        fast_mode,
        writable,
        dat_in,
        ddr_cmd_valid,
        ddr_cmd_ready,
        ddr_cmd_address,
        ddr_cmd_write,
        ddr_rdata_valid,
        ddr_rdata_ready,
        ddr_rdata,
        ddr_wdata_valid,
        ddr_wdata_ready,
        ddr_wdata,
        ddr_wdata_mask,
        rx_valid: rx.valid && !rx.parity_error,
        rx_byte: rx.byte,
        tx_ready: send,
        tx_valid: valid_w,
        tx_byte: byte_w,
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,
        armed_status,
    );
    let tx = inst shared_components::serial::uart_tx::<CLK_FREQ, 1_000_000, 8>$(
        clk,
        rst,
        block: false,
        data: *byte,
        new_data: send,
    );
    set busy_w = &tx.busy;
    set usb_tx = &tx.tx;
}

