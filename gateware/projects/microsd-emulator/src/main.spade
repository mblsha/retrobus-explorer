#[no_mangle(all)]
entity ddr_uart_200(
    clk: clock,
    rst: bool,
    initialized: bool,
    diagnostic_status: uint<27>,
    status_selector: inv &uint<7>,
    writable: bool,
    dat_in: uint<4>,
    usb_rx: bool,
    usb_tx: inv &bool,
    ddr_cmd_valid: inv &bool,
    ddr_cmd_ready: bool,
    ddr_cmd_address: inv &uint<24>,
    ddr_cmd_write: inv &bool,
    ddr_rdata_valid: bool,
    ddr_rdata_ready: inv &bool,
    ddr_rdata: uint<128>,
    ddr_wdata_valid: inv &bool,
    ddr_wdata_ready: bool,
    ddr_wdata: inv &uint<128>,
    ddr_wdata_mask: inv &uint<16>,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    let _ = inst ddr_uart_core::<200_000_000>$(
        clk,
        rst,
        initialized,
        diagnostic_status,
        status_selector,
        fast_mode: true,
        writable,
        dat_in,
        usb_rx,
        usb_tx,
        ddr_cmd_valid,
        ddr_cmd_ready,
        ddr_cmd_address,
        ddr_cmd_write,
        ddr_rdata_valid,
        ddr_rdata_ready,
        ddr_rdata,
        ddr_wdata_valid,
        ddr_wdata_ready,
        ddr_wdata,
        ddr_wdata_mask,
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,
        armed_status,
    );
}

