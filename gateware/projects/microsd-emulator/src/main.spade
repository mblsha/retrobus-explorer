#[no_mangle(all)]
entity ddr_emulator_cdc(
    memory_clk: clock,
    memory_rst: bool,
    clk: clock,
    rst: bool,
    initialized: bool,
    diagnostic_status: uint<27>,
    status_selector: inv &uint<7>,
    fast_mode: bool,
    writable: bool,
    dat_in: uint<4>,
    ddr_cmd_valid: inv &bool,
    ddr_cmd_ready: bool,
    ddr_cmd_address: inv &uint<24>,
    ddr_cmd_write: inv &bool,
    ddr_rdata_valid: bool,
    ddr_rdata_ready: inv &bool,
    ddr_rdata: uint<128>,
    ddr_wdata_valid: inv &bool,
    ddr_wdata_ready: bool,
    ddr_wdata: inv &uint<128>,
    ddr_wdata_mask: inv &uint<16>,
    rx_valid: bool,
    rx_byte: uint<8>,
    tx_ready: bool,
    tx_valid: inv &bool,
    tx_byte: inv &uint<8>,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    // Exercise the separately clocked frontend / 80 MHz native-memory boundary.
    let (fcv, fcv_w): (&bool, inv &bool) = port;
    let (fcr, fcr_w): (&bool, inv &bool) = port;
    let (fa, fa_w): (&uint<24>, inv &uint<24>) = port;
    let (fcw, fcw_w): (&bool, inv &bool) = port;
    let (fwv, fwv_w): (&bool, inv &bool) = port;
    let (fwr, fwr_w): (&bool, inv &bool) = port;
    let (fwd, fwd_w): (&uint<128>, inv &uint<128>) = port;
    let (fwm, fwm_w): (&uint<16>, inv &uint<16>) = port;
    let (frv, frv_w): (&bool, inv &bool) = port;
    let (frr, frr_w): (&bool, inv &bool) = port;
    let (frd, frd_w): (&uint<128>, inv &uint<128>) = port;
    let (mcv, mcv_w): (&bool, inv &bool) = port;
    let (mcr, mcr_w): (&bool, inv &bool) = port;
    let (ma, ma_w): (&uint<24>, inv &uint<24>) = port;
    let (mcw, mcw_w): (&bool, inv &bool) = port;
    let (mwv, mwv_w): (&bool, inv &bool) = port;
    let (mwr, mwr_w): (&bool, inv &bool) = port;
    let (mwd, mwd_w): (&uint<128>, inv &uint<128>) = port;
    let (mwm, mwm_w): (&uint<16>, inv &uint<16>) = port;
    let (mrv, mrv_w): (&bool, inv &bool) = port;
    let (mrr, mrr_w): (&bool, inv &bool) = port;
    let (mrd, mrd_w): (&uint<128>, inv &uint<128>) = port;
    let _ = inst ddr_emulator$(
        clk,
        rst,
        initialized,
        diagnostic_status,
        status_selector,
        fast_mode,
        writable,
        dat_in,
        ddr_cmd_valid: fcv_w,
        ddr_cmd_ready: *fcr,
        ddr_cmd_address: fa_w,
        ddr_cmd_write: fcw_w,
        ddr_rdata_valid: *frv,
        ddr_rdata_ready: frr_w,
        ddr_rdata: *frd,
        ddr_wdata_valid: fwv_w,
        ddr_wdata_ready: *fwr,
        ddr_wdata: fwd_w,
        ddr_wdata_mask: fwm_w,
        rx_valid,
        rx_byte,
        tx_ready,
        tx_valid,
        tx_byte,
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,
        armed_status,
    );
    let _ = inst cdc::native_cdc$(
        s_clk: clk,
        s_rst: rst,
        m_clk: memory_clk,
        m_rst: memory_rst,
        s_cmd_valid: *fcv,
        s_cmd_ready: fcr_w,
        s_cmd_address: *fa,
        s_cmd_write: *fcw,
        m_cmd_valid: mcv_w,
        m_cmd_ready: *mcr,
        m_cmd_address: ma_w,
        m_cmd_write: mcw_w,
        s_wdata_valid: *fwv,
        s_wdata_ready: fwr_w,
        s_wdata: *fwd,
        s_wmask: *fwm,
        m_wdata_valid: mwv_w,
        m_wdata_ready: *mwr,
        m_wdata: mwd_w,
        m_wmask: mwm_w,
        m_rdata_valid: *mrv,
        m_rdata_ready: mrr_w,
        m_rdata: *mrd,
        s_rdata_valid: frv_w,
        s_rdata_ready: *frr,
        s_rdata: frd_w,
    );
    let _ = inst cdc::native_stage$(
        clk: memory_clk,
        rst: memory_rst,
        s_cmd_valid: *mcv,
        s_cmd_ready: mcr_w,
        s_cmd_address: *ma,
        s_cmd_write: *mcw,
        s_wdata_valid: *mwv,
        s_wdata_ready: mwr_w,
        s_wdata: *mwd,
        s_wmask: *mwm,
        s_rdata_valid: mrv_w,
        s_rdata_ready: *mrr,
        s_rdata: mrd_w,
        m_cmd_valid: ddr_cmd_valid,
        m_cmd_ready: ddr_cmd_ready,
        m_cmd_address: ddr_cmd_address,
        m_cmd_write: ddr_cmd_write,
        m_wdata_valid: ddr_wdata_valid,
        m_wdata_ready: ddr_wdata_ready,
        m_wdata: ddr_wdata,
        m_wmask: ddr_wdata_mask,
        m_rdata_valid: ddr_rdata_valid,
        m_rdata_ready: ddr_rdata_ready,
        m_rdata: ddr_rdata,
    );
}
