            data_output
        } else if *write_response_enable != 0 {
            *write_response_data
        } else {
            data_output
        });
    let data_output_enable: uint<4> = if !armed {
            0
        } else if select_busy {
            1
        } else if prepared_data_mode {
            pad_data_enable
        } else if *write_response_enable != 0 {
            *write_response_enable
        } else if data_drive {
            if wide {
                15
            } else {
                1
            }
        } else {
            0
        };
    // The H700 adapter path has no effective pull-up. Released response ones
    // were already observed as lows on CMD, and the same defect leaves DAT0
    // low once the R1b select pulse releases it. The host reads that as a card
    // that never leaves busy, so it keeps clocking without issuing another
    // command. Hold the idle high level explicitly while this profile drives
    // nothing: the value already sits high in the final data registers, so
    // only the output enable changes and the qualified register-to-pad data
    // path is untouched. Active transfers, the deliberate busy pulse, and host
    // write data keep the standards-compliant released behavior, and the
    // qualified SD and GKD MMC profiles are unaffected.
    // Register everything except the live transfer mask. Those terms come from
    // registers spread across the die, and combining them on the way to the
    // output buffer put a long multi-level path on the SD fabric clock. One
    // fabric cycle of lag is irrelevant to a level held for microseconds.
    reg(clk) h700_idle_data_armed reset(local_rst: false) = h700_mode && armed &&
        host_clock_active && !select_busy && !write_active;
    // The held value is refreshed by the next SD edge. The liveness gate below
    // only engages while the host is clocking, so the level this presents is
    // never stale for more than one host clock period.
    let h700_idle_data_high = h700_idle_data_armed && data_output_enable == 0;
    set dat_oe = &(if data_output_enable != 0 {
            data_output_enable
        } else if h700_idle_data_high {
            15
        } else {
            0
        });
    // Observe complete read-data bursts through the IOBUF input path. This
    // checker is independent of the serializer state: it counts host sampling
    // edges while an output lane is enabled and compares pin readback with the
    // final pad register. It cannot prove the waveform beyond JD's resistor.
    let observed_data_enable = pad_data_enable != 0;
    reg(clk) observed_data_enable_previous: uint<4> reset(local_rst: 0) = pad_data_enable;
    let observed_data_start = observed_data_enable && observed_data_enable_previous == 0;
    let observed_data_finish = !observed_data_enable && observed_data_enable_previous != 0;
    let observed_data_sample = armed && sd_sample_tick && observed_data_enable;
    let observed_data_mismatch_now = ((dat_sync ^ data_output) & pad_data_enable) != 0;
    reg(clk) observed_data_samples: uint<16> reset(local_rst: 0) = {
        if observed_data_start {
            if observed_data_sample { 1 } else { 0 }
        } else if observed_data_sample {
            observed_data_samples +. 1
        } else {
            observed_data_samples
        }
    };
    reg(clk) observed_data_mismatch reset(local_rst: false) = {
        if observed_data_start {
            observed_data_sample && observed_data_mismatch_now
        } else if observed_data_sample && observed_data_mismatch_now {
            true
        } else {
            observed_data_mismatch
        }
    };
    reg(clk) observed_data_mismatch_count: uint<16> reset(local_rst: 0) = {
        if observed_data_start {
            if observed_data_sample && observed_data_mismatch_now { 1 } else { 0 }
        } else if observed_data_sample && observed_data_mismatch_now {
            observed_data_mismatch_count +. 1
        } else {
            observed_data_mismatch_count
        }
    };
    reg(clk) observed_data_first_mismatch: uint<16> reset(local_rst: 0xffff) = {
        if observed_data_start {
            if observed_data_sample && observed_data_mismatch_now { 0 } else { 0xffff }
        } else if observed_data_sample && observed_data_mismatch_now &&
            observed_data_first_mismatch == 0xffff {
            observed_data_samples
        } else {
            observed_data_first_mismatch
        }
    };
    reg(clk) observed_data_lanes: uint<4> reset(local_rst: 0) = if observed_data_start {
        pad_data_enable
    } else {
        observed_data_lanes
    };
    reg(clk) completed_data_samples: uint<16> reset(local_rst: 0) = if observed_data_finish {
        observed_data_samples
    } else {
        completed_data_samples
    };
    reg(clk) completed_data_mismatch reset(local_rst: false) = if observed_data_finish {
        observed_data_mismatch
    } else {
        completed_data_mismatch
    };
    reg(clk) completed_data_mismatch_count: uint<16> reset(local_rst: 0) = if observed_data_finish {
        observed_data_mismatch_count
    } else {
        completed_data_mismatch_count
    };
    reg(clk) completed_data_first_mismatch: uint<16> reset(local_rst: 0xffff) = if observed_data_finish {
        observed_data_first_mismatch
    } else {
        completed_data_first_mismatch
    };
    reg(clk) completed_data_blocks: uint<8> reset(local_rst: 0) = if observed_data_finish {
        completed_data_blocks +. 1
    } else {
        completed_data_blocks
    };
    let observed_data_mismatch_flag: uint<32> = if completed_data_mismatch { 1 << 24 } else { 0 };
    let observed_data_active_flag: uint<32> = if observed_data_enable { 1 << 25 } else { 0 };
    set trace_pin_data = &(zext(completed_data_samples) |
        (zext(completed_data_blocks) << 16) | observed_data_mismatch_flag |
        observed_data_active_flag | (zext(observed_data_lanes) << 26));
    set trace_pin_data_mismatch = &(zext(completed_data_mismatch_count) |
        (zext(completed_data_first_mismatch) << 16));
    // A passive snapshot distinguishes a response still being serialized from
    // a completed CMD7 whose host did not issue the following command. It has
    // no control-path role and is read only through the Ethernet trace service.
    let trace_mmc: uint<32> = if mmc_mode { 1 << 12 } else { 0 };
    let trace_open_drain: uint<32> = if open_drain_reply { 1 << 13 } else { 0 };
    let trace_select_busy: uint<32> = if select_busy { 1 << 14 } else { 0 };
    let trace_idle_data_high: uint<32> = if h700_idle_data_high { 1 << 15 } else { 0 };
    let trace_command_drive: uint<32> = if command_pin_drive { 1 << 22 } else { 0 };
    let trace_command_output: uint<32> = if command_output { 1 << 23 } else { 0 };
    let trace_data_drive: uint<32> = if data_drive { 1 << 24 } else { 0 };
    let trace_block_256: uint<32> = if block_length_256 { 1 << 29 } else { 0 };
    let trace_wide: uint<32> = if wide { 1 << 30 } else { 0 };
    let trace_loader_read: uint<32> = if boot_read_seen { 1 << 31 } else { 0 };
    set trace_protocol_status = &(zext(response_left) | (zext(state) << 8) |
        trace_mmc | trace_open_drain | trace_select_busy | trace_idle_data_high |
        (zext(saved_index) << 16) | trace_command_drive | trace_command_output |
        trace_data_drive | (zext(pad_data_enable) << 25) | trace_block_256 |
        trace_wide | trace_loader_read);
    let backend_offset = if block_length_256 && half {
        offset | 256
    } else {
        offset
    };
    set byte_index = &backend_offset;
    set request_valid = &pending;
    set request_lba = &lba;
    set generation = &epoch;
    // Break command-decode fanout into backend control. Generation changes on
    // the original event, so a late backend response is already stale before
    // this registered release arrives one management cycle later.
    reg(clk) release_event reset(rst: false) = read_stop_now || data_end;
    set sector_release = &release_event;
}

#[no_mangle(all)]
entity bram_emulator(
    clk: clock,
    rst: bool,
    rx_valid: bool,
    rx_byte: uint<8>,
    tx_ready: bool,
    tx_valid: inv &bool,
    tx_byte: inv &uint<8>,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    let (card_armed, card_armed_w): (&bool, inv &bool) = port;
    let (loader_valid, loader_valid_w): (&bool, inv &bool) = port;
    let (loader_address, loader_address_w): (&uint<32>, inv &uint<32>) = port;
    let (loader_byte, loader_byte_w): (&uint<8>, inv &uint<8>) = port;
    let (loader_ready, loader_ready_w): (&bool, inv &bool) = port;
    let (read_request, read_request_w): (&bool, inv &bool) = port;
    let (read_lba, read_lba_w): (&uint<32>, inv &uint<32>) = port;
    let (read_generation, read_generation_w): (&uint<32>, inv &uint<32>) = port;
    let (read_ready, read_ready_w): (&bool, inv &bool) = port;
    let (buffer_generation, buffer_generation_w): (&uint<32>, inv &uint<32>) = port;
    let (read_byte_index, read_byte_index_w): (&uint<9>, inv &uint<9>) = port;
    let (read_byte, read_byte_w): (&uint<8>, inv &uint<8>) = port;
    let (read_release, read_release_w): (&bool, inv &bool) = port;
    let (_, unused_selector): (&uint<7>, inv &uint<7>) = port;
    let _ = inst loader::image_loader$(
        clk,
        rst,
        status_word: 0,
        rx_valid,
        rx_byte,
        tx_ready,
        tx_valid,
        tx_byte,
        load_ready: *loader_ready,
        load_valid: loader_valid_w,
        load_address: loader_address_w,
        load_byte: loader_byte_w,
        armed: card_armed_w,
        status_selector: unused_selector,
    );
    let _ = inst storage::bram_backend$(
        clk,
        rst,
        armed: *card_armed,
        load_valid: *loader_valid,
        load_address: *loader_address,
        load_byte: *loader_byte,
        load_ready: loader_ready_w,
        request_valid: *read_request,
        request_lba: *read_lba,
        generation: *read_generation,
        buffer_release: *read_release,
        sector_ready: read_ready_w,
        sector_generation: buffer_generation_w,
        byte_index: *read_byte_index,
        sector_byte: read_byte_w,
    );
    let (unused_wc, unused_wc_w): (&bool, inv &bool) = port;
    let (unused_wa, unused_wa_w): (&uint<24>, inv &uint<24>) = port;
    let (unused_wv, unused_wv_w): (&bool, inv &bool) = port;
    let (unused_wd, unused_wd_w): (&uint<128>, inv &uint<128>) = port;
    let (unused_wm, unused_wm_w): (&uint<16>, inv &uint<16>) = port;
    let (unused_wb, unused_wb_w): (&bool, inv &bool) = port;
    let (_, unused_trace_clock): (&bool, inv &bool) = port;
    let (_, unused_trace_frame): (&bool, inv &bool) = port;
    let (_, unused_trace_valid): (&bool, inv &bool) = port;
    let (_, unused_trace_command): (&uint<6>, inv &uint<6>) = port;
    let (_, unused_trace_argument): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_response): (&bool, inv &bool) = port;
    let (_, unused_trace_response_complete): (&bool, inv &bool) = port;
    let (_, unused_trace_response_payload): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_data_release): (&bool, inv &bool) = port;
    let (_, unused_trace_protocol_status): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_pin_response): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_pin_response_mismatch): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_pin_data): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_pin_data_mismatch): (&uint<32>, inv &uint<32>) = port;
    let _ = inst sd_frontend$(

        // Clock and card control
        clk,
        rst,
        armed: *card_armed,

        // SD pins
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,

        // Read-buffer exchange
        request_valid: read_request_w,
        request_lba: read_lba_w,
        generation: read_generation_w,
        sector_ready: *read_ready,
        sector_generation: *buffer_generation,
        sector_byte: *read_byte,
        byte_index: read_byte_index_w,
        sector_release: read_release_w,

        // Mode and write-side inputs
        fast_mode: false,
        h700_mode: false,
        h700_falling_phase: false,
        h700_early_command: false,
        sd_csd: 0x0026001a115903ffc002800002400023,
        mmc_only: false,
        writable: false,
        dat_in: 15,

        // DDR write command
        write_cmd_valid: unused_wc_w,
        write_cmd_ready: false,
        write_cmd_address: unused_wa_w,

        // DDR write data
        write_data_valid: unused_wv_w,
        write_data_ready: false,
        write_data: unused_wd_w,
        write_mask: unused_wm_w,
        write_busy: unused_wb_w,
        trace_clock_tick: unused_trace_clock,
        trace_frame: unused_trace_frame,
        trace_valid: unused_trace_valid,
        trace_command: unused_trace_command,
        trace_argument: unused_trace_argument,
        trace_response: unused_trace_response,
        trace_response_complete: unused_trace_response_complete,
        trace_response_payload: unused_trace_response_payload,
        trace_data_release: unused_trace_data_release,
        trace_protocol_status: unused_trace_protocol_status,
        trace_pin_response: unused_trace_pin_response,
        trace_pin_response_mismatch: unused_trace_pin_response_mismatch,
        trace_pin_data: unused_trace_pin_data,
        trace_pin_data_mismatch: unused_trace_pin_data_mismatch,
    );
    set armed_status = card_armed;
}

#[no_mangle(all)]
entity emulator_uart(
    clk: clock,
    rst_n: bool,
    usb_rx: bool,
    usb_tx: inv &bool,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    let rst = !rst_n;
    let rx = inst shared_components::serial::uart_rx::<8>$(
        clk,
        rst,
        rx: usb_rx,
        bit_time: 100,
        parity: false,
        stop_bits: 1,
    );
    let (valid, valid_w): (&bool, inv &bool) = port;
    let (byte, byte_w): (&uint<8>, inv &uint<8>) = port;
    let (busy, busy_w): (&bool, inv &bool) = port;
    reg(clk) issued reset(rst: false) = *valid && !*busy && !issued;
    let send = *valid && !*busy && !issued;
    let _ = inst bram_emulator$(
        clk,
        rst,
        rx_valid: rx.valid && !rx.parity_error,
        rx_byte: rx.byte,
        tx_ready: send,
        tx_valid: valid_w,
        tx_byte: byte_w,
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,
        armed_status,
    );
    let tx = inst shared_components::serial::uart_tx::<100_000_000, 1_000_000, 8>$(
        clk,
        rst,
        block: false,
        data: *byte,
        new_data: send,
    );
    set busy_w = &tx.busy;
    set usb_tx = &tx.tx;
}

#[no_mangle(all)]
entity ddr_emulator(
    clk: clock,
    rst: bool,
    initialized: bool,
    diagnostic_status: uint<27>,
    status_selector: inv &uint<7>,
    fast_mode: bool,
    writable: bool,
    dat_in: uint<4>,
    ddr_cmd_valid: inv &bool,
    ddr_cmd_ready: bool,
    ddr_cmd_address: inv &uint<24>,
    ddr_cmd_write: inv &bool,
    ddr_rdata_valid: bool,
    ddr_rdata_ready: inv &bool,
    ddr_rdata: uint<128>,
    ddr_wdata_valid: inv &bool,
    ddr_wdata_ready: bool,
    ddr_wdata: inv &uint<128>,
    ddr_wdata_mask: inv &uint<16>,
    rx_valid: bool,
    rx_byte: uint<8>,
    tx_ready: bool,
    tx_valid: inv &bool,
    tx_byte: inv &uint<8>,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    let (card_armed, card_armed_w): (&bool, inv &bool) = port;
    let (loader_valid, loader_valid_w): (&bool, inv &bool) = port;
    let (loader_address, loader_address_w): (&uint<32>, inv &uint<32>) = port;
    let (loader_byte, loader_byte_w): (&uint<8>, inv &uint<8>) = port;
    let (loader_ready, loader_ready_w): (&bool, inv &bool) = port;
    let (read_request, read_request_w): (&bool, inv &bool) = port;
    let (read_lba, read_lba_w): (&uint<32>, inv &uint<32>) = port;
    let (read_generation, read_generation_w): (&uint<32>, inv &uint<32>) = port;
    let (read_ready, read_ready_w): (&bool, inv &bool) = port;
    let (buffer_generation, buffer_generation_w): (&uint<32>, inv &uint<32>) = port;
    let (read_byte_index, read_byte_index_w): (&uint<9>, inv &uint<9>) = port;
    let (read_byte, read_byte_w): (&uint<8>, inv &uint<8>) = port;
    let (read_release, read_release_w): (&bool, inv &bool) = port;
    // Low bits expose live interface state; upper bits carry BIST diagnostics.
    let loader_status_word: uint<32> = (zext::<27, 32>(diagnostic_status) << 5)
        | zext(std::conv::bits_to_uint([
            initialized, ddr_cmd_ready, ddr_wdata_ready, *card_armed, ddr_rdata_valid,
        ]));
    let _ = inst loader::image_loader$(
        clk,
        rst,
        status_word: loader_status_word,
        rx_valid,
        rx_byte,
        tx_ready,
        tx_valid,
        tx_byte,
        load_ready: *loader_ready,
        load_valid: loader_valid_w,
        load_address: loader_address_w,
        load_byte: loader_byte_w,
        armed: card_armed_w,
        status_selector,
    );
    let (read_cmd_valid, read_cmd_valid_w): (&bool, inv &bool) = port;
    let (read_cmd_address, read_cmd_address_w): (&uint<24>, inv &uint<24>) = port;
    let (loader_cmd_valid, loader_cmd_valid_w): (&bool, inv &bool) = port;
    let (loader_cmd_address, loader_cmd_address_w): (&uint<24>, inv &uint<24>) = port;
    let (sd_write_cmd_valid, sd_write_cmd_valid_w): (&bool, inv &bool) = port;
    let (sd_write_cmd_address, sd_write_cmd_address_w): (&uint<24>, inv &uint<24>) = port;
    let (sd_write_data_valid, sd_write_data_valid_w): (&bool, inv &bool) = port;
    let (sd_write_data, sd_write_data_w): (&uint<128>, inv &uint<128>) = port;
    let (sd_write_mask, sd_write_mask_w): (&uint<16>, inv &uint<16>) = port;
    let (sd_commit_busy, sd_commit_busy_w): (&bool, inv &bool) = port;
    let (loader_data_valid, loader_data_valid_w): (&bool, inv &bool) = port;
    let (loader_data, loader_data_w): (&uint<128>, inv &uint<128>) = port;
    let (loader_mask, loader_mask_w): (&uint<16>, inv &uint<16>) = port;
    // The sector writer stages 16 bytes before issuing its first DDR beat.
    // Register ownership during that staging time, cutting final-CRC decode
    // out of the wide data mux/FIFO enables. Keep it through the final beat
    // and one following idle cycle. Raw busy still blocks a new UART load
    // immediately when SD accepts a packet on the same edge as disarm.
    reg(clk) sd_commit_owner reset(rst: false) = *sd_commit_busy;
    let sd_owner = if fast_mode {
        sd_commit_owner
    } else {
        *sd_commit_busy
    };
    // Accepted SD commits retain ownership even if the loader disarms SD.
    // native_stage orders the final buffered write ahead of subsequent reads.
    // Pipeline the whole request/cancellation bundle together. Generation
    // tagging still rejects a stale buffer immediately at the SD frontend.
    reg(clk) backend_inputs: (
        bool, bool, bool,       // armed, initialized, request
        uint<32>, uint<32>,     // LBA, generation
        bool,                  // release
    ) reset(rst: (
        false, false, false,
        0, 0,
        true,
    )) = (
        *card_armed, initialized, *read_request,
        *read_lba, *read_generation,
        *read_release,
    );
    let (backend_arm, backend_initialized, backend_request, backend_lba, backend_epoch, backend_release) = if fast_mode {
        backend_inputs
    } else {
        (
            *card_armed, initialized, *read_request,
            *read_lba, *read_generation,
            *read_release,
        )
    };
    let _ = inst storage::ddr_backend$(
        clk,
        rst,
        armed: backend_arm,
        initialized: backend_initialized,
        resident_bytes: 268_435_456,
        request_valid: backend_request,
        request_lba: backend_lba,
        generation: backend_epoch,
        buffer_release: backend_release,
        sector_ready: read_ready_w,
        sector_generation: buffer_generation_w,
        byte_index: *read_byte_index,
        sector_byte: read_byte_w,
        cmd_valid: read_cmd_valid_w,
        cmd_ready: ddr_cmd_ready && *card_armed && !sd_owner,
        cmd_address: read_cmd_address_w,
        rdata_valid: ddr_rdata_valid,
        rdata_ready: ddr_rdata_ready,
        rdata: ddr_rdata,
    );
    let _ = inst storage::ddr_byte_writer$(
        clk,
        rst,
        enabled: !*card_armed && initialized && !*sd_commit_busy && !sd_owner,
        load_valid: *loader_valid,
        load_address: *loader_address,
        load_byte: *loader_byte,
        load_ready: loader_ready_w,
        cmd_valid: loader_cmd_valid_w,
        cmd_ready: ddr_cmd_ready && !*card_armed && !sd_owner,
        cmd_address: loader_cmd_address_w,
        wdata_valid: loader_data_valid_w,
        wdata_ready: ddr_wdata_ready && !sd_owner,
        wdata: loader_data_w,
        wdata_mask: loader_mask_w,
    );
    set ddr_cmd_valid = &(if sd_owner {
            *sd_write_cmd_valid
        } else if *card_armed {
            *read_cmd_valid
        } else {
            *loader_cmd_valid
        });
    set ddr_cmd_address = &(if sd_owner {
            *sd_write_cmd_address
        } else if *card_armed {
            *read_cmd_address
        } else {
            *loader_cmd_address
        });
    set ddr_cmd_write = &(sd_owner || !*card_armed);
    set ddr_wdata_valid = &(if sd_owner { *sd_write_data_valid } else { *loader_data_valid });
    set ddr_wdata = &(if sd_owner { *sd_write_data } else { *loader_data });
    set ddr_wdata_mask = &(if sd_owner { *sd_write_mask } else { *loader_mask });
    let (_, unused_trace_clock): (&bool, inv &bool) = port;
    let (_, unused_trace_frame): (&bool, inv &bool) = port;
    let (_, unused_trace_valid): (&bool, inv &bool) = port;
    let (_, unused_trace_command): (&uint<6>, inv &uint<6>) = port;
    let (_, unused_trace_argument): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_response): (&bool, inv &bool) = port;
    let (_, unused_trace_response_complete): (&bool, inv &bool) = port;
    let (_, unused_trace_response_payload): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_data_release): (&bool, inv &bool) = port;
    let (_, unused_trace_protocol_status): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_pin_response): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_pin_response_mismatch): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_pin_data): (&uint<32>, inv &uint<32>) = port;
    let (_, unused_trace_pin_data_mismatch): (&uint<32>, inv &uint<32>) = port;
    let _ = inst sd_frontend$(

        // Clock and card control
        clk,
        rst,
        armed: *card_armed && initialized,

        // SD pins
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,

        // Read-buffer exchange
        request_valid: read_request_w,
        request_lba: read_lba_w,
        generation: read_generation_w,
        sector_ready: *read_ready,
        sector_generation: *buffer_generation,
        sector_byte: *read_byte,
        byte_index: read_byte_index_w,
        sector_release: read_release_w,

        // Mode and write-side inputs
        fast_mode,
        h700_mode: false,
        h700_falling_phase: false,
        h700_early_command: false,
        sd_csd: 0x0026001a115903ffc002800002400023,
        mmc_only: false,
        writable,
        dat_in,

        // DDR write command
        write_cmd_valid: sd_write_cmd_valid_w,
        write_cmd_ready: ddr_cmd_ready && sd_owner,
        write_cmd_address: sd_write_cmd_address_w,

        // DDR write data
        write_data_valid: sd_write_data_valid_w,
        write_data_ready: ddr_wdata_ready && sd_owner,
        write_data: sd_write_data_w,
        write_mask: sd_write_mask_w,
        write_busy: sd_commit_busy_w,
        trace_clock_tick: unused_trace_clock,
        trace_frame: unused_trace_frame,
        trace_valid: unused_trace_valid,
        trace_command: unused_trace_command,
        trace_argument: unused_trace_argument,
        trace_response: unused_trace_response,
        trace_response_complete: unused_trace_response_complete,
        trace_response_payload: unused_trace_response_payload,
        trace_data_release: unused_trace_data_release,
        trace_protocol_status: unused_trace_protocol_status,
        trace_pin_response: unused_trace_pin_response,
        trace_pin_response_mismatch: unused_trace_pin_response_mismatch,
        trace_pin_data: unused_trace_pin_data,
        trace_pin_data_mismatch: unused_trace_pin_data_mismatch,
    );
    set armed_status = &(*card_armed && initialized);
}

// UART divisors track the selected DDR system clock.
entity ddr_uart_core<#uint CLK_FREQ>(
    clk: clock,
    rst: bool,
    initialized: bool,
    diagnostic_status: uint<27>,
    status_selector: inv &uint<7>,
    fast_mode: bool,
    writable: bool,
    dat_in: uint<4>,
    usb_rx: bool,
    usb_tx: inv &bool,
    ddr_cmd_valid: inv &bool,
    ddr_cmd_ready: bool,
    ddr_cmd_address: inv &uint<24>,
    ddr_cmd_write: inv &bool,
    ddr_rdata_valid: bool,
    ddr_rdata_ready: inv &bool,
    ddr_rdata: uint<128>,
    ddr_wdata_valid: inv &bool,
    ddr_wdata_ready: bool,
    ddr_wdata: inv &uint<128>,
    ddr_wdata_mask: inv &uint<16>,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    let rx_cycles: uint<32> = CLK_FREQ `std::ops::comb_div` 1_000_000;
    let rx = inst shared_components::serial::uart_rx::<8>$(
        clk,
        rst,
        rx: usb_rx,
        bit_time: trunc(rx_cycles),
        parity: false,
        stop_bits: 1,
    );
    let (valid, valid_w): (&bool, inv &bool) = port;
    let (byte, byte_w): (&uint<8>, inv &uint<8>) = port;
    let (busy, busy_w): (&bool, inv &bool) = port;
    reg(clk) issued reset(rst: false) = *valid && !*busy && !issued;
    let send = *valid && !*busy && !issued;
    let _ = inst ddr_emulator$(

        // Clock and card control
        clk,
        rst,
        initialized,
        diagnostic_status,
        status_selector,
        fast_mode,
        writable,
        dat_in,

        // DDR command channel
        ddr_cmd_valid,
        ddr_cmd_ready,
        ddr_cmd_address,
        ddr_cmd_write,

        // DDR read channel
        ddr_rdata_valid,
        ddr_rdata_ready,
        ddr_rdata,

        // DDR write channel
        ddr_wdata_valid,
        ddr_wdata_ready,
        ddr_wdata,
        ddr_wdata_mask,

        // UART loader
        rx_valid: rx.valid && !rx.parity_error,
        rx_byte: rx.byte,
        tx_ready: send,
        tx_valid: valid_w,
        tx_byte: byte_w,

        // SD pins
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,
        armed_status,
    );
    let tx = inst shared_components::serial::uart_tx::<CLK_FREQ, 1_000_000, 8>$(
        clk,
        rst,
        block: false,
        data: *byte,
        new_data: send,
    );
    set busy_w = &tx.busy;
    set usb_tx = &tx.tx;
}

