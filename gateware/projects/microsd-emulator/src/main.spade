#[no_mangle(all)]
entity ddr_emulator_cdc(
    memory_clk: clock,
    memory_rst: bool,
    clk: clock,
    rst: bool,
    initialized: bool,
    diagnostic_status: uint<27>,
    status_selector: inv &uint<7>,
    fast_mode: bool,
    writable: bool,
    dat_in: uint<4>,
    ddr_cmd_valid: inv &bool,
    ddr_cmd_ready: bool,
    ddr_cmd_address: inv &uint<24>,
    ddr_cmd_write: inv &bool,
    ddr_rdata_valid: bool,
    ddr_rdata_ready: inv &bool,
    ddr_rdata: uint<128>,
    ddr_wdata_valid: inv &bool,
    ddr_wdata_ready: bool,
    ddr_wdata: inv &uint<128>,
    ddr_wdata_mask: inv &uint<16>,
    rx_valid: bool,
    rx_byte: uint<8>,
    tx_ready: bool,
    tx_valid: inv &bool,
    tx_byte: inv &uint<8>,
    sd_clk: bool,
    cmd_in: bool,
    cmd_out: inv &bool,
    cmd_oe: inv &bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    armed_status: inv &bool,
) {
    // Exercise the separately clocked frontend / 80 MHz native-memory boundary.
    let (frontend_cmd_valid, frontend_cmd_valid_w): (&bool, inv &bool) = port;
    let (frontend_cmd_ready, frontend_cmd_ready_w): (&bool, inv &bool) = port;
    let (frontend_cmd_address, frontend_cmd_address_w): (&uint<24>, inv &uint<24>) = port;
    let (frontend_cmd_write, frontend_cmd_write_w): (&bool, inv &bool) = port;
    let (frontend_data_valid, frontend_data_valid_w): (&bool, inv &bool) = port;
    let (frontend_data_ready, frontend_data_ready_w): (&bool, inv &bool) = port;
    let (frontend_write_data, frontend_write_data_w): (&uint<128>, inv &uint<128>) = port;
    let (frontend_write_mask, frontend_write_mask_w): (&uint<16>, inv &uint<16>) = port;
    let (frontend_read_valid, frontend_read_valid_w): (&bool, inv &bool) = port;
    let (frontend_read_ready, frontend_read_ready_w): (&bool, inv &bool) = port;
    let (frontend_read_data, frontend_read_data_w): (&uint<128>, inv &uint<128>) = port;
    let (memory_cmd_valid, memory_cmd_valid_w): (&bool, inv &bool) = port;
    let (memory_cmd_ready, memory_cmd_ready_w): (&bool, inv &bool) = port;
    let (memory_cmd_address, memory_cmd_address_w): (&uint<24>, inv &uint<24>) = port;
    let (memory_cmd_write, memory_cmd_write_w): (&bool, inv &bool) = port;
    let (memory_data_valid, memory_data_valid_w): (&bool, inv &bool) = port;
    let (memory_data_ready, memory_data_ready_w): (&bool, inv &bool) = port;
    let (memory_write_data, memory_write_data_w): (&uint<128>, inv &uint<128>) = port;
    let (memory_write_mask, memory_write_mask_w): (&uint<16>, inv &uint<16>) = port;
    let (memory_read_valid, memory_read_valid_w): (&bool, inv &bool) = port;
    let (memory_read_ready, memory_read_ready_w): (&bool, inv &bool) = port;
    let (memory_read_data, memory_read_data_w): (&uint<128>, inv &uint<128>) = port;
    let _ = inst ddr_emulator$(

        // Clock and card control
        clk,
        rst,
        initialized,
        diagnostic_status,
        status_selector,
        fast_mode,
        writable,
        dat_in,

        // DDR command channel
        ddr_cmd_valid: frontend_cmd_valid_w,
        ddr_cmd_ready: *frontend_cmd_ready,
        ddr_cmd_address: frontend_cmd_address_w,
        ddr_cmd_write: frontend_cmd_write_w,

        // DDR read channel
        ddr_rdata_valid: *frontend_read_valid,
        ddr_rdata_ready: frontend_read_ready_w,
        ddr_rdata: *frontend_read_data,

        // DDR write channel
        ddr_wdata_valid: frontend_data_valid_w,
        ddr_wdata_ready: *frontend_data_ready,
        ddr_wdata: frontend_write_data_w,
        ddr_wdata_mask: frontend_write_mask_w,

        // UART loader
        rx_valid,
        rx_byte,
        tx_ready,
        tx_valid,
        tx_byte,

        // SD pins
        sd_clk,
        cmd_in,
        cmd_out,
        cmd_oe,
        dat_out,
        dat_oe,
        armed_status,
    );
    let _ = inst cdc::native_cdc$(

        // Clock domains and shared reset
        s_clk: clk,
        s_rst: rst,
        m_clk: memory_clk,
        m_rst: memory_rst,

        // Command channel
        s_cmd_valid: *frontend_cmd_valid,
        s_cmd_ready: frontend_cmd_ready_w,
        s_cmd_address: *frontend_cmd_address,
        s_cmd_write: *frontend_cmd_write,
        m_cmd_valid: memory_cmd_valid_w,
        m_cmd_ready: *memory_cmd_ready,
        m_cmd_address: memory_cmd_address_w,
        m_cmd_write: memory_cmd_write_w,

        // Write-data channel
        s_wdata_valid: *frontend_data_valid,
        s_wdata_ready: frontend_data_ready_w,
        s_wdata: *frontend_write_data,
        s_wmask: *frontend_write_mask,
        m_wdata_valid: memory_data_valid_w,
        m_wdata_ready: *memory_data_ready,
        m_wdata: memory_write_data_w,
        m_wmask: memory_write_mask_w,

        // Read-data channel
        m_rdata_valid: *memory_read_valid,
        m_rdata_ready: memory_read_ready_w,
        m_rdata: *memory_read_data,
        s_rdata_valid: frontend_read_valid_w,
        s_rdata_ready: *frontend_read_ready,
        s_rdata: frontend_read_data_w,
    );
    let _ = inst cdc::native_stage$(
        clk: memory_clk,
        rst: memory_rst,
        s_cmd_valid: *memory_cmd_valid,
        s_cmd_ready: memory_cmd_ready_w,
        s_cmd_address: *memory_cmd_address,
        s_cmd_write: *memory_cmd_write,
        s_wdata_valid: *memory_data_valid,
        s_wdata_ready: memory_data_ready_w,
        s_wdata: *memory_write_data,
        s_wmask: *memory_write_mask,
        s_rdata_valid: memory_read_valid_w,
        s_rdata_ready: *memory_read_ready,
        s_rdata: memory_read_data_w,
        m_cmd_valid: ddr_cmd_valid,
        m_cmd_ready: ddr_cmd_ready,
        m_cmd_address: ddr_cmd_address,
        m_cmd_write: ddr_cmd_write,
        m_wdata_valid: ddr_wdata_valid,
        m_wdata_ready: ddr_wdata_ready,
        m_wdata: ddr_wdata,
        m_wmask: ddr_wdata_mask,
        m_rdata_valid: ddr_rdata_valid,
        m_rdata_ready: ddr_rdata_ready,
        m_rdata: ddr_rdata,
    );
}
