) {
    let _ = inst ddr_uart_core::<83_333_333>$(
        clk,
        rst,
        initialized,
        diagnostic_status,
        status_selector,
        fast_mode: false,
        writable,
        dat_in,
        usb_rx,
        usb_tx,
        ddr_cmd_valid,
        ddr_cmd_ready,
        ddr_cmd_address,
        ddr_cmd_write,
        ddr_rdata_valid,
        ddr_rdata_ready,
        ddr_rdata,
        ddr_wdata_valid,
        ddr_wdata_ready,
