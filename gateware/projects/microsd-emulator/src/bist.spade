// Destructive native-port qualification of a bounded volatile DDR region.
// Two pattern write/read passes are followed by a verified zero-fill pass.
// Failure is sticky until global reset; never hand the port to SD after failure.
pub fn pattern(address: uint<24>, inverted: bool) -> uint<128> {
    let a: uint<128> = zext(address);
    let value = (a | (a << 32) | (a << 64) | (a << 96))
        ^ 0x0123456789abcdef55aa33ccf00f9696;
    value ^ if inverted { 0xffffffffffffffffffffffffffffffff } else { 0 }
}

// Exclusive native-port ownership until both BIST passes finish. A failure
// never grants the client access; recovery requires the shared global reset.
#[no_mangle(all)]
pub entity qualified_ddr(
    clk: clock, rst: bool, start: bool, word_count: uint<25>, timeout_cycles: uint<20>,
    cmd_valid: inv &bool, cmd_ready: bool, cmd_address: inv &uint<24>, cmd_write: inv &bool,
    wdata_valid: inv &bool, wdata_ready: bool, wdata: inv &uint<128>, wdata_mask: inv &uint<16>,
    rdata_valid: bool, rdata_ready: inv &bool, rdata: uint<128>,
    client_cmd_valid: bool, client_cmd_ready: inv &bool, client_cmd_address: uint<24>, client_cmd_write: bool,
    client_wdata_valid: bool, client_wdata_ready: inv &bool, client_wdata: uint<128>, client_wdata_mask: uint<16>,
    client_rdata_valid: inv &bool, client_rdata_ready: bool, client_rdata: inv &uint<128>,
    busy: inv &bool, passed: inv &bool, failed: inv &bool, progress: inv &uint<24>, diagnostic: inv &uint<5>,
    expected_word: inv &uint<128>, actual_word: inv &uint<128>,
) {
    let (ok, ok_w): (&bool, inv &bool) = port;
    let (cv, cv_w): (&bool, inv &bool) = port;
    let (ca, ca_w): (&uint<24>, inv &uint<24>) = port;
    let (cw, cw_w): (&bool, inv &bool) = port;
    let (wv, wv_w): (&bool, inv &bool) = port;
    let (wd, wd_w): (&uint<128>, inv &uint<128>) = port;
    let (wm, wm_w): (&uint<16>, inv &uint<16>) = port;
    let (rr, rr_w): (&bool, inv &bool) = port;
    let _ = inst native_bist(clk,rst,start,word_count,timeout_cycles,
        cv_w,cmd_ready && !*ok,ca_w,cw_w,wv_w,wdata_ready && !*ok,wd_w,wm_w,
        rdata_valid && !*ok,rr_w,rdata,busy,ok_w,failed,progress,diagnostic,expected_word,actual_word);
    // Register ownership separately from reset and the BIST state decoder.
    // This also inserts an idle cycle between the final response and handover.
    reg(clk) qualified reset(rst: false) = *ok;
    set passed = &qualified;
    set cmd_valid = &(!rst && if qualified { client_cmd_valid } else { *cv });
    set cmd_address = &(if qualified { client_cmd_address } else { *ca });
    set cmd_write = &(if qualified { client_cmd_write } else { *cw });
    set wdata_valid = &(!rst && if qualified { client_wdata_valid } else { *wv });
    set wdata = &(if qualified { client_wdata } else { *wd });
    set wdata_mask = &(if qualified { client_wdata_mask } else { *wm });
    set rdata_ready = &(!rst && if qualified { client_rdata_ready } else { *rr });
    set client_cmd_ready = &(qualified && !rst && cmd_ready);
    set client_wdata_ready = &(qualified && !rst && wdata_ready);
    set client_rdata_valid = &(qualified && !rst && rdata_valid);
    set client_rdata = &rdata;
}

#[no_mangle(all)]
pub entity native_bist(
    clk: clock, rst: bool, start: bool, word_count: uint<25>, timeout_cycles: uint<20>,
    cmd_valid: inv &bool, cmd_ready: bool, cmd_address: inv &uint<24>, cmd_write: inv &bool,
    wdata_valid: inv &bool, wdata_ready: bool, wdata: inv &uint<128>, wdata_mask: inv &uint<16>,
    rdata_valid: bool, rdata_ready: inv &bool, rdata: uint<128>,
    busy: inv &bool, passed: inv &bool, failed: inv &bool, progress: inv &uint<24>, diagnostic: inv &uint<5>,
    expected_word: inv &uint<128>, actual_word: inv &uint<128>,
) {
    decl state, address, count, timeout, elapsed, command_sent, data_sent, inverted, zero_pass;
    let begin = state == 0 && start;
    let waiting = state == 1 || state == 2 || state == 3;
    let active = waiting || state == 6;
    let command_fire = (state == 1 && !command_sent || state == 2) && cmd_ready;
    let data_fire = state == 1 && !data_sent && wdata_ready;
    let write_complete = state == 1 && (command_sent || command_fire) && (data_sent || data_fire);
    let receive = state == 3 && rdata_valid;
    reg(clk) received_word: uint<128> = if receive { rdata } else { received_word };
    let read_complete = state == 6;
    let expected: uint<128> = if zero_pass { 0 } else { pattern(address, inverted) };
    let mismatch = read_complete && received_word != expected;
    let last = zext::<24, 25>(address) +. 1 == count;
    let expired = waiting && elapsed == timeout;
    let invalid = begin && (word_count == 0 || word_count > 16777216 || timeout_cycles == 0);
    let pass_offset: uint<5> = if inverted { 4 } else { 0 };
    let phase: uint<5> = if zero_pass { 4 } else { pass_offset | (if state == 1 { 1 } else if state == 2 { 2 } else if state == 3 || state == 6 { 3 } else { 0 }) };
    reg(clk) failure_diagnostic: uint<5> reset(rst: 0) =
        if expired { 16 | phase } else if mismatch { 8 | phase }
        else if invalid { 24 } else { failure_diagnostic };

    reg(clk) count: uint<25> reset(rst: 0) = if begin { word_count } else { count };
    reg(clk) timeout: uint<20> reset(rst: 0) = if begin { timeout_cycles } else { timeout };
    reg(clk) elapsed: uint<20> reset(rst: 0) = if !waiting || command_fire || data_fire || receive { 0 } else { elapsed +. 1 };
    reg(clk) command_sent reset(rst: false) = if state != 1 || write_complete { false } else { command_sent || command_fire };
    reg(clk) data_sent reset(rst: false) = if state != 1 || write_complete { false } else { data_sent || data_fire };
    reg(clk) inverted reset(rst: false) = if read_complete && last && !mismatch { true } else { inverted };
    reg(clk) zero_pass reset(rst: false) = if read_complete && last && !mismatch && inverted { true } else { zero_pass };
    reg(clk) address: uint<24> reset(rst: 0) = if begin { 0 }
        else if (write_complete || read_complete && !mismatch) && !expired { if last { 0 } else { address +. 1 } }
        else { address };
    reg(clk) state: uint<3> reset(rst: 0) = if expired || mismatch { 5 }
        else if begin { if word_count == 0 || word_count > 16777216 || timeout_cycles == 0 { 5 } else { 1 } }
        else if state == 1 && write_complete && last { 2 }
        else if state == 2 && command_fire { 3 }
        else if receive { 6 }
        else if read_complete { if last { if zero_pass { 4 } else { 1 } } else { 2 } }
        else { state };

    set cmd_valid = &(!rst && (state == 1 && !command_sent || state == 2));
    set cmd_address = &(address);
    set cmd_write = &(state == 1);
    set wdata_valid = &(!rst && state == 1 && !data_sent);
    set wdata = &expected;
    set wdata_mask = &(0xffff);
    set rdata_ready = &(!rst && state == 3);
    set busy = &(active);
    set passed = &(state == 4);
    set failed = &(state == 5);
    set progress = &(address);
    set diagnostic = &(if state == 5 { failure_diagnostic } else { phase });
    set expected_word = &expected;
    set actual_word = &received_word;
}
