// Destructive native-port qualification of a bounded volatile DDR region.
// Two pattern write/read passes are followed by a verified zero-fill pass.
// Failure is sticky until global reset; never hand the port to SD after failure.
pub fn pattern(address: uint<24>, inverted: bool) -> uint<128> {
    let a: uint<128> = zext(address);
    let value = (a | (a << 32) | (a << 64) | (a << 96))
    ^ 0x0123456789abcdef55aa33ccf00f9696;
    value ^ if inverted {
        0xffffffffffffffffffffffffffffffff
    } else {
        0
    }
}

// Exclusive native-port ownership until both BIST passes finish. A failure
// never grants the client access; recovery requires the shared global reset.
#[no_mangle(all)]
pub entity qualified_ddr(
    clk: clock,
    rst: bool,
    start: bool,
    word_count: uint<25>,
    timeout_cycles: uint<20>,
    cmd_valid: inv &bool,
    cmd_ready: bool,
    cmd_address: inv &uint<24>,
    cmd_write: inv &bool,
    wdata_valid: inv &bool,
    wdata_ready: bool,
    wdata: inv &uint<128>,
    wdata_mask: inv &uint<16>,
    rdata_valid: bool,
    rdata_ready: inv &bool,
    rdata: uint<128>,
    client_cmd_valid: bool,
    client_cmd_ready: inv &bool,
    client_cmd_address: uint<24>,
    client_cmd_write: bool,
    client_wdata_valid: bool,
    client_wdata_ready: inv &bool,
    client_wdata: uint<128>,
    client_wdata_mask: uint<16>,
    client_rdata_valid: inv &bool,
    client_rdata_ready: bool,
    client_rdata: inv &uint<128>,
    busy: inv &bool,
    passed: inv &bool,
    failed: inv &bool,
    progress: inv &uint<24>,
    diagnostic: inv &uint<5>,
    expected_word: inv &uint<128>,
    actual_word: inv &uint<128>,
) {
    let (ok, ok_w): (&bool, inv &bool) = port;
    let (cv, cv_w): (&bool, inv &bool) = port;
    let (ca, ca_w): (&uint<24>, inv &uint<24>) = port;
    let (cw, cw_w): (&bool, inv &bool) = port;
    let (wv, wv_w): (&bool, inv &bool) = port;
    let (wd, wd_w): (&uint<128>, inv &uint<128>) = port;
    let (wm, wm_w): (&uint<16>, inv &uint<16>) = port;
    let (rr, rr_w): (&bool, inv &bool) = port;
    let _ = inst native_bist$(
        clk,
        rst,
        start,
        word_count,
        timeout_cycles,
        cmd_valid: cv_w,
        cmd_ready: cmd_ready && !*ok,
        cmd_address: ca_w,
        cmd_write: cw_w,
        wdata_valid: wv_w,
        wdata_ready: wdata_ready && !*ok,
        wdata: wd_w,
        wdata_mask: wm_w,
        rdata_valid: rdata_valid && !*ok,
        rdata_ready: rr_w,
        rdata,
        busy,
        passed: ok_w,
        failed,
        progress,
        diagnostic,
        expected_word,
        actual_word,
    );
    // Register ownership separately from reset and the BIST state decoder.
    // This also inserts an idle cycle between the final response and handover.
    reg(clk) qualified reset(rst: false) = *ok;
    set passed = &qualified;
    set cmd_valid = &(!rst && if qualified {
            client_cmd_valid
        } else {
            *cv
        });
    set cmd_address = &(if qualified { client_cmd_address } else { *ca });
    set cmd_write = &(if qualified { client_cmd_write } else { *cw });
    set wdata_valid = &(!rst && if qualified {
            client_wdata_valid
        } else {
            *wv
        });
    set wdata = &(if qualified { client_wdata } else { *wd });
    set wdata_mask = &(if qualified { client_wdata_mask } else { *wm });
    set rdata_ready = &(!rst && if qualified {
            client_rdata_ready
        } else {
            *rr
        });
    set client_cmd_ready = &(qualified && !rst && cmd_ready);
    set client_wdata_ready = &(qualified && !rst && wdata_ready);
    set client_rdata_valid = &(qualified && !rst && rdata_valid);
    set client_rdata = &rdata;
}

#[no_mangle(all)]
pub entity native_bist(
    clk: clock,
    rst: bool,
    start: bool,
    word_count: uint<25>,
    timeout_cycles: uint<20>,
    cmd_valid: inv &bool,
    cmd_ready: bool,
    cmd_address: inv &uint<24>,
    cmd_write: inv &bool,
    wdata_valid: inv &bool,
    wdata_ready: bool,
    wdata: inv &uint<128>,
    wdata_mask: inv &uint<16>,
    rdata_valid: bool,
    rdata_ready: inv &bool,
    rdata: uint<128>,
    busy: inv &bool,
    passed: inv &bool,
    failed: inv &bool,
    progress: inv &uint<24>,
    diagnostic: inv &uint<5>,
    expected_word: inv &uint<128>,
    actual_word: inv &uint<128>,
) {
    let IDLE: uint<3> = 0;
    let WRITE_PATTERN: uint<3> = 1;
    let ISSUE_READ: uint<3> = 2;
    let WAIT_READ_DATA: uint<3> = 3;
    let TEST_PASSED: uint<3> = 4;
    let TEST_FAILED: uint<3> = 5;
    let CHECK_READ_DATA: uint<3> = 6;

    decl state, address, count, timeout, elapsed, command_sent, data_sent, inverted, zero_pass;
    let begin = state == IDLE && start;
    let waiting = state == WRITE_PATTERN || state == ISSUE_READ || state == WAIT_READ_DATA;
    let active = waiting || state == CHECK_READ_DATA;
    let command_fire = (state == WRITE_PATTERN && !command_sent || state == ISSUE_READ) && cmd_ready;
    let data_fire = state == WRITE_PATTERN && !data_sent && wdata_ready;
    let write_complete = state == WRITE_PATTERN && (command_sent || command_fire) && (data_sent || data_fire);
    let receive = state == WAIT_READ_DATA && rdata_valid;
    reg(clk) received_word: uint<128> = if receive {
        rdata
    } else {
        received_word
    };
    let read_complete = state == CHECK_READ_DATA;
    let expected: uint<128> = if zero_pass {
        0
    } else {
        pattern(address, inverted)
    };
    let mismatch = read_complete && received_word != expected;
    let last = zext::<24, 25>(address) +. 1 == count;
    let expired = waiting && elapsed == timeout;
    let invalid = begin && (word_count == 0 || word_count > 16777216 || timeout_cycles == 0);
    let pass_offset: uint<5> = if inverted {
        4
    } else {
        0
    };
    let phase: uint<5> = if zero_pass {
        4
    } else {
        pass_offset | (if state == WRITE_PATTERN {
                1
            } else if state == ISSUE_READ {
                2
            } else if state == WAIT_READ_DATA || state == CHECK_READ_DATA {
                3
            } else {
                0
            })
    };
    reg(clk) failure_diagnostic: uint<5> reset(rst: 0) = if expired {
        16 | phase
    } else if mismatch {
        8 | phase
    } else if invalid {
        24
    } else {
        failure_diagnostic
    };

    reg(clk) count: uint<25> reset(rst: 0) = if begin {
        word_count
    } else {
        count
    };
    reg(clk) timeout: uint<20> reset(rst: 0) = if begin {
        timeout_cycles
    } else {
        timeout
    };
    reg(clk) elapsed: uint<20> reset(rst: 0) = if !waiting || command_fire || data_fire || receive {
        0
    } else {
        elapsed +. 1
    };
    reg(clk) command_sent reset(rst: false) = if state != WRITE_PATTERN || write_complete {
        false
    } else {
        command_sent || command_fire
    };
    reg(clk) data_sent reset(rst: false) = if state != WRITE_PATTERN || write_complete {
        false
    } else {
        data_sent || data_fire
    };
    reg(clk) inverted reset(rst: false) = if read_complete && last && !mismatch {
        true
    } else {
        inverted
    };
    reg(clk) zero_pass reset(rst: false) = if read_complete && last && !mismatch && inverted {
        true
    } else {
        zero_pass
    };
    reg(clk) address: uint<24> reset(rst: 0) = if begin {
        0
    } else if (write_complete || read_complete && !mismatch) && !expired {
        if last {
            0
        } else {
            address +. 1
        }
    } else {
        address
    };
    reg(clk) state: uint<3> reset(rst: IDLE) = if expired || mismatch {
        TEST_FAILED
    } else if begin {
        if word_count == 0 || word_count > 16777216 || timeout_cycles == 0 {
            TEST_FAILED
        } else {
            WRITE_PATTERN
        }
    } else if state == WRITE_PATTERN && write_complete && last {
        ISSUE_READ
    } else if state == ISSUE_READ && command_fire {
        WAIT_READ_DATA
    } else if receive {
        CHECK_READ_DATA
    } else if read_complete {
        if last {
            if zero_pass {
                TEST_PASSED
            } else {
                WRITE_PATTERN
            }
        } else {
            ISSUE_READ
        }
    } else {
        state
    };

    set cmd_valid = &(!rst && (state == WRITE_PATTERN && !command_sent || state == ISSUE_READ));
    set cmd_address = &(address);
    set cmd_write = &(state == WRITE_PATTERN);
    set wdata_valid = &(!rst && state == WRITE_PATTERN && !data_sent);
    set wdata = &expected;
    set wdata_mask = &(0xffff);
    set rdata_ready = &(!rst && state == WAIT_READ_DATA);
    set busy = &(active);
    set passed = &(state == TEST_PASSED);
    set failed = &(state == TEST_FAILED);
    set progress = &(address);
    set diagnostic = &(if state == TEST_FAILED { failure_diagnostic } else { phase });
    set expected_word = &expected;
    set actual_word = &received_word;
}
