// Native SD CRC status and programming busy, driven on DAT0 only.
// A caller starts this after receiving the sector end bit. Memory must not be
// changed for a rejected sector; busy reflects an accepted commit in progress.
#[no_mangle(all)]
pub entity sd_write_response(
    clk: clock,
    rst: bool,
    prepared_mode: bool,
    cancel: bool,
    start: bool,
    accepted: bool,
    fall: bool,
    busy: bool,
    dat_out: inv &uint<4>,
    dat_oe: inv &uint<4>,
    active: inv &bool,
    complete: inv &bool,
) {
    let IDLE: uint<4> = 0;
    let RESPONSE_DELAY: uint<4> = 1;
    let TOKEN_START: uint<4> = 2;
    let PROGRAMMING_BUSY: uint<4> = 8;
    let RESPONSE_COMPLETE: uint<4> = 9;

    decl state, prepared_output, delayed_prepared_output;
    let clear = rst || cancel;
    reg(clk) ok reset(clear: false) = if start && state == IDLE {
        accepted
    } else {
        ok
    };
    let hold_busy = ok && (if prepared_mode { !delayed_prepared_output } else { busy });
    let token_drive = state >= TOKEN_START && state <= PROGRAMMING_BUSY;
    reg(clk) state: uint<4> reset(clear: IDLE) = if start && state == IDLE {
        RESPONSE_DELAY
    } else if fall && state != IDLE {
        if state == PROGRAMMING_BUSY {
            if hold_busy {
                PROGRAMMING_BUSY
            } else {
                RESPONSE_COMPLETE
            }
        } else if state == RESPONSE_COMPLETE {
            IDLE
        } else {
            state +. 1
        }
    } else {
        state
    };
    // DAT0 sends start=0, status=010 (accepted) or 101 (CRC rejected),
    // end=1, then a low programming-busy bit before polling commit completion.
    let next_output = match state {
        2 => false, // start bit
        3 => !ok, // status bit 2
        4 => ok, // status bit 1
        5 => !ok, // status bit 0
        6 => true, // end bit
        7 => false, // enter busy
        8 => !(busy && ok), // hold busy until commit completes
        _ => true,
    };
    reg(clk) output reset(clear: true) = if fall {
        next_output
    } else {
        output
    };
    // The fast frontend launches these prepared values at its pad registers.
    reg(clk) prepared_output reset(clear: true) = next_output;
    // Mirror the caller's full-cycle preparation stage: retire busy only
    // after the pad has actually launched a high bit, not on an earlier
    // asynchronous change of the DDR commit-busy input.
    reg(clk) delayed_prepared_output reset(clear: true) = prepared_output;
    reg(clk) prepared_drive reset(clear: false) = token_drive;
    reg(clk) drive reset(clear: false) = if fall {
        token_drive
    } else {
        drive
    };
    reg(clk) finished reset(clear: false) = fall && state == RESPONSE_COMPLETE;
    let response_bit = if prepared_mode { prepared_output } else { output };
    let response_drive = if prepared_mode { prepared_drive } else { drive };
    set dat_out = &(if response_bit { 15 } else { 14 });
    set dat_oe = &(if response_drive && !clear { 1 } else { 0 });
    set active = &(state != IDLE && !clear);
    set complete = &finished;
}
