use shared_components::monitoring::{
    StableSampleState,
    async_uart_monitor,
    stable_sample_reset,
    stable_sample_step,
};

use super::protocol::{
    MiscWord,
    OrganizerAddr,
    OrganizerData,
    OrganizerOverflowCount,
    OrganizerSample,
    OrganizerSampleReq,
    OrganizerTraceEventReq,
    SampleCount,
    organizer_addr_sample,
    organizer_data_sample,
    organizer_misc_sample,
    organizer_sample_none,
    organizer_trace_event_none,
    organizer_trace_event_overflow,
    organizer_trace_event_sample,
    sample_addr_value,
    sample_data_value,
    sample_misc_value,
};

type AddrSampleState = StableSampleState<20, 8>;
type DataSampleState = StableSampleState<8, 8>;
type MiscSampleState = StableSampleState<11, 8>;

/// Up to three samples can be taken in one cycle -- address, data and misc --
/// while the stream drains at most one per cycle, so the monitor holds a
/// three-deep queue of them.
type OrganizerQueuedSamples = [Option<OrganizerSample>; 3];

struct QueuePushOut {
    queue: OrganizerQueuedSamples,
    dropped: OrganizerOverflowCount,
}

pub(lib) struct OrganizerMonitorState {
    addr: AddrSampleState,
    data: DataSampleState,
    misc: MiscSampleState,
    queued: OrganizerQueuedSamples,
    overflow_count: OrganizerOverflowCount,
}

pub(lib) struct OrganizerMonitorSamples {
    addr: OrganizerSampleReq,
    data: OrganizerSampleReq,
    misc: OrganizerSampleReq,
}

pub(lib) struct OrganizerMonitorOut {
    next_state: OrganizerMonitorState,
    samples: OrganizerMonitorSamples,
}

pub(lib) struct OrganizerMonitorTransportOut {
    next_state: OrganizerMonitorState,
    stream_event: OrganizerTraceEventReq,
}

pub(lib) struct OrganizerMonitorLines {
    addr: bool,
    data: bool,
    misc: bool,
}

pub(lib) fn default_stable_threshold() -> SampleCount {
    5
}

entity organizer_monitor_uart<#uint WIDTH>(
    clk: clock,
    rst: bool,
    sample: uint<WIDTH>,
    sample_valid: bool,
    clk_uart: clock,
) -> bool {
    let uart = inst async_uart_monitor::<WIDTH, 4, 3, 100_000_000, 100_000_000>(
        clk,
        rst,
        sample,
        sample_valid,
        clk_uart,
        rst,
    );
    uart.line
}

impl Default for OrganizerMonitorState {
    fn default() -> Self {
        OrganizerMonitorState$(
            addr: stable_sample_reset::<20, 8>(0),
            data: stable_sample_reset::<8, 8>(0),
            misc: stable_sample_reset::<11, 8>(0),
            queued: OrganizerQueuedSamples::default(),
            overflow_count: 0,
        )
    }
}

fn queue_push(queue: OrganizerQueuedSamples, sample_valid: bool, sample: OrganizerSample) -> QueuePushOut {
    let entry = Some(sample);
    if !sample_valid {
        QueuePushOut$(queue: queue, dropped: 0)
    } else if queue[0].is_none() {
        QueuePushOut$(queue: [entry, queue[1], queue[2]], dropped: 0)
    } else if queue[1].is_none() {
        QueuePushOut$(queue: [queue[0], entry, queue[2]], dropped: 0)
    } else if queue[2].is_none() {
        QueuePushOut$(queue: [queue[0], queue[1], entry], dropped: 0)
    } else {
        QueuePushOut$(queue: queue, dropped: 1)
    }
}

fn live_samples(
    addr_sync: OrganizerAddr,
    data_sync: OrganizerData,
    misc_sync: MiscWord,
    addr_wput: bool,
    data_wput: bool,
    misc_wput: bool,
) -> OrganizerMonitorSamples {
    OrganizerMonitorSamples$(
        addr: if addr_wput {
            organizer_addr_sample(addr_sync)
        } else {
            organizer_sample_none()
        },
        data: if data_wput {
            organizer_data_sample(data_sync)
        } else {
            organizer_sample_none()
        },
        misc: if misc_wput {
            organizer_misc_sample(misc_sync)
        } else {
            organizer_sample_none()
        },
    )
}

impl OrganizerMonitorState {
    pub fn eval(
        self,
        addr_sync: OrganizerAddr,
        data_sync: OrganizerData,
        misc_sync: MiscWord,
        addr_stable_threshold: SampleCount,
        data_stable_threshold: SampleCount,
        stream_capture_enable: bool,
    ) -> OrganizerMonitorOut {
        let addr_step = stable_sample_step(self.addr, addr_sync, addr_stable_threshold);
        let data_step = stable_sample_step(self.data, data_sync, data_stable_threshold);
        let misc_step = stable_sample_step(self.misc, misc_sync, default_stable_threshold());
        let samples = live_samples(
            addr_sync,
            data_sync,
            misc_sync,
            addr_step.wput,
            data_step.wput,
            misc_step.wput,
        );

        if !stream_capture_enable {
            OrganizerMonitorOut$(
                next_state: OrganizerMonitorState$(
                    addr: addr_step.next_state,
                    data: data_step.next_state,
                    misc: misc_step.next_state,
                    queued: OrganizerQueuedSamples::default(),
                    overflow_count: 0,
                ),
                samples: samples,
            )
        } else {
            let pushed_addr = queue_push(self.queued, samples.addr.valid, samples.addr.sample);
            let pushed_data = queue_push(pushed_addr.queue, samples.data.valid, samples.data.sample);
            let pushed_misc = queue_push(pushed_data.queue, samples.misc.valid, samples.misc.sample);
            OrganizerMonitorOut$(
                next_state: OrganizerMonitorState$(
                    addr: addr_step.next_state,
                    data: data_step.next_state,
                    misc: misc_step.next_state,
                    queued: pushed_misc.queue,
                    overflow_count: self.overflow_count +. pushed_addr.dropped +. pushed_data.dropped +. pushed_misc.dropped,
                ),
                samples: samples,
            )
        }
    }

    pub fn drain_stream(self, stream_ready: bool) -> OrganizerMonitorTransportOut {
        if !stream_ready {
            OrganizerMonitorTransportOut$(
                next_state: self,
                stream_event: organizer_trace_event_none(),
            )
        } else if let Some(head) = self.queued[0] {
            OrganizerMonitorTransportOut$(
                next_state: OrganizerMonitorState$(
                    addr: self.addr,
                    data: self.data,
                    misc: self.misc,
                    queued: self.queued.shift_back(None),
                    overflow_count: self.overflow_count,
                ),
                stream_event: organizer_trace_event_sample(head),
            )
        } else if self.overflow_count != 0 {
            OrganizerMonitorTransportOut$(
                next_state: OrganizerMonitorState$(
                    addr: self.addr,
                    data: self.data,
                    misc: self.misc,
                    queued: self.queued,
                    overflow_count: 0,
                ),
                stream_event: organizer_trace_event_overflow(self.overflow_count),
            )
        } else {
            OrganizerMonitorTransportOut$(
                next_state: self,
                stream_event: organizer_trace_event_none(),
            )
        }
    }
}

#[inline]
pub(lib) entity organizer_monitor_uarts(
    clk: clock,
    rst: bool,
    clk_uart: clock,
    samples: OrganizerMonitorSamples,
) -> OrganizerMonitorLines {
    let addr_uart = inst organizer_monitor_uart::<20>(
        clk,
        rst,
        sample_addr_value(samples.addr),
        samples.addr.valid,
        clk_uart,
    );
    let data_uart = inst organizer_monitor_uart::<8>(
        clk,
        rst,
        sample_data_value(samples.data),
        samples.data.valid,
        clk_uart,
    );
    let misc_uart = inst organizer_monitor_uart::<11>(
        clk,
        rst,
        sample_misc_value(samples.misc),
        samples.misc.valid,
        clk_uart,
    );

    OrganizerMonitorLines$(
        addr: addr_uart,
        data: data_uart,
        misc: misc_uart,
    )
}
