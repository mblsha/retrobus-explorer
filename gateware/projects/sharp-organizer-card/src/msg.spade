use shared_components::{
    ascii,
    message_stream::{
        TxReq8,
        schedule_one_current_latest_pending,
        tx_req_byte,
        tx_req_indexed,
        tx_req_none,
    },
};

use super::protocol::{SaleaeModeCode, SaleaePinSource, SampleCount, SaleaeState};

type ByteIdx = uint<4>;
type NameKind = uint<5>;
type StatusPhase = uint<5>;

pub(lib) struct OrganizerStatus {
    saleae_state: SaleaeState,
    saleae_mode: SaleaeModeCode,
    addr_delay: SampleCount,
    data_delay: SampleCount,
    pin0: SaleaePinSource,
    pin1: SaleaePinSource,
    pin2: SaleaePinSource,
    pin3: SaleaePinSource,
    ft_enabled: bool,
}

pub(lib) enum OrganizerMsg {
    None,
    CounterSelected,
    SyncStandardSelected,
    SyncMemorySelected,
    FtEnabled,
    FtDisabled,
    Status{status: OrganizerStatus},
    CounterThenFtEnabled,
    CounterThenFtDisabled,
    SyncStandardThenFtEnabled,
    SyncStandardThenFtDisabled,
    SyncMemoryThenFtEnabled,
    SyncMemoryThenFtDisabled,
}

/// How far through the current message the byte stream has got. A status
/// message walks `status_phase`/`status_idx` and, inside the `CH=` phase,
/// `status_ch`; every other message is one or two bytes counted by `simple_idx`.
pub struct MsgCursor {
    status_phase: StatusPhase,
    status_idx: ByteIdx,
    status_ch: uint<3>,
    simple_idx: uint<1>,
}

pub struct OrganizerMsgStreamState {
    cur_msg: OrganizerMsg,
    pending_msg: OrganizerMsg,
    cursor: MsgCursor,
}

pub struct OrganizerMsgStreamOut {
    state: OrganizerMsgStreamState,
    tx_req: TxReq8,
    msg_none: bool,
}

struct ProgressedState {
    cur_msg: OrganizerMsg,
    cursor: MsgCursor,
}

impl Default for MsgCursor {
    fn default() -> Self {
        MsgCursor$(status_phase: 0, status_idx: 0, status_ch: 0, simple_idx: 0)
    }
}

impl Default for OrganizerMsgStreamState {
    fn default() -> Self {
        OrganizerMsgStreamState$(
            cur_msg: OrganizerMsg::None(),
            pending_msg: OrganizerMsg::None(),
            cursor: MsgCursor::default(),
        )
    }
}

pub fn organizer_status(
    saleae_state: SaleaeState,
    saleae_mode: SaleaeModeCode,
    addr_delay: SampleCount,
    data_delay: SampleCount,
    pin0: SaleaePinSource,
    pin1: SaleaePinSource,
    pin2: SaleaePinSource,
    pin3: SaleaePinSource,
    ft_enabled: bool,
) -> OrganizerStatus {
    OrganizerStatus$(
        saleae_state: saleae_state,
        saleae_mode: saleae_mode,
        addr_delay: addr_delay,
        data_delay: data_delay,
        pin0: pin0,
        pin1: pin1,
        pin2: pin2,
        pin3: pin3,
        ft_enabled: ft_enabled,
    )
}

pub fn organizer_msg_combine(primary: OrganizerMsg, secondary: OrganizerMsg) -> OrganizerMsg {
    if primary.is_none() {
        secondary
    } else if secondary.is_none() {
        primary
    } else {
        match (primary, secondary) {
            (OrganizerMsg::CounterSelected, OrganizerMsg::FtEnabled) => OrganizerMsg::CounterThenFtEnabled(),
            (OrganizerMsg::CounterSelected, OrganizerMsg::FtDisabled) => OrganizerMsg::CounterThenFtDisabled(),
            (OrganizerMsg::SyncStandardSelected, OrganizerMsg::FtEnabled) => OrganizerMsg::SyncStandardThenFtEnabled(),
            (OrganizerMsg::SyncStandardSelected, OrganizerMsg::FtDisabled) => OrganizerMsg::SyncStandardThenFtDisabled(),
            (OrganizerMsg::SyncMemorySelected, OrganizerMsg::FtEnabled) => OrganizerMsg::SyncMemoryThenFtEnabled(),
            (OrganizerMsg::SyncMemorySelected, OrganizerMsg::FtDisabled) => OrganizerMsg::SyncMemoryThenFtDisabled(),
            (_, _) => primary,
        }
    }
}

fn name_kind_addr_sample() -> NameKind { 19 }
fn name_kind_data_sample() -> NameKind { 20 }
fn name_kind_counter0() -> NameKind { 21 }

fn phase_channel() -> StatusPhase { 17 }
fn phase_crlf() -> StatusPhase { 18 }

fn source_name_kind(source: SaleaePinSource) -> NameKind {
    if source <= 18 {
        source
    } else {
        0
    }
}

/// A channel name padded out to the longest one, carried with its own length
/// so the two cannot drift apart the way two parallel `if` chains could.
struct ChannelName {
    text: [uint<8>; 8],
    len: ByteIdx,
}

#[inline]
fn channel_name<#uint N>(text: [uint<8>; N]) -> Option<ChannelName>
where
    N <= 8 else "a Saleae channel name must fit in eight characters"
{
    // Concatenating a full eight zeros and slicing back is what pads here:
    // `[0; {8 - N}]` is rejected with "not supported in a type expression".
    let padded: [uint<8>; 8] = text.concat([0; 8])[..8];
    Some(ChannelName$(text: padded, len: N))
}

fn name_of(kind: NameKind) -> Option<ChannelName> {
    if kind == 0 {
        channel_name(b"LOW")
    } else if kind == 1 {
        channel_name(b"HIGH")
    } else if kind == 2 {
        channel_name(b"RW")
    } else if kind == 3 {
        channel_name(b"OE")
    } else if kind == 4 {
        channel_name(b"CI")
    } else if kind == 5 {
        channel_name(b"E2")
    } else if kind == 6 {
        channel_name(b"MSKROM")
    } else if kind == 7 {
        channel_name(b"SRAM1")
    } else if kind == 8 {
        channel_name(b"SRAM2")
    } else if kind == 9 {
        channel_name(b"EPROM")
    } else if kind == 10 {
        channel_name(b"STNBY")
    } else if kind == 11 {
        channel_name(b"VBATT")
    } else if kind == 12 {
        channel_name(b"VPP")
    } else if kind == 14 {
        channel_name(b"ADDR_CHG")
    } else if kind == 15 {
        channel_name(b"DATA_CHG")
    } else if kind == 16 {
        channel_name(b"ADDR_U")
    } else if kind == 17 {
        channel_name(b"DATA_U")
    } else if kind == 18 {
        channel_name(b"MISC_U")
    } else if kind == name_kind_addr_sample() {
        channel_name(b"ADDR_S")
    } else if kind == name_kind_data_sample() {
        channel_name(b"DATA_S")
    } else if kind == name_kind_counter0() {
        channel_name(b"COUNTER0")
    } else if kind == name_kind_counter0() +. 1 {
        channel_name(b"COUNTER1")
    } else if kind == name_kind_counter0() +. 2 {
        channel_name(b"COUNTER2")
    } else if kind == name_kind_counter0() +. 3 {
        channel_name(b"COUNTER3")
    } else if kind == name_kind_counter0() +. 4 {
        channel_name(b"COUNTER4")
    } else if kind == name_kind_counter0() +. 5 {
        channel_name(b"COUNTER5")
    } else if kind == name_kind_counter0() +. 6 {
        channel_name(b"COUNTER6")
    } else if kind == name_kind_counter0() +. 7 {
        channel_name(b"COUNTER7")
    } else {
        None
    }
}

/// Kind 13 and anything past COUNTER7 have no name. No reachable pin source or
/// channel maps to one, and the eight bytes claimed here are never sent, so the
/// `CH=` phase would stall rather than print rubbish.
fn name_len(kind: NameKind) -> ByteIdx {
    if let Some(name) = name_of(kind) { name.len } else { 8 }
}

fn name_byte(kind: NameKind, idx: ByteIdx) -> TxReq8 {
    if let Some(name) = name_of(kind) {
        if idx < name.len {
            tx_req_byte(name.text[trunc(idx)])
        } else {
            tx_req_none()
        }
    } else {
        tx_req_none()
    }
}

fn is_counter(status: OrganizerStatus) -> bool {
    if let SaleaeState::Counter = status.saleae_state { true } else { false }
}

fn is_settling(status: OrganizerStatus) -> bool {
    !is_counter(status) && status.saleae_mode == 2
}

fn mode_byte(status: OrganizerStatus, idx: ByteIdx) -> TxReq8 {
    if is_counter(status) {
        tx_req_indexed(b"CTR", idx)
    } else if status.saleae_mode == 1 {
        tx_req_indexed(b"MEM", idx)
    } else if status.saleae_mode == 2 {
        tx_req_indexed(b"SET", idx)
    } else {
        tx_req_indexed(b"STD", idx)
    }
}

fn set_channel_kind(status: OrganizerStatus, ch: uint<3>) -> NameKind {
    if ch == 0 {
        source_name_kind(status.pin0)
    } else if ch == 1 {
        source_name_kind(status.pin1)
    } else if ch == 2 {
        source_name_kind(status.pin2)
    } else if ch == 3 {
        source_name_kind(status.pin3)
    } else if ch == 4 {
        name_kind_addr_sample()
    } else if ch == 5 {
        name_kind_data_sample()
    } else if ch == 6 {
        14
    } else {
        15
    }
}

fn std_channel_kind(ch: uint<3>) -> NameKind {
    if ch == 0 {
        2
    } else if ch == 1 {
        3
    } else if ch == 2 {
        4
    } else if ch == 3 {
        5
    } else if ch == 4 {
        6
    } else if ch == 5 {
        18
    } else if ch == 6 {
        17
    } else {
        16
    }
}

fn mem_channel_kind(ch: uint<3>) -> NameKind {
    if ch == 0 {
        2
    } else if ch == 1 {
        6
    } else if ch == 2 {
        7
    } else if ch == 3 {
        8
    } else if ch == 4 {
        9
    } else if ch == 5 {
        18
    } else if ch == 6 {
        17
    } else {
        16
    }
}

fn channel_kind(status: OrganizerStatus, ch: uint<3>) -> NameKind {
    if is_counter(status) {
        name_kind_counter0() +. zext(ch)
    } else if is_settling(status) {
        set_channel_kind(status, ch)
    } else if status.saleae_mode == 1 {
        mem_channel_kind(ch)
    } else {
        std_channel_kind(ch)
    }
}

fn status_pin_kind(status: OrganizerStatus, phase: StatusPhase) -> NameKind {
    if phase == 7 {
        source_name_kind(status.pin0)
    } else if phase == 9 {
        source_name_kind(status.pin1)
    } else if phase == 11 {
        source_name_kind(status.pin2)
    } else {
        source_name_kind(status.pin3)
    }
}

fn status_phase_len(status: OrganizerStatus, phase: StatusPhase, ch: uint<3>) -> ByteIdx {
    if phase == 0 {
        5
    } else if phase == 1 {
        3
    } else if phase == 2 {
        3
    } else if phase == 3 {
        2
    } else if phase == 4 {
        3
    } else if phase == 5 {
        2
    } else if phase == 6 || phase == 8 || phase == 10 || phase == 12 {
        4
    } else if phase == 7 || phase == 9 || phase == 11 || phase == 13 {
        name_len(status_pin_kind(status, phase))
    } else if phase == 14 {
        4
    } else if phase == 15 {
        1
    } else if phase == 16 {
        5
    } else if phase == phase_channel() {
        name_len(channel_kind(status, ch)) +. if ch == 0 { 0 } else { 1 }
    } else {
        2
    }
}

fn status_byte(status: OrganizerStatus, phase: StatusPhase, idx: ByteIdx, ch: uint<3>) -> TxReq8 {
    if phase == 0 {
        tx_req_indexed(b"OS,M=", idx)
    } else if phase == 1 {
        mode_byte(status, idx)
    } else if phase == 2 {
        tx_req_indexed(b",A=", idx)
    } else if phase == 3 {
        tx_req_byte(if idx == 0 {
            ascii::byte_hex_high(trunc(status.addr_delay))
        } else {
            ascii::byte_hex_low(trunc(status.addr_delay))
        })
    } else if phase == 4 {
        tx_req_indexed(b",D=", idx)
    } else if phase == 5 {
        tx_req_byte(if idx == 0 {
            ascii::byte_hex_high(trunc(status.data_delay))
        } else {
            ascii::byte_hex_low(trunc(status.data_delay))
        })
    } else if phase == 6 {
        tx_req_indexed(b",P0=", idx)
    } else if phase == 7 {
        name_byte(source_name_kind(status.pin0), idx)
    } else if phase == 8 {
        tx_req_indexed(b",P1=", idx)
    } else if phase == 9 {
        name_byte(source_name_kind(status.pin1), idx)
    } else if phase == 10 {
        tx_req_indexed(b",P2=", idx)
    } else if phase == 11 {
        name_byte(source_name_kind(status.pin2), idx)
    } else if phase == 12 {
        tx_req_indexed(b",P3=", idx)
    } else if phase == 13 {
        name_byte(source_name_kind(status.pin3), idx)
    } else if phase == 14 {
        tx_req_indexed(b",FT=", idx)
    } else if phase == 15 {
        tx_req_byte(ascii::bool_char(status.ft_enabled))
    } else if phase == 16 {
        tx_req_indexed(b"\r\nCH=", idx)
    } else if phase == phase_channel() {
        if ch != 0 && idx == 0 {
            tx_req_byte(b',')
        } else {
            name_byte(channel_kind(status, ch), if ch == 0 { idx } else { idx -. 1 })
        }
    } else {
        tx_req_indexed(b"\r\n", idx)
    }
}

fn status_last_byte(status: OrganizerStatus, phase: StatusPhase, idx: ByteIdx, ch: uint<3>) -> bool {
    phase == phase_crlf() && idx == status_phase_len(status, phase, ch) -. 1
}

fn status_phase_done(status: OrganizerStatus, phase: StatusPhase, idx: ByteIdx, ch: uint<3>) -> bool {
    idx == status_phase_len(status, phase, ch) -. 1
}

impl OrganizerMsg {
    pub fn is_none(self) -> bool {
        if let Self::None = self { true } else { false }
    }

    fn first_part(self) -> OrganizerMsg {
        match self {
            Self::CounterThenFtEnabled => Self::CounterSelected(),
            Self::CounterThenFtDisabled => Self::CounterSelected(),
            Self::SyncStandardThenFtEnabled => Self::SyncStandardSelected(),
            Self::SyncStandardThenFtDisabled => Self::SyncStandardSelected(),
            Self::SyncMemoryThenFtEnabled => Self::SyncMemorySelected(),
            Self::SyncMemoryThenFtDisabled => Self::SyncMemorySelected(),
            _ => self,
        }
    }

    fn second_part(self) -> OrganizerMsg {
        match self {
            Self::CounterThenFtEnabled => Self::FtEnabled(),
            Self::CounterThenFtDisabled => Self::FtDisabled(),
            Self::SyncStandardThenFtEnabled => Self::FtEnabled(),
            Self::SyncStandardThenFtDisabled => Self::FtDisabled(),
            Self::SyncMemoryThenFtEnabled => Self::FtEnabled(),
            Self::SyncMemoryThenFtDisabled => Self::FtDisabled(),
            _ => Self::None(),
        }
    }

    fn simple_len(self) -> uint<2> {
        if self.first_part().is_none() {
            0
        } else if self.second_part().is_none() {
            1
        } else {
            2
        }
    }

    fn simple_byte(self, idx: uint<1>) -> uint<8> {
        let part = if idx == 0 {
            self.first_part()
        } else {
            self.second_part()
        };
        match part {
            Self::CounterSelected => b'c',
            Self::SyncStandardSelected => b's',
            Self::SyncMemorySelected => b'S',
            Self::FtEnabled => b'+',
            Self::FtDisabled => b'-',
            _ => 0,
        }
    }

    fn tx_req(self, at: MsgCursor) -> TxReq8 {
        if let Self::Status$(status) = self {
            status_byte(status, at.status_phase, at.status_idx, at.status_ch)
        } else if zext(at.simple_idx) < self.simple_len() {
            tx_req_byte(self.simple_byte(at.simple_idx))
        } else {
            tx_req_none()
        }
    }

    fn last_byte(self, at: MsgCursor) -> bool {
        if let Self::Status$(status) = self {
            status_last_byte(status, at.status_phase, at.status_idx, at.status_ch)
        } else {
            zext(at.simple_idx) == self.simple_len() -. 1
        }
    }
}

impl Default for ProgressedState {
    fn default() -> Self {
        ProgressedState$(cur_msg: OrganizerMsg::None(), cursor: MsgCursor::default())
    }
}

fn advance_cursor(msg: OrganizerMsg, at: MsgCursor) -> MsgCursor {
    if let OrganizerMsg::Status$(status) = msg {
        if !status_phase_done(status, at.status_phase, at.status_idx, at.status_ch) {
            MsgCursor$(
                status_phase: at.status_phase,
                status_idx: at.status_idx +. 1,
                status_ch: at.status_ch,
                simple_idx: at.simple_idx,
            )
        } else {
            // The CH= phase repeats once per channel; only the eighth leaves it.
            let more_channels = at.status_phase == phase_channel() && at.status_ch != 7;
            MsgCursor$(
                status_phase: if more_channels { at.status_phase } else { at.status_phase +. 1 },
                status_idx: 0,
                status_ch: if more_channels { at.status_ch +. 1 } else { at.status_ch },
                simple_idx: at.simple_idx,
            )
        }
    } else {
        MsgCursor$(
            status_phase: at.status_phase,
            status_idx: at.status_idx,
            status_ch: at.status_ch,
            simple_idx: at.simple_idx +. 1,
        )
    }
}

fn progress_state(state: OrganizerMsgStreamState, sent: bool) -> ProgressedState {
    if !sent {
        ProgressedState$(cur_msg: state.cur_msg, cursor: state.cursor)
    } else if state.cur_msg.last_byte(state.cursor) {
        ProgressedState::default()
    } else {
        ProgressedState$(
            cur_msg: state.cur_msg,
            cursor: advance_cursor(state.cur_msg, state.cursor),
        )
    }
}

pub fn organizer_msg_stream_step(
    state: OrganizerMsgStreamState,
    block_tx: bool,
    msg_valid: bool,
    msg: OrganizerMsg,
) -> OrganizerMsgStreamOut {
    let cur_none = state.cur_msg.is_none();
    let pending_none = state.pending_msg.is_none();
    let tx_req = if !cur_none && !block_tx {
        state.cur_msg.tx_req(state.cursor)
    } else {
        tx_req_none()
    };
    let progressed = progress_state(state, tx_req.valid);
    let progressed_none = progressed.cur_msg.is_none();
    let scheduled = schedule_one_current_latest_pending(
        OrganizerMsg::None(),
        progressed.cur_msg,
        progressed_none,
        state.pending_msg,
        pending_none,
        msg_valid,
        msg,
        msg.is_none(),
    );
    let reset_cursor = progressed_none || scheduled.current_loaded;
    OrganizerMsgStreamOut$(
        state: OrganizerMsgStreamState$(
            cur_msg: scheduled.current,
            pending_msg: scheduled.pending,
            cursor: if reset_cursor { MsgCursor::default() } else { progressed.cursor },
        ),
        tx_req: tx_req,
        msg_none: scheduled.current_is_none,
    )
}
