use shared_components::{ascii, serial::{FtBe, FtData}};

use super::{
    msg::{OrganizerMsg, OrganizerStatus, organizer_msg_combine},
    protocol::{SaleaeModeCode, SaleaePinSource, SampleCount, SaleaeState, SyncSubMode},
};

pub(lib) type OrganizerCmdState = uint<4>;

enum OrganizerFtCmd {
    None,
    Enable,
    Disable,
}

pub(lib) struct OrganizerUiInputs {
    rx_valid: bool,
    rx_byte: uint<8>,
    ft_ui_dout_empty: bool,
    ft_ui_dout: FtData,
    ft_ui_dout_be: FtBe,
    saleae_state: SaleaeState,
    sync_sub_mode: SyncSubMode,
    saleae_mode: SaleaeModeCode,
    cmd_state: OrganizerCmdState,
    cmd_hex_high: uint<4>,
    addr_stable_delay: SampleCount,
    data_stable_delay: SampleCount,
    pin0: SaleaePinSource,
    pin1: SaleaePinSource,
    pin2: SaleaePinSource,
    pin3: SaleaePinSource,
    ft_enabled: bool,
}

pub(lib) struct OrganizerFtCmdEffect {
    next_ft_enabled: bool,
    msg: OrganizerMsg,
}

pub(lib) struct OrganizerUiEffect {
    next_saleae_state: SaleaeState,
    next_sync_sub_mode: SyncSubMode,
    next_saleae_mode: SaleaeModeCode,
    next_cmd_state: OrganizerCmdState,
    next_cmd_hex_high: uint<4>,
    next_addr_stable_delay: SampleCount,
    next_data_stable_delay: SampleCount,
    next_pin0: SaleaePinSource,
    next_pin1: SaleaePinSource,
    next_pin2: SaleaePinSource,
    next_pin3: SaleaePinSource,
    next_ft_enabled: bool,
    msg: OrganizerMsg,
}

pub(lib) fn init_organizer_cmd_state() -> OrganizerCmdState { 0 }
fn cmd_wait_addr_delay() -> OrganizerCmdState { 1 }
fn cmd_wait_data_delay() -> OrganizerCmdState { 2 }
fn cmd_wait_pin0() -> OrganizerCmdState { 3 }
fn cmd_wait_pin1() -> OrganizerCmdState { 4 }
fn cmd_wait_pin2() -> OrganizerCmdState { 5 }
fn cmd_wait_pin3() -> OrganizerCmdState { 6 }
fn cmd_wait_addr_ext_hi() -> OrganizerCmdState { 7 }
fn cmd_wait_addr_ext_lo() -> OrganizerCmdState { 8 }
fn cmd_wait_data_ext_hi() -> OrganizerCmdState { 9 }
fn cmd_wait_data_ext_lo() -> OrganizerCmdState { 10 }
fn cmd_wait_addr_ext_drop() -> OrganizerCmdState { 11 }
fn cmd_wait_data_ext_drop() -> OrganizerCmdState { 12 }

pub(lib) fn saleae_mode_standard() -> SaleaeModeCode { 0 }
pub(lib) fn saleae_mode_memory() -> SaleaeModeCode { 1 }
pub(lib) fn saleae_mode_settling() -> SaleaeModeCode { 2 }

pub(lib) fn pin_source_rw() -> SaleaePinSource { 2 }
pub(lib) fn pin_source_oe() -> SaleaePinSource { 3 }
pub(lib) fn pin_source_mskrom() -> SaleaePinSource { 6 }
pub(lib) fn pin_source_sram1() -> SaleaePinSource { 7 }
pub(lib) fn pin_source_addr_uart() -> SaleaePinSource { 16 }
pub(lib) fn pin_source_data_uart() -> SaleaePinSource { 17 }
pub(lib) fn pin_source_misc_uart() -> SaleaePinSource { 18 }

fn organizer_ft_cmd_from_word(ft_ui_dout_empty: bool, word: FtData, be: FtBe) -> OrganizerFtCmd {
    let b0: uint<8> = trunc(word);
    let b1: uint<8> = trunc(word >> 8);
    if ft_ui_dout_empty || be != 0x3 || b0 != b'S' {
        OrganizerFtCmd::None()
    } else if b1 == b'+' {
        OrganizerFtCmd::Enable()
    } else if b1 == b'-' {
        OrganizerFtCmd::Disable()
    } else {
        OrganizerFtCmd::None()
    }
}

impl OrganizerFtCmd {
    fn effect(self, ft_enabled: bool) -> OrganizerFtCmdEffect {
        match self {
            Self::None => OrganizerFtCmdEffect$(
                next_ft_enabled: ft_enabled,
                msg: OrganizerMsg::None(),
            ),
            Self::Enable => OrganizerFtCmdEffect$(
                next_ft_enabled: true,
                msg: OrganizerMsg::FtEnabled(),
            ),
            Self::Disable => OrganizerFtCmdEffect$(
                next_ft_enabled: false,
                msg: OrganizerMsg::FtDisabled(),
            ),
        }
    }
}

/// The pin-source letters, or `None` for a byte that names no source. `L` is a
/// source like any other: it drives the pin low.
fn pin_source_from_byte(byte: uint<8>) -> Option<SaleaePinSource> {
    let upper = byte.to_upper();
    if upper == b'L' {
        Some(0)
    } else if upper == b'H' {
        Some(1)
    } else if upper == b'R' {
        Some(2)
    } else if upper == b'O' {
        Some(3)
    } else if upper == b'C' {
        Some(4)
    } else if upper == b'E' {
        Some(5)
    } else if upper == b'M' {
        Some(6)
    } else if byte == b'1' {
        Some(7)
    } else if byte == b'2' {
        Some(8)
    } else if upper == b'P' {
        Some(9)
    } else if upper == b'Y' {
        Some(10)
    } else if upper == b'B' {
        Some(11)
    } else if upper == b'V' {
        Some(12)
    } else if upper == b'A' {
        Some(14)
    } else if upper == b'D' {
        Some(15)
    } else if upper == b'X' {
        Some(pin_source_addr_uart())
    } else if upper == b'Z' {
        Some(pin_source_data_uart())
    } else if upper == b'J' {
        Some(pin_source_misc_uart())
    } else {
        None
    }
}

pub(lib) fn eval_organizer_ui(inputs: OrganizerUiInputs) -> OrganizerUiEffect {
    let ft_effect = organizer_ft_cmd_from_word(inputs.ft_ui_dout_empty, inputs.ft_ui_dout, inputs.ft_ui_dout_be)
        .effect(inputs.ft_enabled);
    let decoded = inputs.rx_byte.decode_hex();
    let decoded_source = pin_source_from_byte(inputs.rx_byte);
    let source_valid = decoded_source.is_some();
    let source = decoded_source.unwrap_or(0);
    let waiting_pin = inputs.cmd_state == cmd_wait_pin0() ||
        inputs.cmd_state == cmd_wait_pin1() ||
        inputs.cmd_state == cmd_wait_pin2() ||
        inputs.cmd_state == cmd_wait_pin3();
    let waiting_addr_ext_hi = inputs.cmd_state == cmd_wait_addr_ext_hi();
    let waiting_addr_ext_lo = inputs.cmd_state == cmd_wait_addr_ext_lo();
    let waiting_data_ext_hi = inputs.cmd_state == cmd_wait_data_ext_hi();
    let waiting_data_ext_lo = inputs.cmd_state == cmd_wait_data_ext_lo();
    let waiting_addr_ext_drop = inputs.cmd_state == cmd_wait_addr_ext_drop();
    let waiting_data_ext_drop = inputs.cmd_state == cmd_wait_data_ext_drop();
    let waiting_ext_hi = waiting_addr_ext_hi || waiting_data_ext_hi;
    let waiting_ext_lo = waiting_addr_ext_lo || waiting_data_ext_lo;
    let waiting_ext_drop = waiting_addr_ext_drop || waiting_data_ext_drop;
    let ext_delay: uint<8> = (zext(inputs.cmd_hex_high) << 4) | zext(decoded.value);

    // The single-byte console commands, recognized only between commands.
    let idle_cmd = inputs.rx_valid && inputs.cmd_state == init_organizer_cmd_state();
    let cmd_counter = idle_cmd && inputs.rx_byte == b'c';
    let cmd_sync_standard = idle_cmd && inputs.rx_byte == b's';
    let cmd_sync_memory = idle_cmd && inputs.rx_byte == b'S';
    let cmd_settling = idle_cmd && (inputs.rx_byte == b't' || inputs.rx_byte == b'T');
    let cmd_status = idle_cmd && inputs.rx_byte == b'?';

    let next_cmd_state = if !inputs.rx_valid {
        inputs.cmd_state
    } else if inputs.cmd_state == cmd_wait_addr_delay() {
        if inputs.rx_byte == b'=' {
            cmd_wait_addr_ext_hi()
        } else {
            init_organizer_cmd_state()
        }
    } else if inputs.cmd_state == cmd_wait_data_delay() {
        if inputs.rx_byte == b'=' {
            cmd_wait_data_ext_hi()
        } else {
            init_organizer_cmd_state()
        }
    } else if waiting_addr_ext_hi {
        if decoded.valid {
            cmd_wait_addr_ext_lo()
        } else {
            cmd_wait_addr_ext_drop()
        }
    } else if waiting_data_ext_hi {
        if decoded.valid {
            cmd_wait_data_ext_lo()
        } else {
            cmd_wait_data_ext_drop()
        }
    } else if waiting_ext_drop {
            init_organizer_cmd_state()
    } else if waiting_ext_lo || waiting_pin {
        init_organizer_cmd_state()
    } else if inputs.rx_byte == b'a' || inputs.rx_byte == b'A' {
        cmd_wait_addr_delay()
    } else if inputs.rx_byte == b'd' || inputs.rx_byte == b'D' {
        cmd_wait_data_delay()
    } else if inputs.rx_byte == b'0' {
        cmd_wait_pin0()
    } else if inputs.rx_byte == b'1' {
        cmd_wait_pin1()
    } else if inputs.rx_byte == b'2' {
        cmd_wait_pin2()
    } else if inputs.rx_byte == b'3' {
        cmd_wait_pin3()
    } else {
        init_organizer_cmd_state()
    };

    let next_saleae_state = if cmd_counter {
        SaleaeState::Counter()
    } else if cmd_sync_standard || cmd_sync_memory || cmd_settling {
        SaleaeState::SyncSignals()
    } else {
        inputs.saleae_state
    };
    let next_sync_sub_mode = if cmd_sync_standard {
        SyncSubMode::StandardSignals()
    } else if cmd_sync_memory {
        SyncSubMode::MemoryBanks()
    } else {
        inputs.sync_sub_mode
    };
    let next_saleae_mode = if cmd_sync_standard {
        saleae_mode_standard()
    } else if cmd_sync_memory {
        saleae_mode_memory()
    } else if cmd_settling {
        saleae_mode_settling()
    } else {
        inputs.saleae_mode
    };

    let set_addr_delay = inputs.rx_valid && inputs.cmd_state == cmd_wait_addr_delay() && decoded.valid;
    let set_data_delay = inputs.rx_valid && inputs.cmd_state == cmd_wait_data_delay() && decoded.valid;
    let set_addr_ext_delay = inputs.rx_valid && waiting_addr_ext_lo && decoded.valid;
    let set_data_ext_delay = inputs.rx_valid && waiting_data_ext_lo && decoded.valid;
    let set_pin = inputs.rx_valid && waiting_pin && source_valid;
    let next_cmd_hex_high = if inputs.rx_valid && waiting_ext_hi && decoded.valid {
        decoded.value
    } else if inputs.rx_valid && (waiting_ext_lo || waiting_ext_drop || inputs.cmd_state == cmd_wait_addr_delay() || inputs.cmd_state == cmd_wait_data_delay()) {
        0
    } else {
        inputs.cmd_hex_high
    };

    let usb_msg = if cmd_counter {
        OrganizerMsg::CounterSelected()
    } else if cmd_sync_standard {
        OrganizerMsg::SyncStandardSelected()
    } else if cmd_sync_memory {
        OrganizerMsg::SyncMemorySelected()
    } else if cmd_status {
        OrganizerMsg::Status(OrganizerStatus$(
            saleae_state: inputs.saleae_state,
            saleae_mode: inputs.saleae_mode,
            addr_delay: inputs.addr_stable_delay,
            data_delay: inputs.data_stable_delay,
            pin0: inputs.pin0,
            pin1: inputs.pin1,
            pin2: inputs.pin2,
            pin3: inputs.pin3,
            ft_enabled: inputs.ft_enabled,
        ))
    } else {
        OrganizerMsg::None()
    };

    OrganizerUiEffect$(
        next_saleae_state: next_saleae_state,
        next_sync_sub_mode: next_sync_sub_mode,
        next_saleae_mode: next_saleae_mode,
        next_cmd_state: next_cmd_state,
        next_cmd_hex_high: next_cmd_hex_high,
        next_addr_stable_delay: if set_addr_ext_delay { zext(ext_delay) } else if set_addr_delay { zext(decoded.value) } else { inputs.addr_stable_delay },
        next_data_stable_delay: if set_data_ext_delay { zext(ext_delay) } else if set_data_delay { zext(decoded.value) } else { inputs.data_stable_delay },
        next_pin0: if set_pin && inputs.cmd_state == cmd_wait_pin0() { source } else { inputs.pin0 },
        next_pin1: if set_pin && inputs.cmd_state == cmd_wait_pin1() { source } else { inputs.pin1 },
        next_pin2: if set_pin && inputs.cmd_state == cmd_wait_pin2() { source } else { inputs.pin2 },
        next_pin3: if set_pin && inputs.cmd_state == cmd_wait_pin3() { source } else { inputs.pin3 },
        next_ft_enabled: ft_effect.next_ft_enabled,
        msg: organizer_msg_combine(usb_msg, ft_effect.msg),
    )
}
