// One transaction at a time (one write sector or up to two read sectors). Writes keep command and data valid
// independently until both handshakes complete. Byte input has one-cycle RAM
// latency; reads publish every byte before signaling completion.
#[no_mangle(all)]
pub entity network_native(
    clk: clock,
    rst: bool,
    enabled: bool,
    request: bool,
    write: bool,
    lba: uint<32>,
    count: uint<2>,
    write_index: inv &uint<9>,
    write_data: uint<8>,
    read_valid: inv &bool,
    read_index: inv &uint<10>,
    read_data: inv &uint<8>,
    done: inv &bool,
    error: inv &bool,
    busy: inv &bool,
    cmd_valid: inv &bool,
    cmd_ready: bool,
    cmd_address: inv &uint<24>,
    cmd_write: inv &bool,
    rdata_valid: bool,
    rdata_ready: inv &bool,
    rdata: uint<128>,
    wdata_valid: inv &bool,
    wdata_ready: bool,
    wdata: inv &uint<128>,
    wdata_mask: inv &uint<16>,
) {
    // 0 idle; 11 validate captured address; 1 read command; 2 read data; 3 serialize; 6 write-byte address;
    // 7 gather byte; 4 independent write handshakes; 8 done; 9 bounds error;
    // 10 wait for request release. Gaps preserve the original state encoding.
    decl state, word_index, byte_index, command_sent, data_sent;
    let start = state == 0 && request && enabled;
    reg(clk) saved_lba: uint<32> reset(rst: 0) = if start { lba } else { saved_lba };
    reg(clk) two_sectors reset(rst: false) = if start { !write && count == 2 } else { two_sectors };
    reg(clk) writing reset(rst: false) = if start { write } else { writing };
    let write_complete = state == 4 && (command_sent || cmd_ready) && (data_sent || wdata_ready);
    reg(clk) state: uint<4> reset(rst: 0) = {
        // Capture the request before checking bounds. This keeps the wide
        // address comparison out of the ownership-enable path; no native DDR
        // command or data is issued during this validation cycle.
        if start { 11 }
        else if state == 11 {
            if saved_lba >= 524288 || (two_sectors && saved_lba == 524287) { 9 }
            else if writing { 6 } else { 1 }
        }
        else if state == 1 && cmd_ready { 2 }
        else if state == 2 && rdata_valid { 3 }
        else if state == 3 && byte_index == 15 { if word_index == (if two_sectors { 63 } else { 31 }) { 8 } else { 1 } }
        else if state == 6 { 7 }
        else if state == 7 { if byte_index == 15 { 4 } else { 6 } }
        else if write_complete { if word_index == 31 { 8 } else { 6 } }
        else if state == 8 || state == 9 { 10 }
        else if state == 10 && !request { 0 }
        else { state }
    };
    reg(clk) word_index: uint<6> reset(rst: 0) = if start { 0 }
        else if (state == 3 && byte_index == 15) || write_complete { word_index +. 1 } else { word_index };
    reg(clk) byte_index: uint<4> reset(rst: 0) = if start || write_complete { 0 }
        else if state == 3 || state == 7 { byte_index +. 1 } else { byte_index };
    reg(clk) word: uint<128> reset(rst: 0) = if state == 2 && rdata_valid { rdata }
        else if state == 7 { (word >> 8) | (zext(write_data) << 120) } else { word };
    reg(clk) command_sent reset(rst: false) = if state != 4 { false } else { command_sent || cmd_ready };
    reg(clk) data_sent reset(rst: false) = if state != 4 { false } else { data_sent || wdata_ready };
    let offset: uint<10> = (zext(word_index) << 4) | zext(byte_index);
    set write_index = &trunc(offset);
    set read_valid = &(state == 3);
    set read_index = &offset;
    set read_data = &trunc(word >> (zext::<4, 128>(byte_index) << 3));
    set done = &(state == 8 || state == 9);
    set error = &(state == 9);
    set busy = &(state != 0 && state != 10);
    set cmd_valid = &(state == 1 || (state == 4 && !command_sent));
    set cmd_address = &((trunc::<uint<32>, uint<24>>(saved_lba) << 5) +. zext(word_index));
    set cmd_write = &writing;
    set rdata_ready = &(state == 2);
    set wdata_valid = &(state == 4 && !data_sent);
    set wdata = &word;
    set wdata_mask = &0xffff;
}
