// One transaction at a time (one write sector or up to two read sectors). Writes keep command and data valid
// independently until both handshakes complete. Byte input has one-cycle RAM
// latency; reads publish every byte before signaling completion.
#[no_mangle(all)]
pub entity network_native(
    clk: clock,
    rst: bool,
    enabled: bool,
    request: bool,
    write: bool,
    lba: uint<32>,
    count: uint<2>,
    write_index: inv &uint<9>,
    write_data: uint<8>,
    read_valid: inv &bool,
    read_index: inv &uint<10>,
    read_data: inv &uint<8>,
    done: inv &bool,
    error: inv &bool,
    busy: inv &bool,
    cmd_valid: inv &bool,
    cmd_ready: bool,
    cmd_address: inv &uint<24>,
    cmd_write: inv &bool,
    rdata_valid: bool,
    rdata_ready: inv &bool,
    rdata: uint<128>,
    wdata_valid: inv &bool,
    wdata_ready: bool,
    wdata: inv &uint<128>,
    wdata_mask: inv &uint<16>,
) {
    // Keep these encodings and address/capture stages: they preserve RAM latency.
    let IDLE: uint<4> = 0;
    let READ_COMMAND: uint<4> = 1;
    let READ_DATA: uint<4> = 2;
    let SERIALIZE_READ: uint<4> = 3;
    let WRITE_HANDSHAKES: uint<4> = 4;
    let WRITE_BYTE_ADDRESS: uint<4> = 6;
    let GATHER_WRITE_BYTE: uint<4> = 7;
    let COMPLETE: uint<4> = 8;
    let BOUNDS_ERROR: uint<4> = 9;
    let WAIT_REQUEST_RELEASE: uint<4> = 10;
    let VALIDATE_ADDRESS: uint<4> = 11;

    decl state, word_index, byte_index, command_sent, data_sent;
    let start = state == IDLE && request && enabled;
    reg(clk) saved_lba: uint<32> reset(rst: 0) = if start { lba } else { saved_lba };
    reg(clk) two_sectors reset(rst: false) = if start { !write && count == 2 } else { two_sectors };
    reg(clk) writing reset(rst: false) = if start { write } else { writing };
    let write_complete = state == WRITE_HANDSHAKES && (command_sent || cmd_ready) && (data_sent || wdata_ready);
    let last_byte = byte_index == 15;
    let last_read_word = word_index == (if two_sectors { 63 } else { 31 });
    let last_write_word = word_index == 31;
    reg(clk) state: uint<4> reset(rst: IDLE) = {
        // Capture the request before checking bounds. This keeps the wide
        // address comparison out of the ownership-enable path; no native DDR
        // command or data is issued during this validation cycle.
        if start { VALIDATE_ADDRESS }
        else if state == VALIDATE_ADDRESS {
            if saved_lba >= 524288 || (two_sectors && saved_lba == 524287) { BOUNDS_ERROR }
            else if writing { WRITE_BYTE_ADDRESS } else { READ_COMMAND }
        }
        else if state == READ_COMMAND && cmd_ready { READ_DATA }
        else if state == READ_DATA && rdata_valid { SERIALIZE_READ }
        else if state == SERIALIZE_READ && last_byte {
            if last_read_word { COMPLETE } else { READ_COMMAND }
        }
        else if state == WRITE_BYTE_ADDRESS { GATHER_WRITE_BYTE }
        else if state == GATHER_WRITE_BYTE {
            if last_byte { WRITE_HANDSHAKES } else { WRITE_BYTE_ADDRESS }
        }
        else if write_complete {
            if last_write_word { COMPLETE } else { WRITE_BYTE_ADDRESS }
        }
        else if state == COMPLETE || state == BOUNDS_ERROR { WAIT_REQUEST_RELEASE }
        else if state == WAIT_REQUEST_RELEASE && !request { IDLE }
        else { state }
    };
    reg(clk) word_index: uint<6> reset(rst: 0) = if start { 0 }
        else if (state == SERIALIZE_READ && last_byte) || write_complete { word_index +. 1 } else { word_index };
    reg(clk) byte_index: uint<4> reset(rst: 0) = if start || write_complete { 0 }
        else if state == SERIALIZE_READ || state == GATHER_WRITE_BYTE { byte_index +. 1 } else { byte_index };
    reg(clk) word: uint<128> reset(rst: 0) = if state == READ_DATA && rdata_valid { rdata }
        else if state == GATHER_WRITE_BYTE { (word >> 8) | (zext(write_data) << 120) } else { word };
    reg(clk) command_sent reset(rst: false) = if state != WRITE_HANDSHAKES { false } else { command_sent || cmd_ready };
    reg(clk) data_sent reset(rst: false) = if state != WRITE_HANDSHAKES { false } else { data_sent || wdata_ready };
    let offset: uint<10> = (zext(word_index) << 4) | zext(byte_index);
    set write_index = &trunc(offset);
    set read_valid = &(state == SERIALIZE_READ);
    set read_index = &offset;
    set read_data = &trunc(word >> (zext::<4, 128>(byte_index) << 3));
    set done = &(state == COMPLETE || state == BOUNDS_ERROR);
    set error = &(state == BOUNDS_ERROR);
    set busy = &(state != IDLE && state != WAIT_REQUEST_RELEASE);
    set cmd_valid = &(state == READ_COMMAND || (state == WRITE_HANDSHAKES && !command_sent));
    set cmd_address = &((trunc::<uint<32>, uint<24>>(saved_lba) << 5) +. zext(word_index));
    set cmd_write = &writing;
    set rdata_ready = &(state == READ_DATA);
    set wdata_valid = &(state == WRITE_HANDSHAKES && !data_sent);
    set wdata = &word;
    set wdata_mask = &0xffff;
}
