use std::mem::{clocked_memory, read_memory};
use shared_components::sd::crc32_byte;

// RBS1 request / RBA1 reply: opcode, status, two reserved bytes, session,
// sequence, LBA, count (all u32 LE), 512 data bytes, CRC32 over bytes 0..535.
// Stop-and-wait: cache the last ordered reply, including read data. A duplicate
// must match the request CRC; it never re-executes a memory/control operation.
#[no_mangle(all)]
pub entity block_service(
    clk: clock,
    rst: bool,
    initialized: bool,
    sd_quiescent: bool,
    request: bool,
    request_length: uint<11>,
    request_address: inv &uint<10>,
    request_data: uint<8>,
    reply_write: inv &bool,
    reply_address: inv &uint<11>,
    reply_data: inv &uint<8>,
    reply_done: inv &bool,
    reply_length: inv &uint<11>,
    memory_request: inv &bool,
    memory_write: inv &bool,
    memory_lba: inv &uint<32>,
    memory_count: inv &uint<2>,
    memory_write_index: uint<9>,
    memory_write_data: inv &uint<8>,
    memory_read_valid: bool,
    memory_read_index: uint<10>,
    memory_read_data: uint<8>,
    memory_done: bool,
    memory_error: bool,
    armed: inv &bool,
) {
    // State encoding is kept explicit for the byte-memory read latency:
    // 0 idle; 1 address; 2 capture; 3 validate; 4 dispatch; 5 DDR transfer;
    // 6 reply address; 11 reply register; 7 emit; 9 complete; 10 reject length;
    // 8 wait for the caller to release its request.
    decl state, index, crc, saved_status, session, next_sequence, last_sequence, last_crc, cached, arm, loaded, expected;
    let capture = state == 2;
    reg(clk) compact reset(rst: false) = if state == 0 { request_length == 28 } else { compact };
    let input_length: uint<11> = if compact { 28 } else { 540 };
    reg(clk) header: uint<192> reset(rst: 0) = if capture && index < 24 { (header >> 8) | (zext(request_data) << 184) } else { header };
    reg(clk) crc: uint<32> reset(rst: 0xffffffff) = if state == 0 { 0xffffffff }
        else if capture && index < input_length -. 4 { crc32_byte(crc, request_data) } else { crc };
    reg(clk) expected_crc: uint<32> reset(rst: 0) = if capture && index >= input_length -. 4 { (expected_crc >> 8) | (zext(request_data) << 24) } else { expected_crc };
    let payload: Memory<uint<8>, 512> = inst clocked_memory(clk, [(capture && index >= 24 && index < input_length -. 4, trunc(index -. 24), request_data)]);
    reg(clk) write_byte = inst read_memory(payload, memory_write_index);
    let returned: Memory<uint<8>, 1024> = inst clocked_memory(clk, [(state == 5 && memory_read_valid, memory_read_index, memory_read_data)]);
    reg(clk) read_byte = inst read_memory(returned, trunc(index -. 24));
    let opcode: uint<8> = trunc(header >> 32);
    let requested_session: uint<32> = trunc(header >> 64);
    let sequence: uint<32> = trunc(header >> 96);
    let lba: uint<32> = trunc(header >> 128);
    let count: uint<32> = trunc(header >> 160);
    let format_ok = trunc::<uint<192>, uint<32>>(header) == 0x31534252 &&
        trunc::<uint<192>, uint<24>>(header >> 40) == 0 && opcode >= 1 && opcode <= 7 && (!compact || opcode == 7) && expected_crc == (crc ^ 0xffffffff);
    let bulk = opcode == 7;
    let read_operation = opcode == 3 || bulk;
    // Freeze reply size before DDR starts; avoid a count/status decode on every byte.
    reg(clk) long_reply reset(rst: false) = if state == 4 { bulk && count == 2 && saved_status == 0 }
        else if state == 5 && memory_done && memory_error { false } else { long_reply };
    let payload_bytes: uint<11> = if long_reply { 1024 } else { 512 };
    let response_length: uint<11> = payload_bytes +. 28;
    let same_key = !bulk && cached && requested_session == session && sequence == last_sequence;
    let duplicate = format_ok && same_key && expected_crc == last_crc;
    let new_session = opcode == 1 && requested_session != 0 && requested_session != session && sequence == 0;
    let ordered = (new_session && !arm && initialized && count >= 1 && count <= 524288) ||
        (opcode != 1 && !bulk && requested_session == session && session != 0 && sequence == next_sequence);
    let status: uint<8> = if !format_ok { 1 }
        else if same_key && !duplicate { 9 }
        else if opcode == 1 && arm { 4 }
        else if !initialized { 6 }
        else if bulk && (requested_session != session || session == 0) { 2 }
        else if !ordered && !bulk { if requested_session != session { 2 } else { 3 } }
        else if (opcode == 2 || read_operation) && (arm || !sd_quiescent) { 4 }
        else if (opcode == 2 || read_operation) && (lba >= 524288 || (if bulk { count < 1 || count > 2 || (count == 2 && lba == 524287) } else { count != 1 })) { 5 }
        else if opcode == 2 && (lba != loaded || loaded >= expected) { 5 }
        else if opcode == 4 && (loaded != expected || expected == 0 || !sd_quiescent) { 8 }
        else { 0 };
    reg(clk) replay reset(rst: false) = if state == 3 { duplicate } else { replay };
    reg(clk) save_reply reset(rst: false) = if state == 3 { format_ok && ordered && !same_key } else { save_reply };
    reg(clk) saved_status: uint<8> reset(rst: 0) = if state == 0 && request_length != 540 { 1 }
        else if state == 3 { status } else if state == 5 && memory_done && memory_error { 7 } else { saved_status };
    reg(clk) arm reset(rst: false) = if state == 4 && saved_status == 0 && !replay {
        if opcode == 4 { true } else if opcode == 1 || opcode == 5 { false } else { arm }
    } else { arm };
    reg(clk) session: uint<32> reset(rst: 0) = if state == 4 && opcode == 1 && saved_status == 0 && !replay { requested_session } else { session };
    reg(clk) expected: uint<32> reset(rst: 0) = if state == 4 && opcode == 1 && saved_status == 0 && !replay { count } else { expected };
    reg(clk) loaded: uint<32> reset(rst: 0) = if state == 4 && opcode == 1 && saved_status == 0 && !replay { 0 }
        else if state == 5 && memory_done && !memory_error && opcode == 2 { loaded +. 1 } else { loaded };
    reg(clk) cached reset(rst: false) = if state == 9 && save_reply { true } else { cached };
    reg(clk) next_sequence: uint<32> reset(rst: 1) = if state == 9 && save_reply { sequence +. 1 } else { next_sequence };
    reg(clk) last_sequence: uint<32> reset(rst: 0) = if state == 9 && save_reply { sequence } else { last_sequence };
    reg(clk) last_crc: uint<32> reset(rst: 0) = if state == 9 && save_reply { expected_crc } else { last_crc };
    reg(clk) state: uint<4> reset(rst: 0) = {
        if state == 0 && request { if request_length == 540 || request_length == 28 { 1 } else { 10 } }
        else if state == 1 { 2 }
        else if state == 2 { if index == input_length -. 1 { 3 } else { 1 } }
        else if state == 3 { 4 }
        else if state == 4 { if !replay && saved_status == 0 && (opcode == 2 || read_operation) { 5 } else { 6 } }
        else if state == 5 && memory_done { 6 }
        else if state == 6 { 11 }
        else if state == 11 { 7 }
        else if state == 7 { if index == response_length -. 1 { 9 } else { 6 } }
        else if state == 9 || state == 10 { 8 }
        else if state == 8 && !request { 0 }
        else { state }
    };
    reg(clk) index: uint<11> reset(rst: 0) = if state == 0 || state == 3 || state == 4 || state == 5 { 0 }
        else if state == 2 || state == 7 { index +. 1 } else { index };
    let reply_header: uint<192> = (header & 0xffffffffffffffffffffffffffffffff0000000000000000) |
        zext::<32, 192>(0x31414252) | (zext(opcode) << 32) | (zext(saved_status) << 40);
    decl out_byte;
    let cache: Memory<uint<8>, 2048> = inst clocked_memory(clk, [(state == 7 && save_reply && !replay, index, out_byte)]);
    reg(clk) cached_byte = inst read_memory(cache, index);
    reg(clk) reply_crc: uint<32> reset(rst: 0xffffffff) = if state != 6 && state != 7 && state != 11 { 0xffffffff }
        else if state == 7 && index < response_length -. 4 { crc32_byte(reply_crc, out_byte) } else { reply_crc };
    let selected_byte: uint<8> = if replay { cached_byte }
        else if index < 24 { trunc(reply_header >> (zext::<11, 192>(index) << 3)) }
        else if index < response_length -. 4 { if read_operation && saved_status == 0 { read_byte } else { 0 } }
        else { trunc((reply_crc ^ 0xffffffff) >> (zext::<11, 32>(index -. (response_length -. 4)) << 3)) };
    // Separate variable header-byte selection from the CRC feedback path.
    reg(clk) out_byte: uint<8> reset(rst: 0) = if state == 11 { selected_byte } else { out_byte };
    set request_address = &trunc(index);
    set reply_write = &(state == 7);
    set reply_address = &index;
    set reply_data = &out_byte;
    set reply_done = &(state == 9 || state == 10);
    set reply_length = &(if state == 10 { 0 } else { response_length });
    set memory_request = &(state == 5);
    set memory_write = &(opcode == 2);
    set memory_lba = &lba;
    set memory_count = &(if long_reply { 2 } else { 1 });
    set memory_write_data = &write_byte;
    set armed = &arm;
}
