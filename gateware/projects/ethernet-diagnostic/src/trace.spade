use shared_components::sd::crc16_bit;

// Passive SD-bus observation for bring-up without a serial console. This does
// not participate in card responses or DDR ownership, so it cannot change SD
// protocol behavior. Counters intentionally wrap at 32 bits.
#[no_mangle(all)]
pub entity sd_trace(
    clk: clock,
    rst: bool,
    armed: bool,
    initialized: bool,
    clock_tick: bool,
    command_frame: bool,
    command_valid: bool,
    command_index: uint<6>,
    command_argument: uint<32>,
    response: bool,
    response_complete: bool,
    protocol_status: uint<32>,
    response_payload: uint<32>,
    data_release: bool,
    h700_falling_phase: bool,
    h700_early_command: bool,
    cmd_pin: bool,
    data_pins: uint<4>,
    pin_response: uint<32>,
    pin_response_mismatch: uint<32>,
    pin_data: uint<32>,
    pin_data_mismatch: uint<32>,
    read_request: bool,
    read_lba: uint<32>,
    capture_lba: uint<32>,
    write_busy: bool,
    word_index: uint<6>,
    word: inv &uint<32>,
) {
    reg(clk) clock_edges: uint<32> reset(rst: 0) = if armed && clock_tick {
        clock_edges +. 1
    } else {
        clock_edges
    };

    // The SD frontend supplies its registered framing and CRC result, avoiding
    // a second command decoder solely for diagnostics.
    reg(clk) command_frames: uint<32> reset(rst: 0) = if command_frame {
        command_frames +. 1
    } else {
        command_frames
    };
    reg(clk) valid_commands: uint<32> reset(rst: 0) = if command_valid {
        valid_commands +. 1
    } else {
        valid_commands
    };
    reg(clk) invalid_frames: uint<32> reset(rst: 0) = if command_frame && !command_valid {
        invalid_frames +. 1
    } else {
        invalid_frames
    };
    reg(clk) last_command: uint<6> reset(rst: 0) = if command_valid {
        command_index
    } else {
        last_command
    };
    reg(clk) last_argument: uint<32> reset(rst: 0) = if command_valid {
        command_argument
    } else {
        last_argument
    };
    reg(clk) recent_commands: uint<48> reset(rst: 0) = if command_valid {
        (recent_commands << 6) | zext(command_index)
    } else {
        recent_commands
    };
    reg(clk) recent_arguments: uint<256> reset(rst: 0) = if command_valid {
        (recent_arguments << 32) | zext(command_argument)
    } else {
        recent_arguments
    };
    reg(clk) responses: uint<32> reset(rst: 0) = if response {
        responses +. 1
    } else {
        responses
    };
    reg(clk) completed_responses: uint<32> reset(rst: 0) = if response_complete {
        completed_responses +. 1
    } else {
        completed_responses
    };

    reg(clk) read_previous reset(rst: false) = read_request;
    let read_start = read_request && !read_previous;
    reg(clk) read_requests: uint<32> reset(rst: 0) = if read_start {
        read_requests +. 1
    } else {
        read_requests
    };
    reg(clk) last_read_lba: uint<32> reset(rst: 0) = if read_start {
        read_lba
    } else {
        last_read_lba
    };
    // Summarize completed multiblock transfers without retaining payload data.
    // Each word packs the 20-bit command argument and a saturating 12-bit
    // backend-block count. Four entries cover both SPL header/full reads and
    // the following payload header/full reads seen during H700 boot.
    reg(clk) multi_read_active reset(rst: false) = if command_valid && command_index == 18 {
        true
    } else if command_valid && command_index == 12 {
        false
    } else {
        multi_read_active
    };
    reg(clk) multi_read_lba: uint<20> reset(rst: 0) = if command_valid && command_index == 18 {
        trunc(command_argument)
    } else {
        multi_read_lba
    };
    reg(clk) multi_read_blocks: uint<12> reset(rst: 0) = if command_valid && command_index == 18 {
        0
    } else if read_start && multi_read_active && multi_read_blocks != 0xfff {
        multi_read_blocks +. 1
    } else {
        multi_read_blocks
    };
    let final_multi_read_blocks = if read_start && multi_read_blocks != 0xfff {
        multi_read_blocks +. 1
    } else {
        multi_read_blocks
    };
    let completed_multi_read: uint<32> = (zext(multi_read_lba) << 12) |
        zext(final_multi_read_blocks);
    reg(clk) recent_multi_reads: uint<128> reset(rst: 0) =
        if command_valid && command_index == 12 && multi_read_active {
            (recent_multi_reads << 32) | zext(completed_multi_read)
        } else {
            recent_multi_reads
        };
    reg(clk) write_previous reset(rst: false) = write_busy;
    reg(clk) writes: uint<32> reset(rst: 0) = if write_busy && !write_previous {
        writes +. 1
    } else {
        writes
    };

    // Capture the MMC width-switch transcript that determines whether U-Boot
    // changes its host controller to four-bit mode. This records responses,
    // rather than inferring host behavior from the card's local width state.
    let mmc_mode = protocol_status.to_bits()[12];
    let switch_error = response_payload.to_bits()[7];
    reg(clk) cmd6_count: uint<8> reset(rst || !armed: 0) =
        if command_valid && mmc_mode && command_index == 6 {
            cmd6_count +. 1
        } else { cmd6_count };
    reg(clk) cmd13_count: uint<8> reset(rst || !armed: 0) =
        if command_valid && mmc_mode && command_index == 13 {
            cmd13_count +. 1
        } else { cmd13_count };
    reg(clk) last_cmd6_argument: uint<32> reset(rst || !armed: 0) =
        if command_valid && mmc_mode && command_index == 6 {
            command_argument
        } else { last_cmd6_argument };
    reg(clk) last_cmd6_response: uint<32> reset(rst || !armed: 0) =
        if command_valid && mmc_mode && command_index == 6 {
            response_payload
        } else { last_cmd6_response };
    reg(clk) last_cmd13_response: uint<32> reset(rst || !armed: 0) =
        if command_valid && mmc_mode && command_index == 13 {
            response_payload
        } else { last_cmd13_response };
    reg(clk) saw_switch_error reset(rst || !armed: false) =
        if command_valid && mmc_mode && command_index == 13 && switch_error {
            true
        } else { saw_switch_error };

    // Independently find and capture the complete CMD9 R2 response from the
    // raw CMD input. This decoder does not use the response serializer's bit
    // counter, so a common off-by-one cannot make both sides agree.
    let R2_IDLE: uint<2> = 0;
    let R2_WAIT_START: uint<2> = 1;
    let R2_CAPTURE: uint<2> = 2;
    let R2_DONE: uint<2> = 3;
    decl r2_state;
    decl r2_count;
    let arm_r2 = command_valid && mmc_mode && command_index == 9 && r2_state == R2_IDLE;
    reg(clk) r2_state: uint<2> reset(rst || !armed: R2_IDLE) = {
        if arm_r2 {
            R2_WAIT_START
        } else if clock_tick && r2_state == R2_WAIT_START && !cmd_pin {
            R2_CAPTURE
        } else if clock_tick && r2_state == R2_CAPTURE && r2_count == 135 {
            R2_DONE
        } else {
            r2_state
        }
    };
    reg(clk) r2_count: uint<8> reset(rst || !armed: 0) = {
        if arm_r2 {
            0
        } else if clock_tick && r2_state == R2_WAIT_START && !cmd_pin {
            1
        } else if clock_tick && r2_state == R2_CAPTURE {
            r2_count +. 1
        } else {
            r2_count
        }
    };
    reg(clk) r2_bits: uint<136> reset(rst || !armed: 0) = {
        if arm_r2 {
            0
        } else if clock_tick && r2_state == R2_WAIT_START && !cmd_pin {
            0
        } else if clock_tick && r2_state == R2_CAPTURE {
            (r2_bits << 1) | (if cmd_pin { 1 } else { 0 })
        } else {
            r2_bits
        }
    };

    // Decode the first MMC CMD18 block directly from DAT0. Start detection,
    // payload indexing, and CRC accumulation are separate from the card
    // serializer. The first 32 bytes include the eGON length at offset 0x10.
    let BLOCK_IDLE: uint<3> = 0;
    let BLOCK_WAIT_START: uint<3> = 1;
    let BLOCK_PAYLOAD: uint<3> = 2;
    let BLOCK_CRC: uint<3> = 3;
    let BLOCK_END: uint<3> = 4;
    let BLOCK_DONE: uint<3> = 5;
    decl block_state;
    decl payload_bits;
    decl crc_bits;
    // The decoder used to arm on an MMC CMD18, which never fires on the SD
    // boot path, leaving every timestamp below dead. Arming on a backend read
    // of a chosen sector measures whichever stage that sector belongs to, in
    // either bus mode, and the stage the boot spends its time in is the kernel.
    let wide_bus = protocol_status.to_bits()[30];
    let lane_mask: uint<4> = if wide_bus { 15 } else { 1 };
    let data_pin = data_pins.to_bits()[0];
    let data_idle = (data_pins & lane_mask) == lane_mask;
    let payload_last: uint<13> = if wide_bus { 1023 } else { 4095 };
    let arm_block = read_request && read_lba == capture_lba &&
        block_state == BLOCK_IDLE;
    reg(clk) block_state: uint<3> reset(rst || !armed: BLOCK_IDLE) = {
        if arm_block {
            BLOCK_WAIT_START
        } else if clock_tick && block_state == BLOCK_WAIT_START && !data_idle {
            BLOCK_PAYLOAD
        } else if clock_tick && block_state == BLOCK_PAYLOAD &&
            payload_bits == payload_last {
            BLOCK_CRC
        } else if clock_tick && block_state == BLOCK_CRC && crc_bits == 15 {
            BLOCK_END
        } else if clock_tick && block_state == BLOCK_END {
            BLOCK_DONE
        } else {
            block_state
        }
    };
    // Record the sector that armed the capture rather than the command's
    // argument: the capture is now keyed to a backend read, and the host needs
    // to know which sector the bytes and CRC below describe.
    reg(clk) block_argument: uint<32> reset(rst || !armed: 0) =
        if arm_block { read_lba } else { block_argument };
    reg(clk) payload_bits: uint<13> reset(rst || !armed: 0) = {
        if arm_block {
            0
        } else if clock_tick && block_state == BLOCK_PAYLOAD {
            payload_bits +. 1
        } else {
            payload_bits
        }
    };
    reg(clk) crc_bits: uint<5> reset(rst || !armed: 0) = {
        if arm_block {
            0
        } else if clock_tick && block_state == BLOCK_CRC {
            crc_bits +. 1
        } else {
            crc_bits
        }
    };
    reg(clk) payload_prefix: uint<256> reset(rst || !armed: 0) = {
        if arm_block {
            0
        } else if clock_tick && block_state == BLOCK_PAYLOAD &&
            payload_bits < (if wide_bus { 64 } else { 256 }) {
            if wide_bus {
                (payload_prefix << 4) | zext(data_pins)
            } else {
                (payload_prefix << 1) | (if data_pin { 1 } else { 0 })
            }
        } else {
            payload_prefix
        }
    };
    // In four-bit mode each lane carries its own CRC16 over its own bits, so
    // following lane zero through both the payload and the CRC window checks a
    // quarter of the block against the quarter of the CRC that covers it.
    reg(clk) calculated_crc: uint<16> reset(rst || !armed: 0) = {
        if arm_block {
            0
        } else if clock_tick && block_state == BLOCK_PAYLOAD {
            crc16_bit(calculated_crc, data_pin)
        } else {
            calculated_crc
        }
    };
    reg(clk) received_crc: uint<16> reset(rst || !armed: 0) = {
        if arm_block {
            0
        } else if clock_tick && block_state == BLOCK_CRC {
            (received_crc << 1) | (if data_pin { 1 } else { 0 })
        } else {
            received_crc
        }
    };
    reg(clk) observed_end_bit reset(rst || !armed: false) =
        if arm_block { false }
        else if clock_tick && block_state == BLOCK_END { data_pin }
        else { observed_end_bit };

    // Fabric timestamps and external-edge counts make a repeated stop
    // boundary measurable without assuming the advertised card frequency.
    reg(clk) timestamp: uint<32> reset(rst || !armed: 0) = timestamp +. 1;
    reg(clk) selected_edges: uint<32> reset(rst || !armed: 0) =
        if arm_block { 0 }
        else if clock_tick && block_state != BLOCK_IDLE && block_state != BLOCK_DONE {
            selected_edges +. 1
        } else { selected_edges };
    reg(clk) cmd18_timestamp: uint<32> reset(rst || !armed: 0) =
        if arm_block { timestamp } else { cmd18_timestamp };
    reg(clk) response_end_timestamp: uint<32> reset(rst || !armed: 0) =
        if response_complete && block_state == BLOCK_WAIT_START { timestamp }
        else { response_end_timestamp };
    reg(clk) data_start_timestamp: uint<32> reset(rst || !armed: 0) =
        if clock_tick && block_state == BLOCK_WAIT_START && !data_idle { timestamp }
        else { data_start_timestamp };
    reg(clk) data_start_edge: uint<32> reset(rst || !armed: 0) =
        if clock_tick && block_state == BLOCK_WAIT_START && !data_idle { selected_edges }
        else { data_start_edge };
    reg(clk) block_end_timestamp: uint<32> reset(rst || !armed: 0) =
        if clock_tick && block_state == BLOCK_END { timestamp }
        else { block_end_timestamp };
    reg(clk) block_end_edge: uint<32> reset(rst || !armed: 0) =
        if clock_tick && block_state == BLOCK_END { selected_edges }
        else { block_end_edge };
    reg(clk) cmd12_timestamp: uint<32> reset(rst || !armed: 0) =
        if command_valid && command_index == 12 && block_state != BLOCK_IDLE {
            timestamp
        } else { cmd12_timestamp };
    reg(clk) data_release_timestamp: uint<32> reset(rst || !armed: 0) =
        if data_release && block_state != BLOCK_IDLE {
            timestamp
        } else { data_release_timestamp };
    reg(clk) previous_tick: uint<32> reset(rst || !armed: 0) =
        if arm_block { 0 }
        else if clock_tick && block_state != BLOCK_IDLE && block_state != BLOCK_DONE {
            timestamp
        } else { previous_tick };
    let tick_period: uint<16> = trunc(timestamp - previous_tick);
    reg(clk) minimum_tick_period: uint<16> reset(rst || !armed: 0xffff) =
        if arm_block { 0xffff }
        else if clock_tick && previous_tick != 0 && tick_period < minimum_tick_period {
            tick_period
        } else { minimum_tick_period };
    reg(clk) maximum_tick_period: uint<16> reset(rst || !armed: 0) =
        if arm_block { 0 }
        else if clock_tick && previous_tick != 0 && tick_period > maximum_tick_period {
            tick_period
        } else { maximum_tick_period };

    let armed_flag: uint<32> = if armed { 1 } else { 0 };
    let initialized_flag: uint<32> = if initialized { 2 } else { 0 };
    let clock_flag: uint<32> = if clock_tick { 4 } else { 0 };
    let command_flag: uint<32> = if command_frame { 8 } else { 0 };
    let write_flag: uint<32> = if write_busy { 16 } else { 0 };
    let read_flag: uint<32> = if read_request { 32 } else { 0 };
    let flags: uint<32> = armed_flag | initialized_flag | clock_flag |
        command_flag | write_flag | read_flag;
    let enhanced_magic: uint<32> = 0x32435453;
    let switch_summary: uint<32> = zext(cmd6_count) |
        (zext(cmd13_count) << 8) |
        (if saw_switch_error { 1 << 16 } else { 0 }) |
        (if h700_falling_phase { 1 << 17 } else { 0 }) |
        (if h700_early_command { 1 << 18 } else { 0 });
    let r2_summary: uint<32> = zext(r2_count) | (zext(r2_state) << 8);
    let block_summary: uint<32> = zext(block_state) |
        (if observed_end_bit { 1 << 3 } else { 0 }) |
        (if calculated_crc == received_crc { 1 << 4 } else { 0 }) |
        (zext(payload_bits) << 8);
    let crc_summary: uint<32> = zext(calculated_crc) | (zext(received_crc) << 16);
    let period_summary: uint<32> = zext(minimum_tick_period) |
        (zext(maximum_tick_period) << 16);
    let captured_edge_span: uint<32> = block_end_edge -. data_start_edge;
    // Register one requested word so the diagnostic readout cannot add a wide
    // combinational path to the timing-sensitive network reply datapath.
    reg(clk) selected_word: uint<32> reset(rst: 0) = match word_index {
        0 => 0x31544453,
        1 => flags,
        2 => clock_edges,
        3 => command_frames,
        4 => valid_commands,
        5 => invalid_frames,
        6 => zext(last_command),
        7 => last_argument,
        8 => read_requests,
        9 => last_read_lba,
        10 => writes,
        11 => responses,
        12 => zext(trunc::<uint<48>, uint<24>>(recent_commands)),
        13 => completed_responses,
        14 => protocol_status,
        15 => pin_response,
        16 => pin_data,
        17 => pin_data_mismatch,
        18 => zext(trunc::<uint<48>, uint<24>>(recent_commands >> 24)),
        19 => trunc::<uint<256>, uint<32>>(recent_arguments >> 224),
        20 => trunc::<uint<256>, uint<32>>(recent_arguments >> 192),
        21 => trunc::<uint<256>, uint<32>>(recent_arguments >> 160),
        22 => trunc::<uint<256>, uint<32>>(recent_arguments >> 128),
        23 => trunc::<uint<256>, uint<32>>(recent_arguments >> 96),
        24 => trunc::<uint<256>, uint<32>>(recent_arguments >> 64),
        25 => trunc::<uint<256>, uint<32>>(recent_arguments >> 32),
        26 => trunc::<uint<256>, uint<32>>(recent_arguments),
        27 => trunc::<uint<128>, uint<32>>(recent_multi_reads >> 96),
        28 => trunc::<uint<128>, uint<32>>(recent_multi_reads >> 64),
        29 => trunc::<uint<128>, uint<32>>(recent_multi_reads >> 32),
        30 => trunc::<uint<128>, uint<32>>(recent_multi_reads),
        31 => pin_response_mismatch,
        32 => enhanced_magic,
        33 => switch_summary,
        34 => last_cmd6_argument,
        35 => last_cmd6_response,
        36 => last_cmd13_response,
        37 => r2_summary,
        38 => zext(trunc::<uint<136>, uint<8>>(r2_bits >> 128)),
        39 => trunc::<uint<136>, uint<32>>(r2_bits >> 96),
        40 => trunc::<uint<136>, uint<32>>(r2_bits >> 64),
        41 => trunc::<uint<136>, uint<32>>(r2_bits >> 32),
        42 => trunc::<uint<136>, uint<32>>(r2_bits),
        43 => block_summary,
        44 => block_argument,
        45 => crc_summary,
        46 => period_summary,
        47 => captured_edge_span,
        48 => trunc::<uint<256>, uint<32>>(payload_prefix >> 224),
        49 => trunc::<uint<256>, uint<32>>(payload_prefix >> 192),
        50 => trunc::<uint<256>, uint<32>>(payload_prefix >> 160),
        51 => trunc::<uint<256>, uint<32>>(payload_prefix >> 128),
        52 => trunc::<uint<256>, uint<32>>(payload_prefix >> 96),
        53 => trunc::<uint<256>, uint<32>>(payload_prefix >> 64),
        54 => trunc::<uint<256>, uint<32>>(payload_prefix >> 32),
        55 => trunc::<uint<256>, uint<32>>(payload_prefix),
        56 => cmd18_timestamp,
        57 => response_end_timestamp,
        58 => data_start_timestamp,
        59 => block_end_timestamp,
        60 => cmd12_timestamp,
        61 => data_release_timestamp,
        62 => data_start_edge,
        63 => block_end_edge,
        _ => 0,
    };
    set word = &selected_word;
}
