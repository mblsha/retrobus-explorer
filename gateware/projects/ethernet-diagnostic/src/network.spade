use std::mem::{clocked_memory, read_memory};

fn add16(a: uint<16>, b: uint<16>) -> uint<16> {
    let sum: uint<17> = zext(a) +. zext(b);
    trunc(sum) +. (if sum.to_bits()[16] { 1 } else { 0 })
}

// Fixed IPv4 address 192.168.10.2, MAC 02:00:00:00:00:01, UDP port 4000.
// Whole Ethernet frames must already have passed MAC length/FCS validation.
// No backend request is made until all network headers/checksums validate.
#[no_mangle(all)]
pub entity network_engine(
    clk: clock,
    rst: bool,
    rx_available: bool,
    rx_length: uint<11>,
    rx_address: inv &uint<11>,
    rx_data: uint<8>,
    rx_consume: inv &bool,
    tx_ready: bool,
    tx_write: inv &bool,
    tx_address: inv &uint<11>,
    tx_data: inv &uint<8>,
    tx_submit: inv &bool,
    tx_length: inv &uint<11>,
    app_request: inv &bool,
    app_request_length: inv &uint<11>,
    app_address: uint<10>,
    app_data: inv &uint<8>,
    app_write: bool,
    app_write_address: uint<11>,
    app_write_data: uint<8>,
    app_done: bool,
    app_length: uint<11>,
) {
    decl state, index, kind, output_length;
    let capture = state == 2;
    reg(clk) saved_length: uint<11> reset(rst: 0) = if state == 0 { rx_length } else { saved_length };
    reg(clk) header: uint<336> reset(rst: 0) = if capture && index < 42 { (header << 8) | zext(rx_data) } else { header };
    reg(clk) ip_length: uint<16> reset(rst: 0) = if capture && (index == 16 || index == 17) { (ip_length << 8) | zext(rx_data) } else { ip_length };
    reg(clk) high: uint<8> reset(rst: 0) = if capture { rx_data } else { high };
    let pair: uint<16> = (zext(high) << 8) | zext(rx_data);
    reg(clk) ip_sum: uint<16> reset(rst: 0) = if state == 0 { 0 }
        else if capture && index >= 14 && index < 34 && index.to_bits()[0] { add16(ip_sum, pair) } else { ip_sum };
    reg(clk) transport_sum: uint<16> reset(rst: 0) = if state == 0 { 0 }
        else if capture && index >= 34 && zext::<11, 16>(index) < ip_length +. 14 {
            if index.to_bits()[0] { add16(transport_sum, pair) }
            else if zext::<11, 16>(index) == ip_length +. 13 { add16(transport_sum, zext(rx_data) << 8) }
            else { transport_sum }
        } else { transport_sum };
    let packet: Memory<uint<8>, 2048> = inst clocked_memory(clk, [(capture, index, rx_data)]);
    reg(clk) packet_data = inst read_memory(packet, if state == 4 { zext(app_address) +. 42 } else { index });
    let response: Memory<uint<8>, 2048> = inst clocked_memory(clk, [(state == 4 && app_write, app_write_address, app_write_data)]);
    reg(clk) response_data = inst read_memory(response, trunc(index -. 42));
    let destination: uint<48> = trunc(header >> 288);
    let source: uint<48> = trunc(header >> 240);
    let ethertype: uint<16> = trunc(header >> 224);
    let source_ip: uint<32> = trunc(header >> 96);
    let target_ip: uint<32> = trunc(header >> 64);
    let protocol: uint<8> = trunc(header >> 144);
    let fragment: uint<16> = trunc(header >> 160);
    let udp_length: uint<16> = trunc(header >> 16);
    let udp_checksum: uint<16> = trunc(header);
    // Header fields settle while the rest of the frame is captured. Pipeline
    // end-around-carry additions instead of cascading an entire checksum.
    reg(clk) source_sum: uint<16> reset(rst: 0) = add16(trunc(source_ip >> 16), trunc(source_ip));
    reg(clk) target_sum: uint<16> reset(rst: 0) = add16(trunc(target_ip >> 16), trunc(target_ip));
    reg(clk) address_sum: uint<16> reset(rst: 0) = add16(source_sum, target_sum);
    reg(clk) length_sum: uint<16> reset(rst: 0) = add16(17, udp_length);
    reg(clk) pseudo: uint<16> reset(rst: 0) = add16(address_sum, length_sum);
    let ethernet_ok = destination == 0x020000000001 || destination == 0xffffffffffff;
    reg(clk) arp_ok reset(rst: false) = ethernet_ok && saved_length >= 42 && ethertype == 0x0806 &&
        trunc::<uint<336>, uint<64>>(header >> 160) == 0x0001080006040001 &&
        trunc::<uint<336>, uint<32>>(header) == 0xc0a80a02 && trunc::<uint<336>, uint<48>>(header >> 112) == source;
    // The length fields settle long before end-of-frame validation.
    reg(clk) frame_end: uint<16> reset(rst: 0) = ip_length +. 14;
    reg(clk) length_fits reset(rst: false) = zext::<11, 16>(saved_length) >= frame_end;
    reg(clk) ipv4_ok reset(rst: false) = destination == 0x020000000001 && ethertype == 0x0800 &&
        trunc::<uint<336>, uint<8>>(header >> 216) == 0x45 && ip_length >= 28 && ip_length <= 1500 &&
        length_fits && ip_sum == 0xffff &&
        (fragment & 0xbfff) == 0 && trunc::<uint<336>, uint<8>>(header >> 152) != 0 && target_ip == 0xc0a80a02;
    reg(clk) echo_ok reset(rst: false) = ipv4_ok && protocol == 1 && trunc::<uint<336>, uint<16>>(header >> 48) == 0x0800 && transport_sum == 0xffff;
    reg(clk) udp_shape_ok reset(rst: false) = protocol == 17 && udp_length >= 8 && udp_length <= 1480 &&
        udp_length == ip_length -. 20 && trunc::<uint<336>, uint<16>>(header >> 32) == 4000;
    reg(clk) udp_integrity_ok reset(rst: false) = udp_checksum == 0 || add16(transport_sum, pseudo) == 0xffff;
    let udp_ok = ipv4_ok && udp_shape_ok && udp_integrity_ok;
    reg(clk) kind: uint<2> reset(rst: 0) = if state == 3 { if arp_ok { 1 } else if echo_ok { 2 } else { 3 } } else { kind };
    reg(clk) reply_payload_length: uint<11> reset(rst: 0) = if state == 4 && app_done { app_length } else { reply_payload_length };
    reg(clk) output_length: uint<11> reset(rst: 0) = if state == 3 {
        if arp_ok { 42 } else { trunc(ip_length) +. 14 }
    } else if state == 4 && app_done { app_length +. 42 } else { output_length };
    reg(clk) state: uint<4> reset(rst: 0) = {
        if state == 0 && rx_available && tx_ready { if rx_length >= 42 && rx_length <= 1514 { 1 } else { 8 } }
        else if state == 1 { 2 }
        else if state == 2 { if index +. 1 == saved_length { 9 } else { 1 } }
        // Allow registered IP and packet-kind checks to settle after the
        // final captured byte, before exposing any application request.
        else if state == 9 { 10 }
        else if state == 10 { 3 }
        else if state == 3 { if arp_ok || echo_ok { 5 } else if udp_ok { 4 } else { 8 } }
        else if state == 4 && app_done { if app_length <= 1472 { 5 } else { 8 } }
        else if state == 5 { 6 }
        else if state == 6 { if index +. 1 == output_length { 7 } else { 5 } }
        else if state == 7 || state == 8 { 0 }
        else { state }
    };
    reg(clk) index: uint<11> reset(rst: 0) = if state == 0 || state == 3 || state == 4 { 0 }
        else if state == 2 || state == 6 { index +. 1 } else { index };
    let reply_target_ip: uint<32> = if kind == 1 { trunc(header >> 80) } else { source_ip };
    let ethernet: uint<112> = (zext(source) << 64) | (zext::<48, 112>(0x020000000001) << 16) | (if kind == 1 { 0x0806 } else { 0x0800 });
    let arp: uint<224> = (zext::<64, 224>(0x0001080006040002) << 160) | (zext::<48, 224>(0x020000000001) << 112) |
        (zext::<32, 224>(0xc0a80a02) << 80) | (zext(source) << 32) | zext(reply_target_ip);
    let reply_ip_length: uint<16> = if kind == 2 { ip_length } else { zext(reply_payload_length) +. 28 };
    let reply_protocol: uint<16> = if kind == 2 { 0x4001 } else { 0x4011 };
    // At least 28 cycles of Ethernet header emission precede the IP header.
    reg(clk) ip_base_sum: uint<16> reset(rst: 0) = add16(0x4500, reply_ip_length);
    reg(clk) ip_protocol_sum: uint<16> reset(rst: 0) = add16(reply_protocol, 0xc0a8);
    reg(clk) ip_target_sum: uint<16> reset(rst: 0) = add16(trunc(reply_target_ip >> 16), trunc(reply_target_ip));
    reg(clk) ip_address_sum: uint<16> reset(rst: 0) = add16(ip_target_sum, 0x0a02);
    reg(clk) ip_header_sum: uint<16> reset(rst: 0) = add16(ip_base_sum, ip_protocol_sum);
    reg(clk) ip_checksum: uint<16> reset(rst: 0) = 0xffff ^ add16(ip_header_sum, ip_address_sum);
    let ip_header: uint<160> = (zext::<16, 160>(0x4500) << 144) | (zext(reply_ip_length) << 128) |
        (zext(reply_protocol) << 80) | (zext(ip_checksum) << 64) | (zext::<32, 160>(0xc0a80a02) << 32) | zext(reply_target_ip);
    let udp_header: uint<64> = (zext::<16, 64>(4000) << 48) | (zext::<16, 64>(trunc(header >> 48)) << 32) | (zext::<11, 64>(reply_payload_length +. 8) << 16);
    let echo_checksum = add16(trunc::<uint<336>, uint<16>>(header >> 32), 0x0800);
    let byte: uint<8> = if index < 14 { trunc(ethernet >> (zext::<11, 112>(13 -. index) << 3)) }
        else if kind == 1 { trunc(arp >> (zext::<11, 224>(41 -. index) << 3)) }
        else if index < 34 { trunc(ip_header >> (zext::<11, 160>(33 -. index) << 3)) }
        else if kind == 2 {
            if index == 34 || index == 35 { 0 } else if index == 36 { trunc(echo_checksum >> 8) }
            else if index == 37 { trunc(echo_checksum) } else { packet_data }
        } else if index < 42 { trunc(udp_header >> (zext::<11, 64>(41 -. index) << 3)) }
        else { response_data };
    set rx_address = &index;
    set rx_consume = &(state == 7 || state == 8);
    set tx_write = &(state == 6);
    set tx_address = &index;
    set tx_data = &byte;
    set tx_submit = &(state == 7);
    set tx_length = &output_length;
    set app_request = &(state == 4);
    set app_request_length = &trunc(udp_length -. 8);
    set app_data = &packet_data;
}
