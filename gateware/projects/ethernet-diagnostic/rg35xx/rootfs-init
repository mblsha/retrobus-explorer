#!/bin/sh
# PID 1 on the EROFS system partition. There is no initramfs: the kernel mounts
# this filesystem directly from the card, so this script is what booti's kernel
# reaches without any intermediate root.

BB=/usr/bin/busybox
PATH=/usr/bin:/usr/sbin
export PATH

$BB mkdir -p /proc /sys /tmp /data
# DEVTMPFS_MOUNT gives us /dev before init runs, which is why the debug
# partition can be opened immediately rather than waited for.
$BB mount -t proc proc /proc 2>/dev/null || true
$BB mount -t sysfs sysfs /sys 2>/dev/null || true
$BB mount -t tmpfs tmpfs /tmp 2>/dev/null || true
exec </dev/console >/dev/console 2>&1

# Filled in by build_rootfs.py from the image layout; an unrendered
# placeholder is refused rather than shipped.
DEBUG_DEVICE=@DEBUG_DEVICE@
DATA_DEVICE=@DATA_DEVICE@
MAGIC=@MAGIC@

# U-Boot owns the sectors below @USERSPACE_BASE@; these start there so both
# records survive a boot and can be read back together.
write_stage() {
    stage="$1"
    detail="$2"
    record=/tmp/boot-stage
    {
        $BB printf '%s\n' "$MAGIC"
        $BB printf 'direction=target-to-host\n'
        $BB printf 'stage=%s\n' "$stage"
        $BB printf 'detail=%s\n' "$detail"
        $BB printf 'uptime=%s\n' "$($BB cut -d' ' -f1 /proc/uptime 2>/dev/null)"
    } > "$record"
    $BB dd if="$record" of="$DEBUG_DEVICE" bs=512 seek=$((@USERSPACE_BASE@ + stage)) \
        count=1 conv=sync,notrunc 2>/dev/null
    $BB sync
}

# The very first thing, so the timestamp measures reaching userspace and
# nothing else. Every Linux write is at least a page, so this lands as a
# multi-block command and is distinguishable from U-Boot's single-block ones.
write_stage 0 rootfs-init-entered

# A flight recorder. There is no serial console on this board, so the tail of
# the kernel log is copied to its own page of the debug partition several times
# a second and read back afterwards with `image --kernel-log`. It starts after
# the first milestone so it cannot delay it. It reports everything except the
# one failure that takes the card link down with it.
snapshot_kernel_log() {
    $BB dmesg | $BB tail -c @KERNEL_LOG_BYTES@ > /tmp/kernel-log
    $BB dd if=/tmp/kernel-log of="$DEBUG_DEVICE" bs=512 seek=@KERNEL_LOG_SECTOR@ \
        count=@KERNEL_LOG_SECTORS@ conv=sync,notrunc 2>/dev/null
    $BB sync
}
record_kernel_log() {
    while true; do
        snapshot_kernel_log
        $BB sleep 0.1
    done
}
record_kernel_log &
recorder=$!

$BB printf '\033[2J\033[H'
echo 'RG35XX Plus bare Linux: EROFS system partition, no initramfs'

root_device="$($BB sed -n 's/.*[ ]root=\([^ ]*\).*/\1/p' /proc/cmdline)"
echo "Root: ${root_device:-unknown} $($BB grep -o ' / .*erofs[^ ]*' /proc/mounts | $BB head -n 1)"
write_stage 1 "root-${root_device:-unknown}"

command="$($BB dd if="$DEBUG_DEVICE" bs=512 count=1 2>/dev/null | $BB tr '\000' '\n' | $BB sed -n 's/^command=//p' | $BB head -n 1)"
[ -n "$command" ] || command=boot-shell
# A sweep has to get its results out, and the link has been seen to die within
# a tenth of a second of the panel coming up. So the backlight's level is noted
# and the whole display pipeline put to sleep before anything more is written.
display_sleeps() {
    echo 4 > /sys/class/graphics/fb0/blank 2>/dev/null
}
display_wakes() {
    echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null
}
if [ "$command" = display-sweep ] || [ "$command" = job-runner ]; then
    for backlight in /sys/class/backlight/*; do
        [ -e "$backlight/brightness" ] && initial_brightness="$($BB cat "$backlight/brightness")"
    done
    display_sleeps
fi
write_stage 2 "command-$command"

model="$($BB tr -d '\000' </proc/device-tree/model 2>/dev/null)"
echo "Model: ${model:-unknown}"
write_stage 3 "model-${model:-unknown}"

if $BB mount -t ext2 -o rw,noatime "$DATA_DEVICE" /data 2>/dev/null; then
    echo "Data: $DATA_DEVICE mounted read-write on /data"
    write_stage 4 data-mounted
else
    echo "Data: $DATA_DEVICE did not mount"
    write_stage 4 data-absent
fi

# The panel is brought up by the kernel, not from here. Its driver is built in
# and so is its init sequence, so it binds at the first probe, about 0.4 s in,
# and the framebuffer follows. All that is left to do here is wait for it.
polls=0
while [ ! -c /dev/fb0 ] && [ "$polls" -lt 60 ]; do
    $BB sleep 0.05
    polls=$((polls + 1))
done
# A sweep sets its own levels, and a job run leaves the panel dark until a job
# asks for it: the backlight is the largest single item on this board's supply
# and every measurement made with it lit is measuring the backlight.
if [ "$command" != display-sweep ] && [ "$command" != job-runner ]; then
    for backlight in /sys/class/backlight/*; do
        [ -e "$backlight/max_brightness" ] && $BB cat "$backlight/max_brightness" > "$backlight/brightness" 2>/dev/null
    done
fi

if [ -c /dev/fb0 ]; then
    geometry="$($BB cat /sys/class/graphics/fb0/virtual_size 2>/dev/null)"
    depth="$($BB cat /sys/class/graphics/fb0/bits_per_pixel 2>/dev/null)"
    write_stage 5 "framebuffer-present ${geometry} ${depth}bpp polls-${polls}"
else
    write_stage 5 framebuffer-absent
fi

# A host command that measures, with nobody watching, what the display does to
# the card link. It goes through a series of display states and in each one does
# the same work, 25 rewrites of the recorder's page and 256 KiB read back past
# the page cache, and counts the errors the MMC driver logged meanwhile. The
# recorder is stopped first so that the only traffic is the sweep's own. Every
# record is written with the display asleep, and one is written before a state
# is entered as well as after, so that a state that kills the link is named by
# the record before it rather than lost with its own. The series ends where it
# began, asleep, to tell the display from the passage of time.
# Only the controller's own complaints: the log also says "error" about a
# wireless firmware it cannot find and an SDIO probe of a card that is not one.
mmc_errors() {
    $BB dmesg | $BB grep -c 'sunxi-mmc .*\(error\|failed\)'
}
display_sweep() {
    kill "$recorder" 2>/dev/null
    backlight="$($BB ls -d /sys/class/backlight/* 2>/dev/null | $BB head -n 1)"
    if [ -z "$backlight" ]; then
        write_stage 6 display-sweep-no-backlight
        return
    fi
    max="$($BB cat "$backlight/max_brightness")"
    results="display-sweep initial-${initial_brightness} max-$max"
    snapshot_kernel_log
    for state in asleep lit-0 lit-100 lit-50 asleep; do
        write_stage 6 "$results ${state}=entered"
        case "$state" in
            lit-*)
                echo $((max * ${state#lit-} / 100)) > "$backlight/brightness"
                display_wakes
                ;;
        esac
        $BB sleep 0.5
        dpms="$($BB cat /sys/class/drm/card*-*/dpms 2>/dev/null | $BB head -n 1)"
        before="$(mmc_errors)"
        writes=0
        while [ "$writes" -lt 25 ]; do
            $BB dd if=/tmp/kernel-log of="$DEBUG_DEVICE" bs=512 seek=@KERNEL_LOG_SECTOR@ \
                count=@KERNEL_LOG_SECTORS@ conv=sync,notrunc 2>/dev/null
            $BB sync
            writes=$((writes + 1))
        done
        written="$(mmc_errors)"
        echo 3 > /proc/sys/vm/drop_caches
        $BB dd if="$DATA_DEVICE" of=/dev/null bs=4096 count=64 2>/dev/null
        read_back="$(mmc_errors)"
        display_sleeps
        $BB sleep 0.2
        results="$results ${state}=w$((written - before))r$((read_back - written))/${dpms:-unknown}"
        write_stage 6 "$results"
    done
    write_stage 6 "$results done"
    record_kernel_log &
}

# The host command that turns this boot into a bench instrument. Everything the
# runner needs is copied into tmpfs first, because the host disarms the card
# frontend to exchange a job for a result and a runner that had to page its own
# shell back in from a card that is not there would wedge rather than wait.
# The flight recorder is stopped for the same reason: ten card writes a second
# leave no window to disarm in, and they would be most of the current an idle
# target draws. The runner snapshots the log once per result instead.
job_runner() {
    kill "$recorder" 2>/dev/null
    $BB cp "$BB" /tmp/busybox
    $BB chmod 0755 /tmp/busybox
    $BB cp /usr/bin/job-runner /tmp/job-runner
    write_stage 6 job-runner-starting
    exec /tmp/busybox sh /tmp/job-runner
}

case "$command" in
    display-sweep) display_sweep ;;
    job-runner) job_runner ;;
    poweroff) write_stage 6 command-poweroff; exec $BB poweroff -f ;;
    reboot)   write_stage 6 command-reboot;   exec $BB reboot -f ;;
    boot-shell|shell) ;;
    *) echo "Unknown debug command: $command"; write_stage 6 unknown-command ;;
esac

write_stage 7 userspace-ready
echo ''
echo 'Userspace is ready on a read-only EROFS root.'
echo 'U-Boot milestones are in raw partition 2, sectors 1..15.'
echo 'Userspace milestones are in the same partition, sectors 16..31.'
echo 'The host command is in sector 0.'

# Drawn last, after everything that prints, so the console does not write over
# it; the cursor is hidden because its blink would keep redrawing one cell.
if [ -c /dev/fb0 ]; then
    $BB printf '\033[2J\033[H\033[?25l'
    $BB fbsplash -s /usr/share/rg35xx/display-proof.ppm -d /dev/fb0
    drawn=$?
    # Read back what the panel is scanning out, so that whether the picture got
    # there can be checked with nobody looking: 300 blocks of 4096 bytes is
    # exactly 640x480 at four bytes a pixel, and display_proof.py --expect
    # prints what this has to be.
    fb_md5="$($BB dd if=/dev/fb0 bs=4096 count=300 2>/dev/null | $BB md5sum | $BB cut -c1-16)"
    write_stage 5 "framebuffer-present ${geometry} ${depth}bpp polls-${polls} fbsplash-${drawn} fb-md5-${fb_md5} stride-$($BB cat /sys/class/graphics/fb0/stride 2>/dev/null) backlight-$($BB cat /sys/class/backlight/*/brightness 2>/dev/null | $BB head -n 1)"
fi

while true; do
    setsid $BB cttyhack $BB sh
    echo 'Shell exited; restarting in one second.'
    $BB sleep 1
done
