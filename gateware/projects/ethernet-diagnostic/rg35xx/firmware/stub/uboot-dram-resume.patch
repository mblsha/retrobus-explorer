Subject: [PATCH] sunxi: h616: a resume path for U-Boot's DRAM driver

Applied inside the build container to a copy of
arch/arm/mach-sunxi/dram_sun50i_h616.c taken from the pinned U-Boot tree, and
only to the copy that is compiled into our SRAM suspend stub. The bootloader's
own driver is never touched by it. The file is GPL-2.0-or-later and so, for
that reason, is everything in rg35xx/firmware/stub/.

The driver is written to bring an H616's memory up from cold. Four things have
to change for it to bring back memory that has been refreshing itself:

  - the cold SDRAM initialisation has to be skipped, or the contents are lost.
    INIT0 bits 31:30 are uMCTL2's skip_dram_init field.
  - the two polls in mctl_phy_read_calibration() that are written as a `while`
    with no way out need a deadline, because in a stub with no console a hang
    leaves nothing at all behind. Every other wait in the driver goes through
    mctl_await_completion(), which the stub supplies and bounds itself.
  - there has to be an entry point that takes the geometry the stub read back
    out of the controller instead of detecting it, because detection writes
    patterns over the memory the suspend exists to keep. It goes in this file
    because the parameter table and the master priorities are static to it.
  - the DRAM pad hold, on the builds that take it on the way down, has to be
    released before the controller is told to leave self-refresh.

The markers are the rest of it. There is no serial console on this board, so
the rebuild records where it has got to in an RTC general purpose register at
each step; those registers are in the always-on domain and survive the
watchdog reset that a hang in the stub turns into. 0x30 to 0x3a, in the order
they are reached.

The idea of rebuilding the controller and the PHY this way on resume is
kailashrs' work for ROCKNIX --
https://github.com/kailashrs/H700_rocknix_enhancement and
https://github.com/ROCKNIX/distribution/pull/3316 -- whose stub patches the
same driver for the same four reasons. This patch is ours.

--- a/dram_sun50i_h616.c
+++ b/dram_sun50i_h616.c
@@ -392,7 +392,9 @@
 	else
 		val = 3;
 
-	while ((readl(SUNXI_DRAM_PHY0_BASE + 0x184) & val) != val) {
+	for (u64 deadline = stub_deadline(1000000);
+	     (readl(SUNXI_DRAM_PHY0_BASE + 0x184) & val) != val &&
+	     !stub_overdue(deadline, SUNXI_DRAM_PHY0_BASE + 0x184); ) {
 		if (readl(SUNXI_DRAM_PHY0_BASE + 0x184) & 0x20) {
 			result = false;
 			break;
@@ -408,7 +410,9 @@
 
 		setbits_le32(SUNXI_DRAM_PHY0_BASE + 8, 1);
 
-		while ((readl(SUNXI_DRAM_PHY0_BASE + 0x184) & val) != val) {
+		for (u64 deadline = stub_deadline(1000000);
+		     (readl(SUNXI_DRAM_PHY0_BASE + 0x184) & val) != val &&
+		     !stub_overdue(deadline, SUNXI_DRAM_PHY0_BASE + 0x184); ) {
 			if (readl(SUNXI_DRAM_PHY0_BASE + 0x184) & 0x20) {
 				result = false;
 				break;
@@ -1038,11 +1042,19 @@
 	mctl_await_completion(&mctl_ctl->dfistat, 1, 1);
 	writel(0, &mctl_ctl->swctl);
 	clrbits_le32(&mctl_ctl->dfimisc, 0x20);
+
+	/*
+	 * Resume: let go of the DRAM pads, if they were held on the way down,
+	 * before the controller is told to leave self-refresh.
+	 */
+	if (sunxi_dram_pad_hold)
+		setbits_le32(SUNXI_RTC_BASE + 0x1f4, BIT(0));
 
 	clrbits_le32(&mctl_ctl->pwrctl, 0x20);
 	writel(1, &mctl_ctl->swctl);
 	mctl_await_completion(&mctl_ctl->swstat, 1, 1);
 	mctl_await_completion(&mctl_ctl->statr, 3, 1);
+	stub_mark(0x33);
 
 	udelay(200);
 
@@ -1150,6 +1162,7 @@
 	clrbits_le32(&mctl_ctl->rfshctl3, 1);
 	writel(1, &mctl_ctl->swctl);
 
+	stub_mark(0x34);
 	if (para->tpr10 & TPR10_WRITE_LEVELING) {
 		for (i = 0; i < 5; i++)
 			if (mctl_phy_write_leveling(para, config))
@@ -1160,6 +1173,7 @@
 		}
 	}
 
+	stub_mark(0x35);
 	if (para->tpr10 & TPR10_READ_CALIBRATION) {
 		for (i = 0; i < 5; i++)
 			if (mctl_phy_read_calibration(config))
@@ -1170,6 +1184,7 @@
 		}
 	}
 
+	stub_mark(0x36);
 	if (para->tpr10 & TPR10_READ_TRAINING) {
 		for (i = 0; i < 5; i++)
 			if (mctl_phy_read_training(para, config))
@@ -1180,6 +1195,7 @@
 		}
 	}
 
+	stub_mark(0x37);
 	if (para->tpr10 & TPR10_WRITE_TRAINING) {
 		for (i = 0; i < 5; i++)
 			if (mctl_phy_write_training(config))
@@ -1190,6 +1206,7 @@
 		}
 	}
 
+	stub_mark(0x38);
 	mctl_phy_bit_delay_compensation(para);
 
 	clrbits_le32(SUNXI_DRAM_PHY0_BASE + 0x60, 4);
@@ -1270,6 +1287,14 @@
 
 	mctl_set_timing_params(para);
 
+	/*
+	 * Resume: the SDRAM has been refreshing itself since the suspend, so
+	 * the controller must not run the power-up initialisation that would
+	 * lose its contents. INIT0 bits 31:30 are uMCTL2's skip_dram_init.
+	 */
+	if (sunxi_dram_resume)
+		clrsetbits_le32(&mctl_ctl->init[0], BIT(31) | BIT(30), BIT(30));
+
 	writel(0, &mctl_ctl->pwrctl);
 
 	setbits_le32(&mctl_ctl->dfiupd[0], BIT(31) | BIT(30));
@@ -1294,6 +1319,7 @@
 	setbits_le32(&mctl_com->unk_0x500, BIT(24));
 	udelay(1);
 
+	stub_mark(0x32);
 	if (!mctl_phy_init(para, config))
 		return false;
 
@@ -1308,6 +1334,7 @@
 	writel(1, &mctl_ctl->swctl);
 	mctl_await_completion(&mctl_ctl->swstat, 1, 1);
 
+	stub_mark(0x39);
 	return true;
 }
 
@@ -1315,6 +1342,7 @@
 		    const struct dram_config *config)
 {
 	mctl_sys_init(para->clk);
+	stub_mark(0x31);
 
 	return mctl_ctrl_init(para, config);
 }
@@ -1360,3 +1388,30 @@
 
 	return size;
 };
+
+
+/*
+ * Build the controller and the PHY again after a suspend, using the geometry
+ * the stub read back out of the controller rather than a fresh detection: the
+ * detection writes patterns over the memory this suspend exists to keep.
+ *
+ * The two PRCM writes are the ones sunxi_dram_init() makes before anything
+ * else, the 240 ohm resistor calibration. This lives in this file because the
+ * parameters and the master priorities it needs are static to it.
+ */
+bool sunxi_dram_resume_init(const struct dram_config *config)
+{
+	void *const prcm = (void *)SUNXI_PRCM_BASE;
+
+	setbits_le32(prcm + CCU_PRCM_RES_CAL_CTRL, BIT(8));
+	clrbits_le32(prcm + CCU_PRCM_OHMS240, 0x3f);
+	stub_mark(0x30);
+
+	if (!mctl_core_init(&para, config))
+		return false;
+
+	mctl_set_master_priority();
+	stub_mark(0x3a);
+
+	return true;
+}
