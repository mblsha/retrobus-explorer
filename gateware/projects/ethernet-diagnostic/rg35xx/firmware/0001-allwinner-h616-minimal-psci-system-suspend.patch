Subject: [PATCH] allwinner: h616: minimal PSCI SYSTEM_SUSPEND, DRAM left running

The H616/H700 has no management processor, so mainline TF-A leaves system
suspend unimplemented and a Linux on it can only ever offer s2idle. This adds
the smallest thing that is a real suspend entry and a real warm resume: the
boot core moves off PLL_CPUX, stops PLL_CPUX and waits in WFI until the GIC
has an interrupt for it, then restarts the PLL and returns to Linux through
bl31_warm_entrypoint. No rail is touched, DRAM is left running and nothing is
relocated, so the sequence runs from wherever BL31 was loaded.

Built with SUNXI_SYSTEM_SUSPEND=1; unset, the build is unchanged. The inner
sequence is deliberately self-contained so that it can later be relocated
into SRAM A1 with DRAM in self-refresh around it.

The idea, the choice of PSCI hooks and the return through the warm boot entry
are kailashrs' work for ROCKNIX, which does the whole job with an SRAM stub:
https://github.com/kailashrs/H700_rocknix_enhancement and
https://github.com/ROCKNIX/distribution/pull/3316. The code here is our own.

diff -Nur a/plat/allwinner/common/include/sunxi_private.h b/plat/allwinner/common/include/sunxi_private.h
--- a/plat/allwinner/common/include/sunxi_private.h	2024-11-21 09:30:24
+++ b/plat/allwinner/common/include/sunxi_private.h	2026-09-20 11:08:55
@@ -42,6 +42,20 @@
 #endif
 int sunxi_validate_ns_entrypoint(uintptr_t ns_entrypoint);
 
+/*
+ * PSCI SYSTEM_SUSPEND, for a platform with no management processor: the boot
+ * core stops the CPU PLL, waits in WFI and comes back through the warm boot
+ * entry point. Only sun50i_h616 offers this, and only when asked for it.
+ */
+#if defined(SUNXI_SYSTEM_SUSPEND) && SUNXI_SYSTEM_SUSPEND
+#define SUNXI_HAS_SYSTEM_SUSPEND	1
+void sunxi_system_suspend_init(uintptr_t warm_entrypoint);
+void __dead2 sunxi_system_suspend_enter(void);
+void sunxi_system_suspend_finish(void);
+#else
+#define SUNXI_HAS_SYSTEM_SUSPEND	0
+#endif
+
 int sunxi_pmic_setup(uint16_t socid, const void *fdt);
 void sunxi_security_setup(void);
 
diff -Nur a/plat/allwinner/common/sunxi_native_pm.c b/plat/allwinner/common/sunxi_native_pm.c
--- a/plat/allwinner/common/sunxi_native_pm.c	2024-11-21 09:30:24
+++ b/plat/allwinner/common/sunxi_native_pm.c	2026-09-20 11:10:08
@@ -66,10 +66,58 @@
 	panic();
 }
 
+#if SUNXI_HAS_SYSTEM_SUSPEND
+/*
+ * Nothing to undo here, and that is the point: the GIC distributor and this
+ * core's CPU interface have to stay enabled, or the interrupt Linux left
+ * unmasked as its wake source would never end the WFI, and nothing in the
+ * suspend takes their state away. PSCI will not advertise SYSTEM_SUSPEND
+ * unless both of these exist, so they exist.
+ */
+static void sunxi_pwr_domain_suspend(const psci_power_state_t *target_state)
+{
+}
+
+static void sunxi_pwr_domain_suspend_finish(const psci_power_state_t *target_state)
+{
+	sunxi_system_suspend_finish();
+}
+
+/*
+ * The CPU_OFF path comes through here too, with only the core's own level
+ * off; that one wants the generic wait and nothing else.
+ */
+static void __dead2 sunxi_pwr_domain_pwr_down_wfi(
+		const psci_power_state_t *target_state)
+{
+	if (is_local_state_off(target_state->pwr_domain_state[PLAT_MAX_PWR_LVL]) != 0) {
+		sunxi_system_suspend_enter();
+	}
+
+	psci_power_down_wfi();
+}
+
+/* SYSTEM_SUSPEND is the whole machine: every level asks for its deepest state. */
+static void sunxi_get_sys_suspend_power_state(psci_power_state_t *req_state)
+{
+	unsigned int level;
+
+	for (level = 0U; level <= PLAT_MAX_PWR_LVL; level++) {
+		req_state->pwr_domain_state[level] = PLAT_MAX_OFF_STATE;
+	}
+}
+#endif /* SUNXI_HAS_SYSTEM_SUSPEND */
+
 static const plat_psci_ops_t sunxi_native_psci_ops = {
 	.pwr_domain_on			= sunxi_pwr_domain_on,
 	.pwr_domain_off			= sunxi_pwr_domain_off,
 	.pwr_domain_on_finish		= sunxi_pwr_domain_on_finish,
+#if SUNXI_HAS_SYSTEM_SUSPEND
+	.pwr_domain_suspend		= sunxi_pwr_domain_suspend,
+	.pwr_domain_suspend_finish	= sunxi_pwr_domain_suspend_finish,
+	.pwr_domain_pwr_down_wfi	= sunxi_pwr_domain_pwr_down_wfi,
+	.get_sys_suspend_power_state	= sunxi_get_sys_suspend_power_state,
+#endif
 	.system_off			= sunxi_system_off,
 	.system_reset			= sunxi_system_reset,
 	.validate_ns_entrypoint		= sunxi_validate_ns_entrypoint,
diff -Nur a/plat/allwinner/common/sunxi_pm.c b/plat/allwinner/common/sunxi_pm.c
--- a/plat/allwinner/common/sunxi_pm.c	2024-11-21 09:30:24
+++ b/plat/allwinner/common/sunxi_pm.c	2026-09-20 11:08:55
@@ -64,7 +64,12 @@
 		INFO("PSCI: Suspend is available via SCPI\n");
 		psci_is_scpi = true;
 	} else {
+#if SUNXI_HAS_SYSTEM_SUSPEND
+		sunxi_system_suspend_init(sec_entrypoint);
+		INFO("PSCI: System suspend is available\n");
+#else
 		INFO("PSCI: Suspend is unavailable\n");
+#endif
 		sunxi_set_native_psci_ops(psci_ops);
 	}
 
diff -Nur a/plat/allwinner/sun50i_h616/platform.mk b/plat/allwinner/sun50i_h616/platform.mk
--- a/plat/allwinner/sun50i_h616/platform.mk	2024-11-21 09:30:24
+++ b/plat/allwinner/sun50i_h616/platform.mk	2026-09-20 11:08:55
@@ -23,3 +23,19 @@
 				drivers/allwinner/sunxi_rsb.c		\
 				drivers/mentor/i2c/mi2cv.c		\
 				${AW_PLAT}/${PLAT}/sunxi_h616_dtb.c
+
+# PSCI SYSTEM_SUSPEND without a management processor: stop PLL_CPUX and wait
+# in WFI on the boot core, leaving DRAM running. Off by default, so a build
+# that does not ask for it is byte-for-byte the build that came before.
+SUNXI_SYSTEM_SUSPEND	?=	0
+# Additionally park the cluster on the 32 kHz clock, as the vendor's standby
+# code does. Only meaningful with SUNXI_SYSTEM_SUSPEND=1.
+SUNXI_SUSPEND_CPU_32K	?=	0
+$(eval $(call assert_boolean,SUNXI_SYSTEM_SUSPEND))
+$(eval $(call assert_boolean,SUNXI_SUSPEND_CPU_32K))
+$(eval $(call add_define,SUNXI_SYSTEM_SUSPEND))
+$(eval $(call add_define,SUNXI_SUSPEND_CPU_32K))
+
+ifeq (${SUNXI_SYSTEM_SUSPEND},1)
+BL31_SOURCES		+=	${AW_PLAT}/${PLAT}/sunxi_system_suspend.c
+endif
diff -Nur a/plat/allwinner/sun50i_h616/sunxi_system_suspend.c b/plat/allwinner/sun50i_h616/sunxi_system_suspend.c
--- a/plat/allwinner/sun50i_h616/sunxi_system_suspend.c	1970-01-01 10:00:00
+++ b/plat/allwinner/sun50i_h616/sunxi_system_suspend.c	2026-09-20 11:08:17
@@ -0,0 +1,289 @@
+/*
+ * Copyright (c) 2026, Contributors to the Trusted Firmware-A project.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * PSCI SYSTEM_SUSPEND for the Allwinner H616/H700, which has no management
+ * processor: the boot core does the suspend itself, at EL3.
+ *
+ * This is the smallest thing that is a real suspend entry and a real warm
+ * resume. The CPU is taken off PLL_CPUX, PLL_CPUX is stopped, and the core
+ * waits in WFI until the GIC has an interrupt for it. DRAM is left running
+ * and no rail is touched, so the whole sequence can execute from wherever
+ * BL31 was loaded -- on this platform that is DRAM, since the H616 builds
+ * with SUNXI_BL31_IN_DRAM.
+ *
+ * Coming back is the part that is not obvious. An arm64 Linux treats a plain
+ * return from the SYSTEM_SUSPEND SMC as a suspend that did not happen, so the
+ * resume has to arrive through the entry point PSCI was set up with:
+ * bl31_warm_entrypoint, the same address plat_setup_psci_ops() programs into
+ * every core's reset vector. suspend_sequence() therefore ends by turning the
+ * MMU off and branching there, and psci_warmboot_entrypoint() unwinds the
+ * suspend and returns to the address Linux passed to SYSTEM_SUSPEND.
+ *
+ * The idea, the choice of hooks and the shape of the TF-A side are kailashrs'
+ * work for ROCKNIX, which does the same thing with an SRAM stub so that DRAM
+ * can go into self-refresh:
+ *   https://github.com/kailashrs/H700_rocknix_enhancement
+ *   https://github.com/ROCKNIX/distribution/pull/3316
+ * The code here is not theirs and does no DRAM work. suspend_sequence() is
+ * deliberately self-contained -- memory-mapped I/O, the architected counter
+ * and WFI, no call back into the rest of BL31 -- because the next step is to
+ * relocate exactly that function into SRAM A1 and put DRAM into self-refresh
+ * around it, and nothing in DRAM may be called once that happens.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <platform_def.h>
+
+#include <arch.h>
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <lib/mmio.h>
+#include <lib/utils_def.h>
+
+#include <sunxi_def.h>
+#include <sunxi_mmap.h>
+#include <sunxi_private.h>
+
+/*
+ * H616 User Manual rev 1.0, 3.3.5.1: PLL_CPUX Control Register, CCU + 0x0000.
+ * Bit 31 enables the PLL, bit 29 enables lock detection and bit 28 reads back
+ * as the lock status.
+ */
+#define CCU_PLL_CPUX_CTRL_REG		(SUNXI_CCU_BASE + 0x0000)
+#define PLL_CPUX_ENABLE			BIT_32(31)
+#define PLL_CPUX_LOCK_ENABLE		BIT_32(29)
+#define PLL_CPUX_LOCK			BIT_32(28)
+
+/*
+ * H616 User Manual rev 1.0, 3.3.5.45: CPUX_AXI Configuration Register,
+ * CCU + 0x0500. Bits 26:24 select the clock feeding the CPU cluster:
+ * 000 OSC24M, 001 RTC_32K, 010 RC16M, 011 PLL_CPUX, 100 PLL_PERI0(1X).
+ */
+#define CCU_CPUX_AXI_CFG_REG		(SUNXI_CCU_BASE + 0x0500)
+#define CPUX_CLK_SRC_SHIFT		24
+#define CPUX_CLK_SRC_MASK		(0x7U << CPUX_CLK_SRC_SHIFT)
+#define CPUX_CLK_SRC_OSC24M		(0x0U << CPUX_CLK_SRC_SHIFT)
+#define CPUX_CLK_SRC_RTC32K		(0x1U << CPUX_CLK_SRC_SHIFT)
+
+/*
+ * H616 User Manual rev 1.0, 3.3.2: PLL_CPUX settles within 1.5 ms. Two
+ * milliseconds of patience, then give up rather than spin for ever: a CPU
+ * left on the 24 MHz oscillator is slow but alive, and says so.
+ */
+#define PLL_CPUX_LOCK_TIMEOUT_US	2000U
+
+/*
+ * H616 User Manual rev 1.0, 3.13: the RTC is at 0x07000000, and 3.13.6.12
+ * gives sixteen General Purpose Registers at RTC + 0x100 + 4N whose only
+ * documented behaviour is to hold what was written to them. They are in the
+ * always-on domain, so they survive a suspend and a warm reset; on a board
+ * with no battery they do not survive the 5 V going away.
+ *
+ * There is no serial console on the bench this was developed on, so these
+ * four are how the sequence reports where it got to. The high registers are
+ * used to stay out of the way of the low ones, which the boot ROM and the
+ * vendor firmware are known to use for boot-mode and standby flags.
+ */
+#define SUNXI_RTC_BASE			0x07000000
+#define RTC_GP_DATA_REG(n)		(SUNXI_RTC_BASE + 0x0100 + ((n) * 4))
+#define RTC_GP_STAGE			12
+#define RTC_GP_SUSPENDS			13
+#define RTC_GP_RESUMES			14
+#define RTC_GP_WAKE_IRQ			15
+
+/* Tag the stage word so a register that was never written cannot look like one. */
+#define SUSPEND_STAGE_TAG		0xA5D50000U
+#define STAGE_ENTERED			0x01U
+#define STAGE_CLOCKS_DOWN		0x02U
+#define STAGE_WFI			0x03U
+#define STAGE_WOKE			0x04U
+#define STAGE_PLL_TIMEOUT		0x05U
+#define STAGE_CLOCKS_UP			0x06U
+#define STAGE_WARM_BOOT			0x07U
+#define STAGE_RESUMED			0x08U
+
+/*
+ * GICv2 distributor registers, Arm GIC Architecture Specification v2, 4.3:
+ * the set-enable and set-pending banks are read here only to name the
+ * interrupt that ended the wait.
+ */
+#define GICD_TYPER			(SUNXI_GICD_BASE + 0x0004)
+#define GICD_ISENABLER(n)		(SUNXI_GICD_BASE + 0x0100 + ((n) * 4))
+#define GICD_ISPENDR(n)			(SUNXI_GICD_BASE + 0x0200 + ((n) * 4))
+#define GICD_TYPER_ITLINES_MASK		0x1fU
+#define GIC_SPURIOUS_INTERRUPT		1023U
+
+static uintptr_t warm_entrypoint;
+static uint32_t suspend_count;
+static uint32_t resume_count;
+
+static void stage(uint32_t code)
+{
+	mmio_write_32(RTC_GP_DATA_REG(RTC_GP_STAGE), SUSPEND_STAGE_TAG | code);
+}
+
+/*
+ * The architected counter runs from the 24 MHz oscillator, which this
+ * sequence deliberately leaves alone, so it keeps time while PLL_CPUX is
+ * stopped and whatever the CPU is clocked from. udelay() would do the same
+ * job today but reaches a function pointer in BL31's data; this does not.
+ */
+static void suspend_delay_us(uint32_t microseconds)
+{
+	uint64_t ticks = ((uint64_t)microseconds * SUNXI_OSC24M_CLK_IN_HZ) /
+			 1000000ULL;
+	uint64_t deadline = read_cntpct_el0() + ticks;
+
+	while (read_cntpct_el0() < deadline) {
+	}
+}
+
+static bool pll_cpux_locked(void)
+{
+	uint32_t waited;
+
+	for (waited = 0U; waited < PLL_CPUX_LOCK_TIMEOUT_US; waited += 100U) {
+		if ((mmio_read_32(CCU_PLL_CPUX_CTRL_REG) & PLL_CPUX_LOCK) != 0U) {
+			return true;
+		}
+		suspend_delay_us(100U);
+	}
+
+	return false;
+}
+
+/* The lowest interrupt that is both enabled and pending, or 1023 for none. */
+static uint32_t pending_interrupt(void)
+{
+	unsigned int words = (mmio_read_32(GICD_TYPER) & GICD_TYPER_ITLINES_MASK) + 1U;
+	unsigned int word;
+
+	for (word = 0U; word < words; word++) {
+		uint32_t active = mmio_read_32(GICD_ISPENDR(word)) &
+				  mmio_read_32(GICD_ISENABLER(word));
+
+		if (active != 0U) {
+			return (word * 32U) + (uint32_t)__builtin_ctz(active);
+		}
+	}
+
+	return GIC_SPURIOUS_INTERRUPT;
+}
+
+/*
+ * Everything between the CPU leaving PLL_CPUX and getting back onto it. This
+ * is the function Stage 2 relocates into SRAM A1, so it touches nothing but
+ * memory-mapped registers, the architected counter and its own stack.
+ */
+static void suspend_sequence(void)
+{
+	uint32_t cpux_axi_cfg = mmio_read_32(CCU_CPUX_AXI_CFG_REG);
+	uint32_t pll_cpux_ctrl = mmio_read_32(CCU_PLL_CPUX_CTRL_REG);
+	uint64_t scr = read_scr_el3();
+
+	/*
+	 * The manual's own order for touching PLL_CPUX (3.3.3.1) is to move
+	 * the CPU onto another source first. The 24 MHz oscillator is the one
+	 * source that is certainly running and is not about to be stopped.
+	 */
+	mmio_clrsetbits_32(CCU_CPUX_AXI_CFG_REG, CPUX_CLK_SRC_MASK,
+			   CPUX_CLK_SRC_OSC24M);
+	suspend_delay_us(100U);
+
+#if SUNXI_SUSPEND_CPU_32K
+	/*
+	 * What the vendor's standby code does next: park the cluster on the
+	 * 32 kHz clock as well. A core in WFI has its clock gated anyway, so
+	 * this is not expected to be worth anything on its own; it is here to
+	 * be measured, and is off by default.
+	 */
+	mmio_clrsetbits_32(CCU_CPUX_AXI_CFG_REG, CPUX_CLK_SRC_MASK,
+			   CPUX_CLK_SRC_RTC32K);
+#endif
+
+	mmio_clrbits_32(CCU_PLL_CPUX_CTRL_REG,
+			PLL_CPUX_ENABLE | PLL_CPUX_LOCK_ENABLE);
+	stage(STAGE_CLOCKS_DOWN);
+
+	/*
+	 * Interrupts are masked in PSTATE, which does not stop one from ending
+	 * a WFI, but route them to EL3 for the wait so that the core is
+	 * certain to see the one Linux left unmasked at the GIC. SCR_EL3 is
+	 * put back immediately; the warm boot path rebuilds it anyway.
+	 */
+	stage(STAGE_WFI);
+	write_scr_el3(scr | SCR_IRQ_BIT | SCR_FIQ_BIT);
+	isb();
+	dsb();
+	wfi();
+	write_scr_el3(scr);
+	isb();
+	stage(STAGE_WOKE);
+
+	mmio_write_32(RTC_GP_DATA_REG(RTC_GP_WAKE_IRQ), pending_interrupt());
+
+	/* Back up in the reverse order: the PLL has to be locked before use. */
+	mmio_write_32(CCU_PLL_CPUX_CTRL_REG,
+		      pll_cpux_ctrl | PLL_CPUX_ENABLE | PLL_CPUX_LOCK_ENABLE);
+	if (pll_cpux_locked()) {
+		mmio_write_32(CCU_CPUX_AXI_CFG_REG, cpux_axi_cfg);
+		suspend_delay_us(100U);
+		stage(STAGE_CLOCKS_UP);
+	} else {
+		/*
+		 * Leave the CPU on the oscillator rather than switch it onto a
+		 * PLL that never came back. Linux resumes at 24 MHz, which is
+		 * slow enough to be unmistakable in any measurement.
+		 */
+		stage(STAGE_PLL_TIMEOUT);
+	}
+}
+
+void sunxi_system_suspend_init(uintptr_t entrypoint)
+{
+	warm_entrypoint = entrypoint;
+
+	/*
+	 * The suspend runs with the data cache off, having been through the
+	 * CPU's power-down cache maintenance, and reads this. Put it in memory
+	 * now rather than depend on that maintenance having reached it.
+	 */
+	flush_dcache_range((uintptr_t)&warm_entrypoint, sizeof(warm_entrypoint));
+}
+
+void __dead2 sunxi_system_suspend_enter(void)
+{
+	void (*warm_boot)(void) = (void (*)(void))warm_entrypoint;
+
+	suspend_count++;
+	mmio_write_32(RTC_GP_DATA_REG(RTC_GP_SUSPENDS), suspend_count);
+	stage(STAGE_ENTERED);
+
+	suspend_sequence();
+
+	resume_count++;
+	mmio_write_32(RTC_GP_DATA_REG(RTC_GP_RESUMES), resume_count);
+	stage(STAGE_WARM_BOOT);
+
+	/*
+	 * bl31_warm_entrypoint expects the state a reset leaves behind, and
+	 * re-enables the MMU itself. BL31 is identity mapped, so execution
+	 * carries on at the same address with translation off.
+	 */
+	disable_mmu_el3();
+	warm_boot();
+
+	/* Not reached: the warm boot path returns to the non-secure world. */
+	panic();
+}
+
+void sunxi_system_suspend_finish(void)
+{
+	stage(STAGE_RESUMED);
+	INFO("PSCI: Resumed from system suspend (%u of %u)\n",
+	     resume_count, suspend_count);
+}
