Subject: [PATCH] allwinner: h616: run the suspend from a stub built outside the tree

Applies on top of the minimal PSCI SYSTEM_SUSPEND patch, and not on top of the
assembly-stub one: they are two answers to the same question and a build takes
one or the other.

That first answer -- 4224 bytes of hand-written assembly that asks the DRAM
controller for self-refresh and asks it to come out again -- works, sleeps at
about 105 mA, and stops one rung short of where the current is. Going further
means shutting the DFI interface down, clearing the controller's clock enables,
gating and resetting the DRAM clock path and stopping PLL_DDR0, and there is no
way back from that except to build the controller and the PHY again. The only
open initialisation for this PHY is U-Boot's own H616 DRAM driver, which is
GPL-2.0-or-later, so the program that does it cannot be a file in this tree.

So it is a separate program, built from rg35xx/firmware/stub/ against the same
pinned U-Boot tree the bootloader is built from, and SUNXI_SUSPEND_BLOB gives
BL31 its path. BL31 carries the binary in its read-only data, checks the header
inside it at boot, copies it into SRAM A1 on the way into every suspend, hands
it the warm boot entry point and branches to it with the MMU off. The stub
returns by branching to that entry point itself, once DRAM is usable again.
SRAM keeps its contents across the sleep, so what the stub has to say -- its
status, its last progress code, the register any wait gave up on, and a
snapshot of the CCU taken at the last instruction before WFI -- is still there
afterwards for BL31's log line and for a job on the target reading /dev/mem.

sunxi_suspend_blob.h is the whole of the interface between the two, and is the
one file both sides include; it stays here, with the firmware, and is
BSD-3-Clause like the rest of this patch.

Without SUNXI_SUSPEND_BLOB the build is byte-for-byte what the first patch
alone produces, and the in-tree sequence with DRAM left running is what runs.

The idea, the choice of PSCI hooks, the return through the warm boot entry and
the shape of the BL31 side are kailashrs' work for ROCKNIX:
https://github.com/kailashrs/H700_rocknix_enhancement and
https://github.com/ROCKNIX/distribution/pull/3316, merged 2026-09-19. The code
here is ours.

diff -Nur tfa-base-plat/allwinner/sun50i_h616/include/sunxi_suspend_blob.h tfa/plat/allwinner/sun50i_h616/include/sunxi_suspend_blob.h
--- a/plat/allwinner/sun50i_h616/include/sunxi_suspend_blob.h	1970-01-01 10:00:00
+++ b/plat/allwinner/sun50i_h616/include/sunxi_suspend_blob.h	2026-09-20 16:53:28
@@ -0,0 +1,68 @@
+/*
+ * Copyright (c) 2026, Contributors to the Trusted Firmware-A project.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * What BL31 and the SRAM suspend stub say to each other.
+ *
+ * The stub is a separate program, linked to run from SRAM A1 and built outside
+ * this tree, because it has to be compiled against U-Boot's H616 DRAM driver
+ * in order to rebuild the controller and the PHY on the way back -- and that
+ * driver is GPL-2.0-or-later, so the stub is too. This header is the whole of
+ * the interface between them, and it is the one piece both sides include.
+ *
+ * On the way in, BL31 checks the build-time half of the block inside the image
+ * it is about to copy, copies the image to SRAM_A1_BASE, fills in the "in"
+ * fields of the copy, turns the MMU off and branches to the image's first
+ * instruction. The stub returns by branching to resume_entry itself, which is
+ * BL31's warm boot entry point, once DRAM is usable again. SRAM keeps its
+ * contents throughout, so the "out" fields can be read after the resume -- by
+ * BL31, and by a job on the target with devmem, which is how the CCU snapshot
+ * taken at the last instruction before WFI gets off the board.
+ */
+
+#ifndef SUNXI_SUSPEND_BLOB_H
+#define SUNXI_SUSPEND_BLOB_H
+
+#define SUNXI_SUSPEND_BLOB_BASE		0x00020000
+#define SUNXI_SUSPEND_BLOB_PARAMS_OFF	0x10
+
+#define SUNXI_SUSPEND_BLOB_MAGIC	0x4d415253	/* "SRAM" */
+#define SUNXI_SUSPEND_BLOB_VERSION	1
+
+/* status (out) */
+#define SUNXI_SUSPEND_BLOB_STATUS_NONE		0	/* it did not report */
+#define SUNXI_SUSPEND_BLOB_STATUS_OK		1	/* slept and came back */
+#define SUNXI_SUSPEND_BLOB_STATUS_BAD_CONFIG	2	/* not this memory; skipped */
+#define SUNXI_SUSPEND_BLOB_STATUS_NO_SELFREF	3	/* refused self-refresh; skipped */
+#define SUNXI_SUSPEND_BLOB_STATUS_FAILED	4	/* gave up; resetting */
+
+/* How many CCU registers the snapshot has room for. */
+#define SUNXI_SUSPEND_BLOB_SNAPSHOT	32
+
+#ifndef __ASSEMBLER__
+
+#include <stdint.h>
+
+struct sunxi_suspend_blob_params {
+	uint32_t magic;		/* 0x00 build: SUNXI_SUSPEND_BLOB_MAGIC */
+	uint32_t version;	/* 0x04 build: SUNXI_SUSPEND_BLOB_VERSION */
+	uint32_t dram_clk;	/* 0x08 build: the DRAM clock it was built for */
+	uint32_t level;		/* 0x0c build: which rung of the ladder it is */
+	uint64_t resume_entry;	/* 0x10 in:  BL31's warm boot entry point */
+	uint32_t flags;		/* 0x18 in:  reserved, zero */
+	uint32_t status;	/* 0x1c out: SUNXI_SUSPEND_BLOB_STATUS_* */
+	uint32_t stage;		/* 0x20 out: the last progress code */
+	uint32_t wake_irq;	/* 0x24 out: first pending interrupt after WFI */
+	uint32_t fail_reg;	/* 0x28 out: the register a wait gave up on */
+	uint32_t fail_info;	/* 0x2c out: stage << 16 | why */
+	uint32_t dram_cfg;	/* 0x30 out: cols | rows << 8 | ranks << 16 | full << 24 */
+	uint32_t dram_mb;	/* 0x34 out: the memory it found, in MiB */
+	uint32_t snapshot_n;	/* 0x38 out: CCU words in the snapshot */
+	uint32_t reserved;	/* 0x3c */
+	uint32_t snapshot[SUNXI_SUSPEND_BLOB_SNAPSHOT];	/* 0x40 out */
+};
+
+#endif /* __ASSEMBLER__ */
+
+#endif /* SUNXI_SUSPEND_BLOB_H */
diff -Nur tfa-base-plat/allwinner/sun50i_h616/platform.mk tfa/plat/allwinner/sun50i_h616/platform.mk
--- a/plat/allwinner/sun50i_h616/platform.mk	2026-09-20 16:53:10
+++ b/plat/allwinner/sun50i_h616/platform.mk	2026-09-20 16:53:54
@@ -36,6 +36,20 @@
 $(eval $(call add_define,SUNXI_SYSTEM_SUSPEND))
 $(eval $(call add_define,SUNXI_SUSPEND_CPU_32K))
 
+# The path to a suspend stub built outside this tree, which BL31 carries in its
+# read-only data, copies into SRAM A1 and runs with the MMU off. Given one, the
+# whole of the wait happens there and the DRAM controller and its PHY can be
+# rebuilt on the way back; given none, the in-tree sequence above runs instead
+# and DRAM keeps running. Only meaningful with SUNXI_SYSTEM_SUSPEND=1.
+SUNXI_SUSPEND_BLOB	?=
+
 ifeq (${SUNXI_SYSTEM_SUSPEND},1)
 BL31_SOURCES		+=	${AW_PLAT}/${PLAT}/sunxi_system_suspend.c
+
+ifneq (${SUNXI_SUSPEND_BLOB},)
+SUNXI_SUSPEND_BLOB_ABS	:=	$(abspath ${SUNXI_SUSPEND_BLOB})
+$(eval $(call add_define_val,SUNXI_SUSPEND_BLOB_BIN,\"${SUNXI_SUSPEND_BLOB_ABS}\"))
+BL31_SOURCES		+=	${AW_PLAT}/${PLAT}/sunxi_suspend_blob.S
+${BUILD_PLAT}/bl31/sunxi_suspend_blob.o: ${SUNXI_SUSPEND_BLOB_ABS}
+endif
 endif
diff -Nur tfa-base-plat/allwinner/sun50i_h616/sunxi_suspend_blob.S tfa/plat/allwinner/sun50i_h616/sunxi_suspend_blob.S
--- a/plat/allwinner/sun50i_h616/sunxi_suspend_blob.S	1970-01-01 10:00:00
+++ b/plat/allwinner/sun50i_h616/sunxi_suspend_blob.S	2026-09-20 16:53:39
@@ -0,0 +1,44 @@
+/*
+ * Copyright (c) 2026, Contributors to the Trusted Firmware-A project.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * The SRAM suspend stub, carried in BL31's read-only data, and the two
+ * instructions that hand control to it.
+ */
+
+#include <arch.h>
+#include <asm_macros.S>
+
+	.globl	sunxi_suspend_blob_start
+	.globl	sunxi_suspend_blob_end
+	.globl	sunxi_suspend_blob_jump
+
+	.section .rodata.sunxi_suspend_blob, "a"
+	.align	3
+sunxi_suspend_blob_start:
+	.incbin	SUNXI_SUSPEND_BLOB_BIN
+sunxi_suspend_blob_end:
+
+/* -----------------------------------------------------------------
+ * void __dead2 sunxi_suspend_blob_jump(uintptr_t entry)
+ *
+ * The MMU and the data cache go off and stay off: SRAM is mapped
+ * execute-never, and BL31's page tables are in the DRAM the stub is about
+ * to put into self-refresh. BL31 is identity mapped, so these instructions
+ * carry on at the same addresses with translation off.
+ *
+ * It does not return. The stub comes back to BL31 through the warm boot
+ * entry point it was given in the parameter block, once DRAM is usable.
+ * -----------------------------------------------------------------
+ */
+func sunxi_suspend_blob_jump
+	msr	daifset, #(DAIF_FIQ_BIT | DAIF_IRQ_BIT | DAIF_ABT_BIT | DAIF_DBG_BIT)
+	mov	x19, x0
+	mrs	x1, sctlr_el3
+	mov_imm	x2, (SCTLR_M_BIT | SCTLR_C_BIT)
+	bic	x1, x1, x2
+	msr	sctlr_el3, x1
+	isb
+	br	x19
+endfunc sunxi_suspend_blob_jump
diff -Nur tfa-base-plat/allwinner/sun50i_h616/sunxi_system_suspend.c tfa/plat/allwinner/sun50i_h616/sunxi_system_suspend.c
--- a/plat/allwinner/sun50i_h616/sunxi_system_suspend.c	2026-09-20 16:53:10
+++ b/plat/allwinner/sun50i_h616/sunxi_system_suspend.c	2026-09-20 16:54:42
@@ -26,15 +26,26 @@
  * can go into self-refresh:
  *   https://github.com/kailashrs/H700_rocknix_enhancement
  *   https://github.com/ROCKNIX/distribution/pull/3316
- * The code here is not theirs and does no DRAM work. suspend_sequence() is
- * deliberately self-contained -- memory-mapped I/O, the architected counter
- * and WFI, no call back into the rest of BL31 -- because the next step is to
- * relocate exactly that function into SRAM A1 and put DRAM into self-refresh
- * around it, and nothing in DRAM may be called once that happens.
+ * The code here is not theirs.
+ *
+ * Which inner sequence runs while the core waits is a build-time choice.
+ * SUNXI_SUSPEND_BLOB names a program built outside this tree, linked to run
+ * from SRAM A1 and compiled against U-Boot's H616 DRAM driver; given one, BL31
+ * carries it in its read-only data, copies it into SRAM on the way into every
+ * suspend, hands it the warm boot entry point and branches to it with the MMU
+ * off, and the stub puts DRAM into self-refresh, shuts the controller and its
+ * PHY down and builds them again on the way back. Given none, suspend_sequence()
+ * below runs instead, from DRAM, which therefore has to keep running.
+ *
+ * The parameter block the two exchange is sunxi_suspend_blob.h. Everything
+ * outside that choice -- the PSCI hooks, the counters, the progress codes --
+ * is the same either way.
  */
 
 #include <stdbool.h>
+#include <stddef.h>
 #include <stdint.h>
+#include <string.h>
 
 #include <platform_def.h>
 
@@ -47,6 +58,7 @@
 #include <sunxi_def.h>
 #include <sunxi_mmap.h>
 #include <sunxi_private.h>
+#include <sunxi_suspend_blob.h>
 
 /*
  * H616 User Manual rev 1.0, 3.3.5.1: PLL_CPUX Control Register, CCU + 0x0000.
@@ -105,6 +117,8 @@
 #define STAGE_CLOCKS_UP			0x06U
 #define STAGE_WARM_BOOT			0x07U
 #define STAGE_RESUMED			0x08U
+#define STAGE_TO_SRAM			0x09U
+#define STAGE_NO_BLOB			0x0aU
 
 /*
  * GICv2 distributor registers, Arm GIC Architecture Specification v2, 4.3:
@@ -126,6 +140,7 @@
 	mmio_write_32(RTC_GP_DATA_REG(RTC_GP_STAGE), SUSPEND_STAGE_TAG | code);
 }
 
+#ifndef SUNXI_SUSPEND_BLOB_BIN
 /*
  * The architected counter runs from the 24 MHz oscillator, which this
  * sequence deliberately leaves alone, so it keeps time while PLL_CPUX is
@@ -242,11 +257,94 @@
 		stage(STAGE_PLL_TIMEOUT);
 	}
 }
+#else /* SUNXI_SUSPEND_BLOB_BIN */
+/*
+ * The stub, as linked: a complete little program with its parameter block at a
+ * known offset inside it. It is copied into SRAM on the way into every suspend
+ * rather than once at boot, because nothing here owns that SRAM -- U-Boot's SPL
+ * ran from it and anything at all could have been left in it since -- and
+ * because the stub's own variables are in the copy. The copy costs microseconds.
+ */
+extern const uint8_t sunxi_suspend_blob_start[];
+extern const uint8_t sunxi_suspend_blob_end[];
 
+void __dead2 sunxi_suspend_blob_jump(uintptr_t entry);
+
+static bool blob_usable;
+
+static size_t blob_bytes(void)
+{
+	return (size_t)(sunxi_suspend_blob_end - sunxi_suspend_blob_start);
+}
+
+static struct sunxi_suspend_blob_params *sram_params(void)
+{
+	return (struct sunxi_suspend_blob_params *)
+		(SUNXI_SUSPEND_BLOB_BASE + SUNXI_SUSPEND_BLOB_PARAMS_OFF);
+}
+
+/*
+ * Refuse a stub that is not one: the alternative is branching into SRAM and
+ * finding out there, with the MMU off and nothing able to report it.
+ */
+static bool blob_is_sound(void)
+{
+	struct sunxi_suspend_blob_params header;
+	size_t size = blob_bytes();
+
+	if ((size < (SUNXI_SUSPEND_BLOB_PARAMS_OFF + sizeof(header))) ||
+	    (size > SUNXI_SRAM_A1_SIZE)) {
+		ERROR("PSCI: suspend stub is %zu bytes, which cannot be right\n",
+		      size);
+		return false;
+	}
+
+	(void)memcpy(&header,
+		     sunxi_suspend_blob_start + SUNXI_SUSPEND_BLOB_PARAMS_OFF,
+		     sizeof(header));
+
+	if ((header.magic != SUNXI_SUSPEND_BLOB_MAGIC) ||
+	    (header.version != SUNXI_SUSPEND_BLOB_VERSION)) {
+		ERROR("PSCI: suspend stub has magic 0x%x version %u\n",
+		      header.magic, header.version);
+		return false;
+	}
+
+	INFO("PSCI: suspend stub, %zu bytes, level %u, DRAM %u MHz\n",
+	     size, header.level, header.dram_clk);
+
+	return true;
+}
+
+static void place_suspend_blob(void)
+{
+	(void)memcpy((void *)SUNXI_SUSPEND_BLOB_BASE, sunxi_suspend_blob_start,
+		     blob_bytes());
+
+	sram_params()->resume_entry = warm_entrypoint;
+	sram_params()->flags = 0U;
+	sram_params()->status = SUNXI_SUSPEND_BLOB_STATUS_NONE;
+
+	/*
+	 * SRAM is mapped as device memory and the data cache is already off,
+	 * so the bytes are in memory; the instruction side may still hold the
+	 * previous suspend's copy of them.
+	 */
+	dsbsy();
+	__asm__ volatile ("ic iallu" ::: "memory");
+	dsbsy();
+	isb();
+}
+#endif /* SUNXI_SUSPEND_BLOB_BIN */
+
 void sunxi_system_suspend_init(uintptr_t entrypoint)
 {
 	warm_entrypoint = entrypoint;
 
+#ifdef SUNXI_SUSPEND_BLOB_BIN
+	blob_usable = blob_is_sound();
+#endif
+
 	/*
 	 * The suspend runs with the data cache off, having been through the
 	 * CPU's power-down cache maintenance, and reads this. Put it in memory
@@ -263,7 +361,29 @@
 	mmio_write_32(RTC_GP_DATA_REG(RTC_GP_SUSPENDS), suspend_count);
 	stage(STAGE_ENTERED);
 
+#ifdef SUNXI_SUSPEND_BLOB_BIN
+	if (blob_usable) {
+		place_suspend_blob();
+		stage(STAGE_TO_SRAM);
+
+		/*
+		 * Does not return. The stub counts its own resume into the
+		 * RTC, because by the time it can it is the only code running
+		 * and BL31's variables are in DRAM, and then branches to
+		 * warm_entrypoint itself.
+		 */
+		sunxi_suspend_blob_jump(SUNXI_SUSPEND_BLOB_BASE);
+	}
+
+	/*
+	 * A stub that did not pass its own header check is not run, and this
+	 * suspend does nothing at all rather than half of something: the OS
+	 * gets a resume that took no time and a stage code saying why.
+	 */
+	stage(STAGE_NO_BLOB);
+#else
 	suspend_sequence();
+#endif
 
 	resume_count++;
 	mmio_write_32(RTC_GP_DATA_REG(RTC_GP_RESUMES), resume_count);
@@ -283,6 +403,21 @@
 
 void sunxi_system_suspend_finish(void)
 {
+#ifdef SUNXI_SUSPEND_BLOB_BIN
+	const struct sunxi_suspend_blob_params *params = sram_params();
+
+	/* The stub counted the resume; it is the one that knows. */
+	resume_count = mmio_read_32(RTC_GP_DATA_REG(RTC_GP_RESUMES));
+
+	if (params->status == SUNXI_SUSPEND_BLOB_STATUS_OK) {
+		INFO("PSCI: suspend stub returned: wake IRQ %u, %u MiB, cfg 0x%x\n",
+		     params->wake_irq, params->dram_mb, params->dram_cfg);
+	} else {
+		WARN("PSCI: suspend stub status %u, stage 0x%x, fail 0x%x at 0x%x\n",
+		     params->status, params->stage, params->fail_info,
+		     params->fail_reg);
+	}
+#endif
 	stage(STAGE_RESUMED);
 	INFO("PSCI: Resumed from system suspend (%u of %u)\n",
 	     resume_count, suspend_count);
