#!/bin/sh

BB=/usr/bin/busybox
PATH=/usr/bin:/usr/sbin
export PATH

$BB mkdir -p /dev /proc /sys /tmp
$BB mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
$BB mount -t proc proc /proc 2>/dev/null || true
$BB mount -t sysfs sysfs /sys 2>/dev/null || true
exec </dev/console >/dev/console 2>&1

DEBUG_DEVICE=/dev/mmcblk0p2
MAGIC=RG35DBG1

wait_for_debug_device() {
    attempt=0
    while [ ! -b "$DEBUG_DEVICE" ] && [ "$attempt" -lt 100 ]; do
        $BB sleep 0.1
        attempt=$((attempt + 1))
    done
    [ -b "$DEBUG_DEVICE" ]
}

write_stage() {
    stage="$1"
    detail="$2"
    record=/tmp/boot-stage
    {
        $BB printf '%s\n' "$MAGIC"
        $BB printf 'direction=target-to-host\n'
        $BB printf 'stage=%s\n' "$stage"
        $BB printf 'detail=%s\n' "$detail"
        $BB printf 'uptime=%s\n' "$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
    } > "$record"
    $BB dd if="$record" of="$DEBUG_DEVICE" bs=512 seek="$stage" count=1 conv=sync,notrunc 2>/dev/null
    $BB sync
}

$BB printf '\033[2J\033[H'
echo 'RG35XX Plus bare Linux bring-up'
echo 'ROCKNIX kernel reference; custom initramfs; no SYSTEM image'

if ! wait_for_debug_device; then
    echo "ERROR: debug partition $DEBUG_DEVICE did not appear"
    exec $BB sh
fi

write_stage 1 init-entered
command="$($BB dd if="$DEBUG_DEVICE" bs=512 count=1 2>/dev/null | $BB tr '\000' '\n' | $BB sed -n 's/^command=//p' | $BB head -n 1)"
[ -n "$command" ] || command=boot-shell
write_stage 2 "command-$command"

model="$($BB tr -d '\000' </proc/device-tree/model 2>/dev/null)"
echo "Model: ${model:-unknown}"
write_stage 3 "model-${model:-unknown}"

if [ -c /dev/fb0 ]; then
    echo 'Framebuffer: /dev/fb0 present'
    write_stage 4 framebuffer-present
else
    echo 'Framebuffer: not present; console may still initialize later'
    write_stage 4 framebuffer-absent
fi

case "$command" in
    poweroff)
        write_stage 5 command-poweroff
        exec $BB poweroff -f
        ;;
    reboot)
        write_stage 5 command-reboot
        exec $BB reboot -f
        ;;
    boot-shell|shell)
        ;;
    *)
        echo "Unknown debug command: $command"
        write_stage 5 unknown-command
        ;;
esac

write_stage 6 userspace-ready
echo
cat <<'BANNER'
Tiny userspace is ready.
Boot milestones are in raw partition 2, sectors 1..31.
The host command is in partition 2, sector 0.
BANNER

while true; do
    setsid cttyhack $BB sh
    echo 'Shell exited; restarting in one second.'
    $BB sleep 1
done
