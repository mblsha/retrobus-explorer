use shared_components::ascii;
use shared_components::message_stream::{
    ByteMsgStreamOut,
    ByteMsgStreamState,
    TxReq8,
    init_byte_msg_stream,
    tx_req_byte,
    tx_req_indexed,
    tx_req_none,
};

use super::protocol::{CardData, CardOffset, EchoMsg};

type EchoIdx = uint<2>;
type RespIdx = uint<7>;
type MeasureIdx = uint<7>;

pub(lib) struct MeasureStatus {
    count: uint<8>,
    overflow: uint<32>,
    armed: bool,
}

pub(lib) struct MeasureReport {
    start_tag: uint<8>,
    stop_tag: uint<8>,
    delta_ticks: uint<32>,
    delta_events: uint<32>,
    delta_addr_uart: uint<32>,
    delta_ft_overflow: uint<32>,
}

pub(lib) struct FtStatus {
    config: CardData,
    mode: CardData,
    uart_active: bool,
    window_active: bool,
    capture_active: bool,
    session_overflow: uint<32>,
    overflow: uint<32>,
}

pub(lib) enum RespMsg {
    None,
    Ok,
    Busy,
    Err,
    Read{addr: CardOffset, value: CardData},
    Timing{cycles: uint<7>},
    CtrlTiming{cycles: uint<7>},
    FtStatus{status: FtStatus},
    MeasureStatus{status: MeasureStatus},
}

pub(lib) enum MeasureMsg {
    None,
    Report{report: MeasureReport},
    End,
}

pub(lib) type EchoStreamState = ByteMsgStreamState<EchoMsg, 2>;
pub(lib) type EchoStreamOut = ByteMsgStreamOut<EchoMsg, 2>;
pub(lib) type RespStreamState = ByteMsgStreamState<RespMsg, 7>;
pub(lib) type RespStreamOut = ByteMsgStreamOut<RespMsg, 7>;
pub(lib) type MeasureStreamState = ByteMsgStreamState<MeasureMsg, 7>;
pub(lib) type MeasureStreamOut = ByteMsgStreamOut<MeasureMsg, 7>;

pub(lib) fn init_echo_stream() -> EchoStreamState {
    init_byte_msg_stream(EchoMsg::None())
}

pub(lib) fn init_resp_stream() -> RespStreamState {
    init_byte_msg_stream(RespMsg::None())
}

pub(lib) fn init_measure_stream() -> MeasureStreamState {
    init_byte_msg_stream(MeasureMsg::None())
}

fn offset_hex_char(addr: CardOffset, idx: uint<2>) -> uint<8> {
    match idx {
        0 => ascii::hex_char(trunc(addr >> 8)),
        1 => ascii::hex_char(trunc(addr >> 4)),
        _ => ascii::hex_char(trunc(addr)),
    }
}

fn timing_byte(prefix: uint<8>, cycles: uint<7>, idx: RespIdx) -> TxReq8 {
    match idx {
        0 => tx_req_byte(prefix),
        1 => tx_req_byte(b'='),
        2 => tx_req_byte(ascii::digit_char(timing_ns_hundreds(cycles))),
        3 => tx_req_byte(ascii::digit_char(timing_ns_tens(cycles))),
        4 => tx_req_byte(b'0'),
        5 => tx_req_byte(b'n'),
        6 => tx_req_byte(b's'),
        7 => tx_req_byte(b'\r'),
        8 => tx_req_byte(b'\n'),
        _ => tx_req_none(),
    }
}

fn u32_hex_char(value: uint<32>, idx: uint<3>) -> uint<8> {
    let nibble: uint<4> = match idx {
        0 => trunc(value >> 28),
        1 => trunc(value >> 24),
        2 => trunc(value >> 20),
        3 => trunc(value >> 16),
        4 => trunc(value >> 12),
        5 => trunc(value >> 8),
        6 => trunc(value >> 4),
        _ => trunc(value),
    };
    ascii::hex_char(nibble)
}

fn timing_ns_hundreds(cycles: uint<7>) -> uint<4> {
    trunc(cycles `std::ops::comb_div` 10)
}

fn timing_ns_tens(cycles: uint<7>) -> uint<4> {
    trunc(cycles `std::ops::comb_mod` 10)
}

impl EchoMsg {
    pub(lib) fn as_option(self) -> Option<Self> {
        match self {
            Self::None => None,
            _ => Some(self),
        }
    }

    fn is_none(self) -> bool {
        if let Self::None = self { true } else { false }
    }

    fn byte(self, idx: EchoIdx) -> TxReq8 {
        match self {
            Self::None => tx_req_none(),
            Self::Byte$(byte) => tx_req_indexed([byte], idx),
            Self::CrLf => tx_req_indexed(b"\r\n", idx),
        }
    }
}

impl RespMsg {
    pub(lib) fn as_option(self) -> Option<Self> {
        match self {
            Self::None => None,
            _ => Some(self),
        }
    }

    fn is_none(self) -> bool {
        if let Self::None = self { true } else { false }
    }

    fn byte(self, idx: RespIdx) -> TxReq8 {
        match self {
            Self::None => tx_req_none(),
            Self::Ok => tx_req_indexed(b"OK\r\n", idx),
            Self::Busy => tx_req_indexed(b"BUSY\r\n", idx),
            Self::Err => tx_req_indexed(b"ERR\r\n", idx),
            Self::Timing$(cycles) => timing_byte(b'T', cycles, idx),
            Self::CtrlTiming$(cycles) => timing_byte(b'C', cycles, idx),
            Self::Read$(addr, value) => match idx {
                0 => tx_req_byte(offset_hex_char(addr, 0)),
                1 => tx_req_byte(offset_hex_char(addr, 1)),
                2 => tx_req_byte(offset_hex_char(addr, 2)),
                3 => tx_req_byte(b'='),
                4 => tx_req_byte(ascii::byte_hex_high(value)),
                5 => tx_req_byte(ascii::byte_hex_low(value)),
                6 => tx_req_byte(b'\r'),
                7 => tx_req_byte(b'\n'),
                _ => tx_req_none(),
            },
            Self::FtStatus$(status) => if idx < 7 {
                tx_req_indexed(b"FS,CFG=", idx)
            } else if idx == 7 {
                tx_req_byte(ascii::byte_hex_high(status.config))
            } else if idx == 8 {
                tx_req_byte(ascii::byte_hex_low(status.config))
            } else if idx < 15 {
                tx_req_indexed(b",MODE=", idx -. 9)
            } else if idx == 15 {
                tx_req_byte(ascii::byte_hex_high(status.mode))
            } else if idx == 16 {
                tx_req_byte(ascii::byte_hex_low(status.mode))
            } else if idx < 23 {
                tx_req_indexed(b",UART=", idx -. 17)
            } else if idx == 23 {
                tx_req_byte(ascii::bool_char(status.uart_active))
            } else if idx < 29 {
                tx_req_indexed(b",WIN=", idx -. 24)
            } else if idx == 29 {
                tx_req_byte(ascii::bool_char(status.window_active))
            } else if idx < 35 {
                tx_req_indexed(b",CAP=", idx -. 30)
            } else if idx == 35 {
                tx_req_byte(ascii::bool_char(status.capture_active))
            } else if idx < 42 {
                tx_req_indexed(b",SOVF=0", idx -. 36)
            } else if idx < 50 {
                tx_req_byte(u32_hex_char(status.session_overflow, trunc(idx -. 42)))
            } else if idx < 56 {
                tx_req_indexed(b",OVF=0", idx -. 50)
            } else if idx < 64 {
                tx_req_byte(u32_hex_char(status.overflow, trunc(idx -. 56)))
            } else if idx == 64 {
                tx_req_byte(b'\r')
            } else if idx == 65 {
                tx_req_byte(b'\n')
            } else {
                tx_req_none()
            },
            Self::MeasureStatus$(status) => if idx < 7 {
                tx_req_indexed(b"MS,CNT=", idx)
            } else if idx == 7 {
                tx_req_byte(ascii::byte_hex_high(status.count))
            } else if idx == 8 {
                tx_req_byte(ascii::byte_hex_low(status.count))
            } else if idx < 14 {
                tx_req_indexed(b",OVF=0", idx -. 9)
            } else if idx < 22 {
                tx_req_byte(u32_hex_char(status.overflow, trunc(idx -. 14)))
            } else if idx < 27 {
                tx_req_indexed(b",ARM=", idx -. 22)
            } else if idx == 27 {
                tx_req_byte(ascii::bool_char(status.armed))
            } else if idx == 28 {
                tx_req_byte(b'\r')
            } else if idx == 29 {
                tx_req_byte(b'\n')
            } else {
                tx_req_none()
            },
        }
    }
}

impl MeasureMsg {
    pub(lib) fn as_option(self) -> Option<Self> {
        match self {
            Self::None => None,
            _ => Some(self),
        }
    }

    fn is_none(self) -> bool {
        if let Self::None = self { true } else { false }
    }

    fn byte(self, idx: MeasureIdx) -> TxReq8 {
        match self {
            Self::None => tx_req_none(),
            Self::Report$(report) => if idx < 5 {
                tx_req_indexed(b"MR,S=", idx)
            } else if idx == 5 {
                tx_req_byte(ascii::byte_hex_high(report.start_tag))
            } else if idx == 6 {
                tx_req_byte(ascii::byte_hex_low(report.start_tag))
            } else if idx < 10 {
                tx_req_indexed(b",E=", idx -. 7)
            } else if idx == 10 {
                tx_req_byte(ascii::byte_hex_high(report.stop_tag))
            } else if idx == 11 {
                tx_req_byte(ascii::byte_hex_low(report.stop_tag))
            } else if idx < 16 {
                tx_req_indexed(b",TK=", idx -. 12)
            } else if idx < 24 {
                tx_req_byte(u32_hex_char(report.delta_ticks, trunc(idx -. 16)))
            } else if idx < 28 {
                tx_req_indexed(b",EV=", idx -. 24)
            } else if idx < 36 {
                tx_req_byte(u32_hex_char(report.delta_events, trunc(idx -. 28)))
            } else if idx < 40 {
                tx_req_indexed(b",AU=", idx -. 36)
            } else if idx < 48 {
                tx_req_byte(u32_hex_char(report.delta_addr_uart, trunc(idx -. 40)))
            } else if idx < 52 {
                tx_req_indexed(b",FO=", idx -. 48)
            } else if idx < 60 {
                tx_req_byte(u32_hex_char(report.delta_ft_overflow, trunc(idx -. 52)))
            } else if idx == 60 {
                tx_req_byte(b'\r')
            } else if idx == 61 {
                tx_req_byte(b'\n')
            } else {
                tx_req_none()
            },
            Self::End => if idx < 4 {
                tx_req_indexed(b"MEND", idx)
            } else if idx == 4 {
                tx_req_byte(b'\r')
            } else if idx == 5 {
                tx_req_byte(b'\n')
            } else {
                tx_req_none()
            },
        }
    }
}

pub(lib) fn echo_stream_step(
    state: EchoStreamState,
    block_tx: bool,
    next_msg: Option<EchoMsg>,
) -> EchoStreamOut {
    state.step_with_option(
        EchoMsg::None(),
        fn |stream_msg| { stream_msg.is_none() },
        fn |stream_msg, idx| { stream_msg.byte(idx) },
        block_tx,
        next_msg,
    )
}

pub(lib) fn resp_stream_step(
    state: RespStreamState,
    block_tx: bool,
    next_msg: Option<RespMsg>,
) -> RespStreamOut {
    state.step_with_option(
        RespMsg::None(),
        fn |stream_msg| { stream_msg.is_none() },
        fn |stream_msg, idx| { stream_msg.byte(idx) },
        block_tx,
        next_msg,
    )
}

pub(lib) fn measure_stream_step(
    state: MeasureStreamState,
    block_tx: bool,
    next_msg: Option<MeasureMsg>,
) -> MeasureStreamOut {
    state.step_with_option(
        MeasureMsg::None(),
        fn |stream_msg| { stream_msg.is_none() },
        fn |stream_msg, idx| { stream_msg.byte(idx) },
        block_tx,
        next_msg,
    )
}
