use shared_components::serial::{FtBe, FtData};

pub type BridgeCount = uint<16>;
pub type PackedFtWord = uint<18>;

pub enum ParserPhase {
    Idle,
    NeedHex1,
    NeedHex2,
    NeedHex3,
    NeedLineEnd,
    NeedBeLineEnd,
    CmdHelp,
    CmdStatus,
    Error,
}

pub struct LineParserState {
    phase: ParserPhase,
    word: FtData,
    be: FtBe,
}

pub enum ParserEvent {
    None,
    Send{word: FtData, be: FtBe},
    Help,
    Status,
    ParseErr,
}

pub struct ParserStepOut {
    state: LineParserState,
    event: ParserEvent,
}

impl Default for LineParserState {
    fn default() -> Self {
        LineParserState$(
            phase: ParserPhase::Idle(),
            word: 0,
            be: 0x3,
        )
    }
}

impl ParserEvent {
    pub fn is_none(self) -> bool {
        if let Self::None = self { true } else { false }
    }

    pub fn is_send(self) -> bool {
        if let Self::Send(_, _) = self { true } else { false }
    }

    pub fn send_word(self) -> FtData {
        if let Self::Send(word, _) = self { word } else { 0 }
    }

    pub fn send_be(self) -> FtBe {
        if let Self::Send(_, be) = self { be } else { 0x3 }
    }

    pub fn is_parse_err(self) -> bool {
        if let Self::ParseErr = self { true } else { false }
    }
}

impl ParserStepOut {
    // The byte moved the parser on, possibly emitting something.
    #[inline]
    fn advance(phase: ParserPhase, word: FtData, be: FtBe, event: ParserEvent) -> Self {
        Self$(
            state: LineParserState$(phase: phase, word: word, be: be),
            event: event,
        )
    }

    // The byte changed nothing.
    #[inline]
    fn stay(state: LineParserState) -> Self {
        Self$(state: state, event: ParserEvent::None())
    }

    // The line is unusable: report it and start the next one from scratch.
    #[inline]
    fn error() -> Self {
        Self$(state: LineParserState::default(), event: ParserEvent::ParseErr())
    }
}

pub fn line_parser_step(
    state: LineParserState,
    rx_valid: bool,
    rx_parity_error: bool,
    rx_byte: uint<8>,
) -> ParserStepOut {
    if !rx_valid {
        ParserStepOut::stay(state)
    } else if rx_parity_error {
        ParserStepOut::error()
    } else {
        let decoded = rx_byte.decode_hex();
        let nibble_ok = decoded.valid;
        let nibble = decoded.value;
        let next_word = (state.word << 4) | zext(nibble);

        match state.phase {
            ParserPhase::Idle => {
                if rx_byte.is_line_end() {
                    ParserStepOut::stay(state)
                } else if rx_byte == b'?' {
                    ParserStepOut::advance(ParserPhase::CmdStatus(), 0, 0x3, ParserEvent::None())
                } else if rx_byte.to_upper() == b'H' {
                    ParserStepOut::advance(ParserPhase::CmdHelp(), 0, 0x3, ParserEvent::None())
                } else if nibble_ok {
                    ParserStepOut::advance(ParserPhase::NeedHex1(), zext(nibble), 0x3, ParserEvent::None())
                } else {
                    ParserStepOut::advance(ParserPhase::Error(), 0, 0x3, ParserEvent::None())
                }
            },
            ParserPhase::NeedHex1 => {
                if nibble_ok {
                    ParserStepOut::advance(ParserPhase::NeedHex2(), next_word, state.be, ParserEvent::None())
                } else {
                    ParserStepOut::advance(ParserPhase::Error(), state.word, state.be, ParserEvent::None())
                }
            },
            ParserPhase::NeedHex2 => {
                if nibble_ok {
                    ParserStepOut::advance(ParserPhase::NeedHex3(), next_word, state.be, ParserEvent::None())
                } else {
                    ParserStepOut::advance(ParserPhase::Error(), state.word, state.be, ParserEvent::None())
                }
            },
            ParserPhase::NeedHex3 => {
                if nibble_ok {
                    ParserStepOut::advance(ParserPhase::NeedLineEnd(), next_word, state.be, ParserEvent::None())
                } else {
                    ParserStepOut::advance(ParserPhase::Error(), state.word, state.be, ParserEvent::None())
                }
            },
            ParserPhase::NeedLineEnd => {
                if rx_byte == b'/' {
                    ParserStepOut::advance(ParserPhase::NeedBeLineEnd(), state.word, state.be, ParserEvent::None())
                } else if rx_byte.is_line_end() {
                    ParserStepOut::advance(ParserPhase::Idle(), 0, 0x3, ParserEvent::Send(state.word, state.be))
                } else {
                    ParserStepOut::advance(ParserPhase::Error(), state.word, state.be, ParserEvent::None())
                }
            },
            ParserPhase::NeedBeLineEnd => {
                let be_digit = rx_byte.decode_digit_max(3);
                if be_digit.valid {
                    ParserStepOut::advance(
                        ParserPhase::NeedLineEnd(),
                        state.word,
                        trunc(be_digit.value),
                        ParserEvent::None(),
                    )
                } else {
                    ParserStepOut::advance(ParserPhase::Error(), state.word, state.be, ParserEvent::None())
                }
            },
            ParserPhase::CmdHelp => {
                if rx_byte.is_line_end() {
                    ParserStepOut::advance(ParserPhase::Idle(), 0, 0x3, ParserEvent::Help())
                } else {
                    ParserStepOut::advance(ParserPhase::Error(), 0, 0x3, ParserEvent::None())
                }
            },
            ParserPhase::CmdStatus => {
                if rx_byte.is_line_end() {
                    ParserStepOut::advance(ParserPhase::Idle(), 0, 0x3, ParserEvent::Status())
                } else {
                    ParserStepOut::advance(ParserPhase::Error(), 0, 0x3, ParserEvent::None())
                }
            },
            ParserPhase::Error => {
                if rx_byte.is_line_end() {
                    ParserStepOut::error()
                } else {
                    ParserStepOut::advance(ParserPhase::Error(), state.word, state.be, ParserEvent::None())
                }
            },
        }
    }
}

pub fn pack_ft_word(word: FtData, be: FtBe) -> PackedFtWord {
    (zext(be) << 16) | zext(word)
}

pub fn unpack_ft_word(packed: PackedFtWord) -> FtData {
    trunc(packed)
}

pub fn unpack_ft_be(packed: PackedFtWord) -> FtBe {
    trunc(packed >> 16)
}

// The four hex digits of a 16-bit value, most significant first.
fn word_hex_char(value: uint<16>, idx: uint<3>) -> uint<8> {
    let nibble: uint<4> = match idx {
        0 => trunc(value >> 12),
        1 => trunc(value >> 8),
        2 => trunc(value >> 4),
        _ => trunc(value),
    };
    nibble.hex_char()
}

pub fn packed_ft_byte(word: FtData, be: FtBe, idx: uint<3>) -> uint<8> {
    let be_nibble: uint<4> = zext(be);
    if idx < 4 {
        word_hex_char(word, idx)
    } else {
        match idx {
            4 => b'/',
            5 => be_nibble.hex_char(),
            6 => b'\r',
            _ => b'\n',
        }
    }
}

pub fn status_byte(
    rx_count: BridgeCount,
    tx_count: BridgeCount,
    err_count: BridgeCount,
    stall_count: BridgeCount,
    idx: uint<6>,
) -> uint<8> {
    if idx == 0 {
        b'R'
    } else if idx >= 1 && idx <= 4 {
        word_hex_char(rx_count, trunc(idx -. 1))
    } else if idx == 5 {
        b' '
    } else if idx == 6 {
        b'T'
    } else if idx >= 7 && idx <= 10 {
        word_hex_char(tx_count, trunc(idx -. 7))
    } else if idx == 11 {
        b' '
    } else if idx == 12 {
        b'E'
    } else if idx >= 13 && idx <= 16 {
        word_hex_char(err_count, trunc(idx -. 13))
    } else if idx == 17 {
        b' '
    } else if idx == 18 {
        b'S'
    } else if idx >= 19 && idx <= 22 {
        word_hex_char(stall_count, trunc(idx -. 19))
    } else if idx == 23 {
        b'\r'
    } else {
        b'\n'
    }
}
