pub type RomData = uint<8>;
pub type RomAddr = uint<16>;
pub type RomBank = uint<2>;
pub type RamAddr = uint<15>;
pub type FtWord = uint<16>;

#[no_mangle(all)]
extern entity simple_dual_port_ram<#uint WIDTH, #uint ENTRIES>(
    wclk: clock,
    waddr: uint<{uint::bits_for(ENTRIES - 1)}>,
    write_data: uint<WIDTH>,
    write_enable: bool,
    rclk: clock,
    raddr: uint<{uint::bits_for(ENTRIES - 1)}>,
    read_data: inv uint<WIDTH>,
);

pub enum ReadState {
    Init,
    FillBank0,
    FillBank1,
    Ready,
    HoldData,
}

pub enum StreamingState {
    Ready,
    RequestData,
    GetSize,
    FillBank,
    FillBank2,
    Done,
}

pub struct StreamingRomState {
    read_state: ReadState,
    streaming_state: StreamingState,
    num_data_request: FtWord,
    num_streaming_bank: RomBank,
    streaming_data_size: FtWord,
    streaming_index: FtWord,
    write_byte2: RomData,
    last_bank: RomBank,
    last_addr: RomAddr,
}

pub struct StreamingRomInputs {
    ft_ui_din_full: bool,
    ft_ui_dout_empty: bool,
    ft_ui_dout: FtWord,
    mreq_fall: bool,
    mreq_rise: bool,
    addr_sync: RomAddr,
    addr_bnk_sync: RomBank,
    addr_cerom2_sync: bool,
}

pub struct StreamingRomStep {
    next_state: StreamingRomState,
    ft_ui_din: FtWord,
    ft_ui_din_be: uint<2>,
    ft_ui_din_valid: bool,
    ft_ui_dout_get: bool,
    ram_waddr: RamAddr,
    ram_write_data: RomData,
    ram_write_enable: bool,
    ram_raddr: RamAddr,
    data_oe: bool,
}

pub struct StreamingRomOut {
    ft_ui_din: FtWord,
    ft_ui_din_be: uint<2>,
    ft_ui_din_valid: bool,
    ft_ui_dout_get: bool,
    data_drive: RomData,
    data_oe: bool,
    read_state_code: uint<3>,
    streaming_state_code: uint<3>,
    num_streaming_bank: RomBank,
    num_data_request: FtWord,
    streaming_data_size: FtWord,
    streaming_index: FtWord,
}

impl Default for StreamingRomState {
    fn default() -> Self {
        StreamingRomState$(
            read_state: ReadState::Init(),
            streaming_state: StreamingState::Ready(),
            num_data_request: 0,
            num_streaming_bank: 0,
            streaming_data_size: 0,
            streaming_index: 0,
            write_byte2: 0,
            last_bank: 0,
            last_addr: 0,
        )
    }
}

impl ReadState {
    /// The value the `read_state_debug` port and the LEDs show.
    pub fn code(self) -> uint<3> {
        match self {
            Self::Init => 0,
            Self::FillBank0 => 1,
            Self::FillBank1 => 2,
            Self::Ready => 3,
            Self::HoldData => 4,
        }
    }
}

fn bank_ram_addr(bank: RomBank, offset: RomAddr) -> RamAddr {
    let bank_base: uint<17> = zext(bank) << 14;
    let offset_wide: uint<17> = zext(offset);
    trunc(bank_base + offset_wide)
}

impl StreamingState {
    /// The value the `streaming_state_debug` port and the LEDs show.
    pub fn code(self) -> uint<3> {
        match self {
            Self::Ready => 0,
            Self::RequestData => 1,
            Self::GetSize => 2,
            Self::FillBank => 3,
            Self::FillBank2 => 4,
            Self::Done => 5,
        }
    }

    fn is_ready(self) -> bool {
        if let Self::Ready = self { true } else { false }
    }

    fn is_done(self) -> bool {
        if let Self::Done = self { true } else { false }
    }
}

// Spade has no functional-update syntax, so every transition below has to
// restate the fields it leaves alone. They are methods on the state rather than
// free functions so that a chain of them reads as a sequence of transitions.
impl StreamingRomState {
    fn with_read_state(self, read_state: ReadState) -> Self {
        Self$(
            read_state: read_state,
            streaming_state: self.streaming_state,
            num_data_request: self.num_data_request,
            num_streaming_bank: self.num_streaming_bank,
            streaming_data_size: self.streaming_data_size,
            streaming_index: self.streaming_index,
            write_byte2: self.write_byte2,
            last_bank: self.last_bank,
            last_addr: self.last_addr,
        )
    }

    fn with_streaming_state(self, streaming_state: StreamingState) -> Self {
        Self$(
            read_state: self.read_state,
            streaming_state: streaming_state,
            num_data_request: self.num_data_request,
            num_streaming_bank: self.num_streaming_bank,
            streaming_data_size: self.streaming_data_size,
            streaming_index: self.streaming_index,
            write_byte2: self.write_byte2,
            last_bank: self.last_bank,
            last_addr: self.last_addr,
        )
    }

    fn begin_bank_fill(self, bank: RomBank) -> Self {
        Self$(
            read_state: self.read_state,
            streaming_state: StreamingState::RequestData(),
            num_data_request: self.num_data_request,
            num_streaming_bank: bank,
            streaming_data_size: self.streaming_data_size,
            streaming_index: self.streaming_index,
            write_byte2: self.write_byte2,
            last_bank: self.last_bank,
            last_addr: self.last_addr,
        )
    }

    fn finish_initial_bank(self, next_read_state: ReadState) -> Self {
        Self$(
            read_state: next_read_state,
            streaming_state: StreamingState::Ready(),
            num_data_request: self.num_data_request,
            num_streaming_bank: self.num_streaming_bank,
            streaming_data_size: self.streaming_data_size,
            streaming_index: self.streaming_index,
            write_byte2: self.write_byte2,
            last_bank: self.last_bank,
            last_addr: self.last_addr,
        )
    }

    fn capture_read(self, inputs: StreamingRomInputs) -> Self {
        let selected_streaming_bank = inputs.addr_bnk_sync == self.num_streaming_bank;
        Self$(
            read_state: ReadState::HoldData(),
            streaming_state: if selected_streaming_bank {
                StreamingState::RequestData()
            } else {
                self.streaming_state
            },
            num_data_request: self.num_data_request,
            num_streaming_bank: if selected_streaming_bank {
                if self.num_streaming_bank == 0 { 1 } else { 0 }
            } else {
                self.num_streaming_bank
            },
            streaming_data_size: self.streaming_data_size,
            streaming_index: self.streaming_index,
            write_byte2: self.write_byte2,
            last_bank: inputs.addr_bnk_sync,
            last_addr: inputs.addr_sync -. 0x8000,
        )
    }

    fn accept_request(self) -> Self {
        Self$(
            read_state: self.read_state,
            streaming_state: StreamingState::GetSize(),
            num_data_request: self.num_data_request +. 1,
            num_streaming_bank: self.num_streaming_bank,
            streaming_data_size: self.streaming_data_size,
            streaming_index: self.streaming_index,
            write_byte2: self.write_byte2,
            last_bank: self.last_bank,
            last_addr: self.last_addr,
        )
    }

    fn accept_size(self, size: FtWord) -> Self {
        Self$(
            read_state: self.read_state,
            streaming_state: StreamingState::FillBank(),
            num_data_request: self.num_data_request,
            num_streaming_bank: self.num_streaming_bank,
            streaming_data_size: size,
            streaming_index: 0,
            write_byte2: self.write_byte2,
            last_bank: self.last_bank,
            last_addr: self.last_addr,
        )
    }

    fn accept_low_byte(self, word: FtWord) -> Self {
        Self$(
            read_state: self.read_state,
            streaming_state: StreamingState::FillBank2(),
            num_data_request: self.num_data_request,
            num_streaming_bank: self.num_streaming_bank,
            streaming_data_size: self.streaming_data_size,
            streaming_index: self.streaming_index +. 1,
            write_byte2: trunc(word >> 8),
            last_bank: self.last_bank,
            last_addr: self.last_addr,
        )
    }

    fn write_high_byte(self) -> Self {
        Self$(
            read_state: self.read_state,
            streaming_state: StreamingState::FillBank(),
            num_data_request: self.num_data_request,
            num_streaming_bank: self.num_streaming_bank,
            streaming_data_size: self.streaming_data_size,
            streaming_index: self.streaming_index +. 1,
            write_byte2: self.write_byte2,
            last_bank: self.last_bank,
            last_addr: self.last_addr,
        )
    }

    fn step_read(self, inputs: StreamingRomInputs) -> Self {
        match self.read_state {
            ReadState::Init => self.with_read_state(ReadState::FillBank0()),
            ReadState::FillBank0 if self.streaming_state.is_ready() => self.begin_bank_fill(0),
            ReadState::FillBank0 if self.streaming_state.is_done() => self.finish_initial_bank(ReadState::FillBank1()),
            ReadState::FillBank1 if self.streaming_state.is_ready() => self.begin_bank_fill(1),
            ReadState::FillBank1 if self.streaming_state.is_done() => self.finish_initial_bank(ReadState::Ready()),
            ReadState::Ready if inputs.mreq_fall && !inputs.addr_cerom2_sync => self.capture_read(inputs),
            ReadState::HoldData if inputs.mreq_rise => self.with_read_state(ReadState::Ready()),
            _ => self,
        }
    }

    pub fn step(self, inputs: StreamingRomInputs) -> StreamingRomStep {
        // Lucid's read-state case runs before its streaming-state case. Both
        // can update streaming_state, so preserve that ordering explicitly.
        let read_next = self.step_read(inputs);

        let request_fire = if let StreamingState::RequestData = self.streaming_state {
            !inputs.ft_ui_din_full
        } else {
            false
        };
        let size_fire = if let StreamingState::GetSize = self.streaming_state {
            !inputs.ft_ui_dout_empty
        } else {
            false
        };
        let low_byte_fire = if let StreamingState::FillBank = self.streaming_state {
            self.streaming_index < self.streaming_data_size && !inputs.ft_ui_dout_empty
        } else {
            false
        };
        let high_byte_fire = if let StreamingState::FillBank2 = self.streaming_state {
            true
        } else {
            false
        };

        let stream_next = match self.streaming_state {
            StreamingState::RequestData if request_fire => read_next.accept_request(),
            StreamingState::GetSize if size_fire => read_next.accept_size(inputs.ft_ui_dout),
            StreamingState::FillBank if self.streaming_index >= self.streaming_data_size => read_next.with_streaming_state(StreamingState::Done()),
            StreamingState::FillBank if low_byte_fire => read_next.accept_low_byte(inputs.ft_ui_dout),
            StreamingState::FillBank2 => read_next.write_high_byte(),
            _ => read_next,
        };

        let ram_raddr = if let ReadState::HoldData = self.read_state {
            bank_ram_addr(self.last_bank, self.last_addr)
        } else {
            0
        };
        let ram_waddr = bank_ram_addr(self.num_streaming_bank, self.streaming_index);

        StreamingRomStep$(
            next_state: stream_next,
            ft_ui_din: self.num_data_request,
            ft_ui_din_be: if request_fire { 0b11 } else { 0 },
            ft_ui_din_valid: request_fire,
            ft_ui_dout_get: size_fire || low_byte_fire,
            ram_waddr: ram_waddr,
            ram_write_data: if high_byte_fire { self.write_byte2 } else { trunc(inputs.ft_ui_dout) },
            ram_write_enable: low_byte_fire || high_byte_fire,
            ram_raddr: ram_raddr,
            data_oe: if let ReadState::HoldData = self.read_state { true } else { false },
        )
    }
}

pub entity streaming_rom_core(
    clk: clock,
    rst: bool,
    inputs: StreamingRomInputs,
) -> StreamingRomOut {
    reg(clk) state: StreamingRomState reset(rst: StreamingRomState::default()) =
        state.step(inputs).next_state;
    let step = state.step(inputs);

    let (ram_read_data, ram_read_data_w): (RomData, inv RomData) = port();
    #[verilog_attrs(keep_hierarchy = "yes")]
    inst simple_dual_port_ram::<8, 32768>(
        clk,
        step.ram_waddr,
        step.ram_write_data,
        step.ram_write_enable,
        clk,
        step.ram_raddr,
        ram_read_data_w,
    );

    StreamingRomOut$(
        ft_ui_din: step.ft_ui_din,
        ft_ui_din_be: step.ft_ui_din_be,
        ft_ui_din_valid: step.ft_ui_din_valid,
        ft_ui_dout_get: step.ft_ui_dout_get,
        data_drive: ram_read_data,
        data_oe: step.data_oe,
        read_state_code: state.read_state.code(),
        streaming_state_code: state.streaming_state.code(),
        num_streaming_bank: state.num_streaming_bank,
        num_data_request: state.num_data_request,
        streaming_data_size: state.streaming_data_size,
        streaming_index: state.streaming_index,
    )
}
