pub struct HexDecode {
    valid: bool,
    value: uint<4>,
}

pub struct DigitDecode {
    valid: bool,
    value: uint<4>,
}

// "no digit here": what every failed decode in this module returns. A `///` doc
// comment does not go here -- v0.20.0 parses one as an attribute and rejects
// attributes on an `impl`.
impl Default for DigitDecode {
    #[inline]
    fn default() -> Self {
        DigitDecode$(valid: false, value: 0)
    }
}

// A nibble renders itself. A method's receiver has to have a known type, and
// `trunc`/`zext` take theirs from the context, so a caller slicing a nibble out
// of a wider word names it in a typed `let` first.
impl uint<4> {
    pub fn hex_char(self) -> uint<8> {
        let value: uint<8> = zext(self);
        if self < 10 {
            b'0' +. value
        } else {
            b'A' +. (value -. 10)
        }
    }

    pub fn digit_char(self) -> uint<8> {
        b'0' +. zext(self)
    }
}

// A flag renders as one digit, exactly as a nibble does.
impl bool {
    pub fn digit_char(self) -> uint<8> {
        if self { b'1' } else { b'0' }
    }
}

impl uint<8> {
    pub fn hex_high(self) -> uint<8> {
        let nibble: uint<4> = trunc(self >> 4);
        nibble.hex_char()
    }

    pub fn hex_low(self) -> uint<8> {
        let nibble: uint<4> = trunc(self);
        nibble.hex_char()
    }

    pub fn to_upper(self) -> uint<8> {
        let case_delta: uint<8> = b'a' -. b'A';
        if self >= b'a' && self <= b'z' {
            self -. case_delta
        } else {
            self
        }
    }

    pub fn is_digit(self) -> bool {
        self >= b'0' && self <= b'9'
    }

    pub fn digit_value(self) -> uint<4> {
        trunc(self - b'0')
    }

    pub fn decode_digit(self) -> DigitDecode {
        if self.is_digit() {
            DigitDecode$(valid: true, value: self.digit_value())
        } else {
            DigitDecode::default()
        }
    }

    pub fn decode_digit_max(self, max_value: uint<4>) -> DigitDecode {
        let decoded = self.decode_digit();
        if decoded.valid && decoded.value <= max_value {
            decoded
        } else {
            DigitDecode::default()
        }
    }

    pub fn is_line_end(self) -> bool {
        self == b'\r' || self == b'\n'
    }

    pub fn decode_hex(self) -> HexDecode {
        let upper = self.to_upper();
        if upper.is_digit() {
            HexDecode$(valid: true, value: upper.digit_value())
        } else if upper >= b'A' && upper <= b'F' {
            let alpha_value: uint<4> = trunc((upper -. b'A') +. 10);
            HexDecode$(valid: true, value: alpha_value)
        } else {
            HexDecode$(valid: false, value: 0)
        }
    }
}
