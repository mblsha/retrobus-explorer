#[no_mangle(all)]
entity tb_fifo(
    clk: clock,
    rst: bool,
    din: uint<8>,
    wput: bool,
    rget: bool,
    full: inv &bool,
    empty: inv &bool,
    dout: inv &uint<8>,
    used: inv &uint<4>,
) {
    let out = inst fifo::<8, 8>(clk, rst, din, wput, rget);
    set full = &out.full;
    set empty = &out.empty;
    set dout = &out.dout;
    set used = &out.used;
}

#[no_mangle(all)]
entity tb_async_fifo_u8(
    wclk: clock,
    wrst: bool,
    din: uint<8>,
    wput: bool,
    rclk: clock,
    rrst: bool,
    rget: bool,
    full: inv &bool,
    empty: inv &bool,
    dout: inv &uint<8>,
) {
    let out = inst async_fifo::<8, 8, 3>(wclk, wrst, din, wput, rclk, rrst, rget);
    out.inst tap(full, empty, dout);
}

#[no_mangle(all)]
entity tb_ft(
    clk: clock,
    rst: bool,
    ft_clk: clock,
    ft_rxf: bool,
    ft_txe: bool,
    ft_data_in: FtData,
    ft_be_in: FtBe,
    ui_din: FtData,
    ui_din_be: FtBe,
    ui_din_valid: bool,
    ui_dout_get: bool,
    ft_data_out: inv &FtData,
    ft_be_out: inv &FtBe,
    ft_rd: inv &bool,
    ft_wr: inv &bool,
    ft_oe: inv &bool,
    ui_din_full: inv &bool,
    ui_dout: inv &FtData,
    ui_dout_be: inv &FtBe,
    ui_dout_empty: inv &bool,
) {
    let out = inst ft::<16, 2, 64, 64, 1, 0>(
        clk,
        rst,
        ft_clk,
        ft_rxf,
        ft_txe,
        ft_data_in,
        ft_be_in,
        ui_din,
        ui_din_be,
        ui_din_valid,
        ui_dout_get,
    );
    inst ft_out_tap(
        out,
        ft_data_out,
        ft_be_out,
        ft_rd,
        ft_wr,
        ft_oe,
        ui_din_full,
        ui_dout,
        ui_dout_be,
        ui_dout_empty,
    );
}

#[no_mangle(all)]
entity tb_async_uart_monitor_queue_only(
    wclk: clock,
    wrst: bool,
    din: uint<8>,
    wput: bool,
    rclk: clock,
    rrst: bool,
    monitor_line: inv &bool,
    monitor_busy: inv &bool,
    monitor_full: inv &bool,
    monitor_empty: inv &bool,
    monitor_dout: inv &uint<8>,
    bridge_line: inv &bool,
    bridge_busy: inv &bool,
    bridge_full: inv &bool,
    bridge_empty: inv &bool,
    bridge_dout: inv &uint<8>,
    bridge_tx_fire: inv &bool,
    bridge_dropped: inv &bool,
    bridge_dropped_count: inv &uint<8>,
) {
    let monitor = inst async_uart_monitor::<8, 4, 3, 40, 10>(
        wclk,
        wrst,
        din,
        wput,
        rclk,
        rrst,
    );
    let bridge = inst uart_fifo_bridge::<8, 4, 3, 40, 10, 8>(
        wclk,
        wrst,
        din,
        wput,
        rclk,
        rrst,
        true,
        BridgePolicy::QueueOnly(),
    );

    set monitor_line = &monitor.line;
    set monitor_busy = &monitor.busy;
    set monitor_full = &monitor.fifo_full;
    set monitor_empty = &monitor.fifo_empty;
    set monitor_dout = &monitor.fifo_dout;
    set bridge_line = &bridge.line;
    set bridge_busy = &bridge.busy;
    set bridge_full = &bridge.fifo_full;
    set bridge_empty = &bridge.fifo_empty;
    set bridge_dout = &bridge.fifo_dout;
    set bridge_tx_fire = &bridge.tx_fire;
    set bridge_dropped = &bridge.dropped;
    set bridge_dropped_count = &bridge.dropped_count;
}

#[no_mangle(all)]
entity tb_elastic_buffer_u8(
    clk: clock,
    rst: bool,
    capture_valid: bool,
    capture_data: uint<8>,
    sink_full: bool,
    pending_valid: inv &bool,
    pending_data: inv &uint<8>,
    sink_wput: inv &bool,
    sink_data: inv &uint<8>,
    accepted: inv &bool,
    dropped: inv &bool,
) {
    reg(clk) slot: ElasticSlotState<uint<8>> reset(rst: elastic_slot_reset(0)) = {
        elastic_slot_step(slot, capture_valid, capture_data, sink_full).next_state
    };
    let step = elastic_slot_step(slot, capture_valid, capture_data, sink_full);

    set pending_valid = &step.pending_valid;
    set pending_data = &step.pending_data;
    set sink_wput = &step.sink_wput;
    set sink_data = &step.sink_data;
    set accepted = &step.accepted;
    set dropped = &step.dropped;
}

#[no_mangle(all)]
entity tb_uart_tx_adapter_equiv(
    clk: clock,
    rst: bool,
    block: bool,
    tx_valid: bool,
    tx_byte: uint<8>,
    direct_line: inv &bool,
    direct_busy: inv &bool,
    adapter_line: inv &bool,
    adapter_busy: inv &bool,
) {
    let (direct, direct_w): (UartLineBusyPort, inv UartLineBusyPort) = port;
    let (adapter, adapter_w): (UartLineBusyPort, inv UartLineBusyPort) = port;

    inst au_usb_uart_tx8_tap(
        clk,
        rst,
        block,
        tx_byte,
        tx_valid,
        direct_w.line,
        direct_w.busy,
    );
    inst au_usb_uart_tx8_req_tap(
        clk,
        rst,
        block,
        TxReq8$(valid: tx_valid, byte: tx_byte),
        adapter_w.line,
        adapter_w.busy,
    );

    set direct_line = direct.line;
    set direct_busy = direct.busy;
    set adapter_line = adapter.line;
    set adapter_busy = adapter.busy;
}

#[no_mangle(all)]
entity tb_uart_tx_tap_equiv(
    clk: clock,
    rst: bool,
    block: bool,
    tx_valid: bool,
    tx_byte: uint<8>,
    core_line: inv &bool,
    core_busy: inv &bool,
    tap_line: inv &bool,
    tap_busy: inv &bool,
) {
    let core = inst uart_tx::<40, 10, 8>(clk, rst, block, tx_byte, tx_valid);
    let (tap, tap_w): (UartLineBusyPort, inv UartLineBusyPort) = port;
    inst uart_tx_tap::<40, 10, 8>(
        clk,
        rst,
        block,
        tx_byte,
        tx_valid,
        tap_w.line,
        tap_w.busy,
    );

    set core_line = &core.tx;
    set core_busy = &core.busy;
    set tap_line = tap.line;
    set tap_busy = tap.busy;
}

#[no_mangle(all)]
entity tb_ft_out_tap(
    in_ft_data_out: FtData,
    in_ft_be_out: FtBe,
    in_ft_rd: bool,
    in_ft_wr: bool,
    in_ft_oe: bool,
    in_ui_din_full: bool,
    in_ui_dout: FtData,
    in_ui_dout_be: FtBe,
    in_ui_dout_empty: bool,
    ft_data_out: inv &FtData,
    ft_be_out: inv &FtBe,
    ft_rd: inv &bool,
    ft_wr: inv &bool,
    ft_oe: inv &bool,
    ui_din_full: inv &bool,
    ui_dout: inv &FtData,
    ui_dout_be: inv &FtBe,
    ui_dout_empty: inv &bool,
) {
    let out = FtOut$(
        ft_data_out: in_ft_data_out,
        ft_be_out: in_ft_be_out,
        ft_rd: in_ft_rd,
        ft_wr: in_ft_wr,
        ft_oe: in_ft_oe,
        ui_din_full: in_ui_din_full,
        ui_dout: in_ui_dout,
        ui_dout_be: in_ui_dout_be,
        ui_dout_empty: in_ui_dout_empty,
    );
    inst ft_out_tap(
        out,
        ft_data_out,
        ft_be_out,
        ft_rd,
        ft_wr,
        ft_oe,
        ui_din_full,
        ui_dout,
        ui_dout_be,
        ui_dout_empty,
    );
}
