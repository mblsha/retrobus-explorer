use super::{
    config::{au_usb_uart_rx, au_usb_uart_tx8_tap},
    message_stream::{TxReq8, tx_req_none, tx_req_or_else},
};

/// The position in a banner of `N` bytes.
type BannerIdx<#uint N> = uint<{uint::bits_for(N - 1)}>;

pub struct BootBannerState<#uint N> {
    active: bool,
    idx: BannerIdx<N>,
}

pub struct BootBannerOut<#uint N> {
    state: BootBannerState<N>,
    tx_req: TxReq8,
}

pub struct BootBannerTxGateOut {
    tx_req: TxReq8,
    app_tx_busy: bool,
}

// The banner is sending from the first cycle out of reset, starting at the
// first character. `X::<A>::default()` cannot be spelled on a generic type, so
// the one reader of this reaches the trait through the standard library's free
// `default()`, which takes its type from the `reg` annotation beside it.
impl<#uint N> Default for BootBannerState<N> {
    #[inline]
    fn default() -> Self {
        BootBannerState$(
            active: true,
            idx: 0,
        )
    }
}

pub fn boot_banner_step<#uint N>(
    state: BootBannerState<N>,
    banner: [uint<8>; N],
    block_tx: bool,
) -> BootBannerOut<N> {
    if !state.active || block_tx {
        BootBannerOut$(
            state: state,
            tx_req: tx_req_none(),
        )
    } else {
        // `N - 1` would widen by a bit and so type `N` one bit narrower than
        // the index; and when `N` is a power of two, `N` itself needs one bit
        // more than any index does.
        let banner_len: uint<{uint::bits_for(N)}> = N;
        let last_idx: BannerIdx<N> = trunc(banner_len -. 1);
        let done = state.idx == last_idx;
        BootBannerOut$(
            state: BootBannerState$(
                active: !done,
                idx: if done { 0 } else { state.idx +. 1 },
            ),
            tx_req: TxReq8$(valid: true, byte: banner[state.idx]),
        )
    }
}

#[inline]
pub entity boot_banner_core<#uint N>(
    clk: clock,
    rst: bool,
    banner: [uint<8>; N],
    block_tx: bool,
) -> BootBannerOut<N> {
    decl stepped;
    reg(clk) state: BootBannerState<N> reset(rst: default()) = stepped.state;
    let stepped = boot_banner_step(state, banner, block_tx);

    stepped
}

#[inline]
pub entity boot_banner_tx_gate<#uint N>(
    clk: clock,
    rst: bool,
    banner: [uint<8>; N],
    tx_busy: bool,
) -> BootBannerTxGateOut {
    let banner_out = inst boot_banner_core::<N>(
        clk,
        rst,
        banner,
        tx_busy,
    );

    BootBannerTxGateOut$(
        tx_req: banner_out.tx_req,
        app_tx_busy: tx_busy || banner_out.tx_req.valid,
    )
}

pub fn boot_banner_then_tx_req(banner_tx_req: TxReq8, app_tx_req: TxReq8) -> TxReq8 {
    tx_req_or_else(banner_tx_req, app_tx_req)
}

#[inline]
pub entity au_usb_uart_banner_then_loopback<#uint N>(
    clk: clock,
    rst: bool,
    usb_rx: bool,
    banner: [uint<8>; N],
    usb_tx: inv bool,
) {
    let (busy, busy_w): (bool, inv bool) = port();
    let rx = inst au_usb_uart_rx(clk, rst, usb_rx);
    let banner_out = inst boot_banner_core::<N>(
        clk,
        rst,
        banner,
        busy,
    );
    let banner_active = banner_out.tx_req.valid;
    let tx_data = if banner_active {
        banner_out.tx_req.byte
    } else {
        rx.byte
    };
    let tx_valid = banner_active || rx.valid;

    inst au_usb_uart_tx8_tap(
        clk,
        rst,
        false,
        tx_data,
        tx_valid,
        usb_tx,
        busy_w,
    );
}
