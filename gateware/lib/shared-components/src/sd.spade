// SD CRCs are MSB-first; Ethernet/UART image CRC32 is reflected IEEE CRC32.
//
// The three `*_over`/`*_rounds` helpers are the loops these CRCs used to be
// written out a step at a time. Each is `#[inline]` and `gen`-recursive, so it
// elaborates to exactly the chain of `crc*_bit` instances it replaces and costs
// no module of its own. `[T; N]::fold` says the same thing in one line, but
// `response48` needs the bits most significant first and the `reversed()` that
// gets them there drags eleven `split_at`/`concat` modules into every project
// that links this file -- the same trade `arrays::indices_from` documents.
pub fn crc7_bit(crc: uint<7>, bit: bool) -> uint<7> {
    (crc << 1) ^ (if crc.msb() ^^ bit { 0x09 } else { 0 })
}

pub fn crc16_bit(crc: uint<16>, bit: bool) -> uint<16> {
    (crc << 1) ^ (if crc.msb() ^^ bit { 0x1021 } else { 0 })
}

fn crc32_bit(crc: uint<32>, bit: bool) -> uint<32> {
    (crc >> 1) ^ (if crc.lsb() ^^ bit { 0xedb88320 } else { 0 })
}

/// `crc32_bit` over `bits`, least significant first.
#[inline]
fn crc32_over<#uint N>(crc: uint<32>, bits: [bool; N]) -> uint<32> {
    gen if N == 0 {
        crc
    } else {
        crc32_over(crc32_bit(crc, bits[0]), bits[1..])
    }
}

pub fn crc32_byte(crc: uint<32>, byte: uint<8>) -> uint<32> {
    crc32_over(crc, byte.as_bits())
}

fn crc8_bit(crc: uint<8>) -> uint<8> {
    (crc << 1) ^ (if crc.msb() { 7 } else { 0 })
}

/// `crc8_bit` applied `N` times. This polynomial feeds on the register alone,
/// so unlike the other two the loop counts rather than walking an array.
#[inline]
fn crc8_rounds<#uint N>(crc: uint<8>) -> uint<8> {
    gen if N == 0 {
        crc
    } else {
        crc8_rounds::<{N - 1}>(crc8_bit(crc))
    }
}

pub fn crc8_byte(crc: uint<8>, byte: uint<8>) -> uint<8> {
    crc8_rounds::<8>(crc ^ byte)
}

/// `crc7_bit` over `bits`, most significant first -- the order an SD response
/// puts them on CMD.
#[inline]
fn crc7_over<#uint N>(crc: uint<7>, bits: [bool; N]) -> uint<7> {
    gen if N == 0 {
        crc
    } else {
        crc7_over(crc7_bit(crc, bits.last()), bits[..N - 1])
    }
}

// CRC over the 40 transmitted header/payload bits of an R1/R6/R7 response.
pub fn response48(index: uint<6>, payload: uint<32>) -> uint<48> {
    let body: uint<40> = (zext(index) << 32) | zext(payload);
    let crc = crc7_over(0, body.as_bits());
    (zext(body) << 8) | (zext(crc) << 1) | 1
}
