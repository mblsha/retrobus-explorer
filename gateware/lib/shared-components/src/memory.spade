use super::guards::require_power_of_two;

#[no_mangle(all)]
extern entity async_fifo_v<#uint WIDTH, #uint ENTRIES, #uint SYNC_STAGES>(
    wclk: clock,
    wrst: bool,
    din: uint<WIDTH>,
    wput: bool,
    full: inv bool,
    rclk: clock,
    rrst: bool,
    dout: inv uint<WIDTH>,
    rget: bool,
    empty: inv bool,
);

#[no_mangle(all)]
extern entity sync_fifo_v<#uint WIDTH, #uint ENTRIES>(
    clk: clock,
    rst: bool,
    din: uint<WIDTH>,
    wput: bool,
    full: inv bool,
    dout: inv uint<WIDTH>,
    rget: bool,
    empty: inv bool,
);

impl<T, #uint N> [T; N] {
    fn write_at(self, idx: uint<{uint::bits_for(N - 1)}>, val: T) -> [T; N] {
        self.enumerate().map(fn |(i, item)| {
            if i == idx {
                val
            } else {
                item
            }
        })
    }
}

fn ptr_inc<#uint W>(ptr: uint<W>) -> uint<W> {
    // ENTRIES is expected to be a power of two, so wrapping increment is correct.
    ptr +. 1
}

pub struct FifoOut<T> {
    full: bool,
    empty: bool,
    dout: T,
}

pub struct FifoUsedOut<TData, TUsed> {
    full: bool,
    empty: bool,
    dout: TData,
    used: TUsed,
}

pub type FifoUsed<#uint WIDTH, #uint ENTRIES> =
    FifoUsedOut<uint<WIDTH>, FifoCount<ENTRIES>>;

/// The type of an index into a FIFO's `ENTRIES` storage slots.
pub type FifoAddr<#uint ENTRIES> = uint<{uint::bits_for(ENTRIES - 1)}>;

/// The type of a FIFO's occupancy, which reaches `ENTRIES` and so needs one
/// bit more than an address does.
pub type FifoCount<#uint ENTRIES> = uint<{uint::bits_for(ENTRIES)}>;

// `ADDR_W` and `COUNT_W` are not independent: they are `FifoAddr<ENTRIES>` and
// `FifoCount<ENTRIES>`, restated by the one caller. They stay anyway, because
// v0.20.0 will not evaluate a type expression in a struct member:
//
//     waddr: uint<{uint::bits_for(ENTRIES - 1)}>,
//     error: Struct members cannot have const generics in their type
//
// and routing it through the `FifoAddr<ENTRIES>` alias instead crashes the
// compiler outright ("internal error: entered unreachable code: Const generic in
// type_expr_to_concrete", spade-typeinference/src/mir_type_lowering.rs:201).
// Same answer for `BootBannerState`'s `IDX_W`. Worth retrying after a compiler
// bump; until then the two widths are passed in and the `where` clause above is
// what keeps a caller from passing something inconsistent.
struct FifoImplState<#uint ADDR_W, #uint COUNT_W, #uint WIDTH, #uint ENTRIES> {
    waddr: uint<ADDR_W>,
    waddr_delay: uint<ADDR_W>,
    raddr: uint<ADDR_W>,
    used: uint<COUNT_W>,
    read_data: uint<WIDTH>,
    storage: [uint<WIDTH>; ENTRIES],
}

struct FifoOutPort<T> {
    full: bool,
    empty: bool,
    dout: T,
}

// Synchronous first-word-fall-through FIFO.
// Matches Alchitry's fifo.luc behavior:
// - full when next write pointer equals read pointer (usable depth = ENTRIES-1)
// - empty based on delayed write pointer (first write appears after one extra cycle)
entity fifo_impl<#uint WIDTH, #uint ENTRIES>(
    clk: clock,
    rst: bool,
    din: uint<WIDTH>,
    wput: bool,
    rget: bool,
) -> FifoUsed<WIDTH, ENTRIES>
where
    WIDTH > 0 else "a fifo needs at least one data bit",
    ENTRIES >= 2 else "a fifo needs at least two entries",
{
    let _ = require_power_of_two::<ENTRIES>();

    // Packed state to avoid declaration-order dependency issues across interlocked regs.
    reg(clk) state: FifoImplState<{uint::bits_for(ENTRIES - 1)}, {uint::bits_for(ENTRIES)}, WIDTH, ENTRIES>
        reset(rst: FifoImplState$(
            waddr: 0,
            waddr_delay: 0,
            raddr: 0,
            used: 0,
            read_data: 0,
            storage: [0; ENTRIES],
        ))
        = {
            let waddr: FifoAddr<ENTRIES> = state.waddr;
            let waddr_delay: FifoAddr<ENTRIES> = state.waddr_delay;
            let raddr: FifoAddr<ENTRIES> = state.raddr;
            let used: FifoCount<ENTRIES> = state.used;
            let storage: [uint<WIDTH>; ENTRIES] = state.storage;

            let next_write = ptr_inc(waddr);
            let wrdy = next_write != raddr;
            let rrdy = raddr != waddr_delay;
            let do_write = wput && wrdy;
            let do_read = rget && rrdy;

            let next_waddr = if do_write { next_write } else { waddr };
            let next_raddr = if do_read { ptr_inc(raddr) } else { raddr };
            let next_used = if do_write && !do_read {
                used +. 1
            } else if do_read && !do_write {
                used -. 1
            } else {
                used
            };
            let read_addr = if do_read { ptr_inc(raddr) } else { raddr };
            let next_read_data = storage[read_addr];
            let next_storage = if do_write {
                storage.write_at(waddr, din)
            } else {
                storage
            };

            FifoImplState$(
                waddr: next_waddr,
                waddr_delay: waddr,
                raddr: next_raddr,
                used: next_used,
                read_data: next_read_data,
                storage: next_storage,
            )
        };

    let waddr: FifoAddr<ENTRIES> = state.waddr;
    let waddr_delay: FifoAddr<ENTRIES> = state.waddr_delay;
    let raddr: FifoAddr<ENTRIES> = state.raddr;
    let used: FifoCount<ENTRIES> = state.used;
    let read_data: uint<WIDTH> = state.read_data;

    let next_write = ptr_inc(waddr);
    let wrdy = next_write != raddr;
    let rrdy = raddr != waddr_delay;
    let full = !wrdy;
    let empty = !rrdy;
    FifoUsedOut$(
        full: full,
        empty: empty,
        dout: read_data,
        used: used,
    )
}

pub entity fifo<#uint WIDTH, #uint ENTRIES>(
    clk: clock,
    rst: bool,
    din: uint<WIDTH>,
    wput: bool,
    rget: bool,
) -> FifoUsed<WIDTH, ENTRIES> {
    inst fifo_impl::<WIDTH, ENTRIES>(clk, rst, din, wput, rget)
}

pub entity async_fifo<#uint WIDTH, #uint ENTRIES, #uint SYNC_STAGES = 3>(
    wclk: clock,
    wrst: bool,
    din: uint<WIDTH>,
    wput: bool,
    rclk: clock,
    rrst: bool,
    rget: bool,
) -> FifoOut<uint<WIDTH>>
where
    WIDTH > 0 else "an async fifo needs at least one data bit",
    ENTRIES >= 2 else "an async fifo needs at least two entries",
    SYNC_STAGES > 0 else "an async fifo needs at least one synchronizer stage",
{
    let _ = require_power_of_two::<ENTRIES>();

    let (fifo, fifo_w): (FifoOutPort<uint<WIDTH>>, inv FifoOutPort<uint<WIDTH>>) = port();
    #[verilog_attrs(keep_hierarchy = "yes")]
    let _ = inst async_fifo_v::<WIDTH, ENTRIES, SYNC_STAGES>(
        wclk,
        wrst,
        din,
        wput,
        fifo_w.full,
        rclk,
        rrst,
        fifo_w.dout,
        rget,
        fifo_w.empty,
    );
    FifoOut$(
        full: fifo.full,
        empty: fifo.empty,
        dout: fifo.dout,
    )
}

pub entity sync_fifo<#uint WIDTH, #uint ENTRIES>(
    clk: clock,
    rst: bool,
    din: uint<WIDTH>,
    wput: bool,
    rget: bool,
) -> FifoOut<uint<WIDTH>>
where
    WIDTH > 0 else "a sync fifo needs at least one data bit",
    ENTRIES >= 2 else "a sync fifo needs at least two entries",
{
    let _ = require_power_of_two::<ENTRIES>();

    let (fifo, fifo_w): (FifoOutPort<uint<WIDTH>>, inv FifoOutPort<uint<WIDTH>>) = port();
    #[verilog_attrs(keep_hierarchy = "yes")]
    let _ = inst sync_fifo_v::<WIDTH, ENTRIES>(
        clk,
        rst,
        din,
        wput,
        fifo_w.full,
        fifo_w.dout,
        rget,
        fifo_w.empty,
    );
    FifoOut$(
        full: fifo.full,
        empty: fifo.empty,
        dout: fifo.dout,
    )
}

impl<T> FifoOut<T> {
    #[inline]
    pub entity tap(self, full: inv bool, empty: inv bool, dout: inv T) {
        let full_value = self.full;
        let empty_value = self.empty;
        let dout_value = self.dout;
        set full = full_value;
        set empty = empty_value;
        set dout = dout_value;
    }
}
