use super::{memory::async_fifo, serial::{UartLineBusy, uart_tx_tap}};

pub struct UartFifoBridgeOut<TData, #uint DROP_COUNT_W> {
    line: bool,
    busy: bool,
    fifo_full: bool,
    fifo_empty: bool,
    fifo_dout: TData,
    tx_fire: bool,
    dropped: bool,
    dropped_count: uint<DROP_COUNT_W>,
}

pub type UartBridgeOut<#uint WIDTH, #uint DROP_COUNT_W> =
    UartFifoBridgeOut<uint<WIDTH>, DROP_COUNT_W>;

pub enum BridgePolicy {
    QueueOnly,
    DropWhenBusy,
}

pub entity uart_fifo_bridge<#uint WIDTH, #uint ENTRIES, #uint SYNC_STAGES, #uint CLK_FREQ, #uint BAUD, #uint DROP_COUNT_W>(
    wclk: clock,
    wrst: bool,
    din: uint<WIDTH>,
    wput: bool,
    rclk: clock,
    rrst: bool,
    send_enable: bool,
    policy: BridgePolicy,
) -> UartBridgeOut<WIDTH, DROP_COUNT_W> {
    let (bridge, bridge_w): UartLineBusy = port();

    // The fifo's `rget` is decided by what comes out of it, so the name has to
    // exist before the instantiation that produces it.
    decl fifo_take;
    let drop_when_busy = if let BridgePolicy::DropWhenBusy = policy { true } else { false };
    let fifo = inst async_fifo::<WIDTH, ENTRIES, SYNC_STAGES>(wclk, wrst, din, wput, rclk, rrst, fifo_take);
    let tx_fire = send_enable && !fifo.empty && !bridge.busy;
    let drop_fire = send_enable && !fifo.empty && bridge.busy && drop_when_busy;
    let fifo_take = tx_fire || drop_fire;

    reg(rclk) dropped_count: uint<DROP_COUNT_W> reset(rrst: 0) = {
        if drop_fire {
            dropped_count +. 1
        } else {
            dropped_count
        }
    };

    let _ = inst uart_tx_tap::<CLK_FREQ, BAUD, WIDTH>(
        rclk,
        rrst,
        false,
        fifo.dout,
        tx_fire,
        bridge_w.line,
        bridge_w.busy,
    );

    UartFifoBridgeOut$(
        line: bridge.line,
        busy: bridge.busy,
        fifo_full: fifo.full,
        fifo_empty: fifo.empty,
        fifo_dout: fifo.dout,
        tx_fire: tx_fire,
        dropped: drop_fire,
        dropped_count: dropped_count,
    )
}
