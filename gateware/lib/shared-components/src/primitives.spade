// These two pipelines are the only place in this library where a signal
// crosses a clock domain, so they are where Vivado wants `ASYNC_REG`: it keeps
// the synchronizer's flops together and out of shift-register inference, and
// tells the timing engine not to report the first stage's metastability. The
// attribute cannot go on a `reg`, only on a unit, so it goes here -- on the
// pipeline that holds the flops, not on the wrapper entity.
//
// UNVERIFIED: whether Vivado then applies it to the flops inside. There is no
// Vivado on the machine this was written on, and openXC7 ignores it.
#[verilog_attrs(ASYNC_REG = "TRUE")]
pipeline(STAGES) sync_delay_pipe<#int STAGES>(
    clk: clock,
    input_signal: bool,
) -> bool {
    reg * STAGES;
    input_signal
}

pub entity sync_delay<#int STAGES = 2>(
    clk: clock,
    input_signal: bool,
) -> bool
where STAGES > 0 else "sync_delay needs at least one register stage"
{
    inst(STAGES) sync_delay_pipe::<STAGES>(clk, input_signal)
}

// See `sync_delay_pipe` above for why `ASYNC_REG` sits on the pipeline.
#[verilog_attrs(ASYNC_REG = "TRUE")]
pipeline(STAGES) sync_bundle_pipe<#int STAGES, #uint N>(
    clk: clock,
    input_signals: [bool; N],
) -> [bool; N] {
    reg * STAGES;
    input_signals
}

pub entity sync_bundle<#int STAGES, #uint N>(
    clk: clock,
    input_signals: [bool; N],
) -> [bool; N]
where STAGES > 0 else "sync_bundle needs at least one register stage"
{
    inst(STAGES) sync_bundle_pipe::<STAGES, N>(clk, input_signals)
}

pub enum SyncStagePreset {
    Stages2,
    Stages4,
    Stages6,
}

pub entity sync_delay_safe(
    clk: clock,
    input_signal: bool,
    preset: SyncStagePreset,
) -> bool {
    match preset {
        SyncStagePreset::Stages2 => inst sync_delay::<2>(clk, input_signal),
        SyncStagePreset::Stages4 => inst sync_delay::<4>(clk, input_signal),
        SyncStagePreset::Stages6 => inst sync_delay::<6>(clk, input_signal),
    }
}

pub entity sync_bundle_safe<#uint N>(
    clk: clock,
    input_signals: [bool; N],
    preset: SyncStagePreset,
) -> [bool; N] {
    match preset {
        SyncStagePreset::Stages2 => inst sync_bundle::<2, N>(clk, input_signals),
        SyncStagePreset::Stages4 => inst sync_bundle::<4, N>(clk, input_signals),
        SyncStagePreset::Stages6 => inst sync_bundle::<6, N>(clk, input_signals),
    }
}

pub struct Z80ControlSync {
    m1: bool,
    mreq: bool,
    iorq: bool,
    rd: bool,
    wr: bool,
}

pub entity sync_z80_controls_n<#int M1_STAGES, #int MREQ_STAGES, #int IORQ_STAGES, #int RD_STAGES, #int WR_STAGES>(
    clk: clock,
    m1: bool,
    mreq: bool,
    iorq: bool,
    rd: bool,
    wr: bool,
) -> Z80ControlSync {
    let m1_sync = inst sync_delay::<M1_STAGES>(clk, m1);
    let mreq_sync = inst sync_delay::<MREQ_STAGES>(clk, mreq);
    let iorq_sync = inst sync_delay::<IORQ_STAGES>(clk, iorq);
    let rd_sync = inst sync_delay::<RD_STAGES>(clk, rd);
    let wr_sync = inst sync_delay::<WR_STAGES>(clk, wr);
    Z80ControlSync$(
        m1: m1_sync,
        mreq: mreq_sync,
        iorq: iorq_sync,
        rd: rd_sync,
        wr: wr_sync,
    )
}

pub entity reset_conditioner<#uint STAGES = 4>(
    clk: clock,
    in_reset: bool,
) -> bool
where STAGES > 0 else "reset_conditioner needs at least one register stage"
{
    // Alchitry-style conditioner: assert immediately via `in_reset`, then push a
    // `false` in at the bottom every cycle, so the top of the shift register
    // only clears once STAGES of them have walked through it.
    reg(clk) stages: [bool; STAGES] reset(in_reset: [true; STAGES]) =
        [false].concat(stages[..STAGES - 1]);
    in_reset || stages.last()
}

// The standard library grew these in 0.18 and its versions are identical to the
// ones this file carried: one unreset register holding the previous value, and
// `value && !old` / `!value && old` off it. Same first-cycle behaviour, same
// absence of a reset, same single flop. Re-exporting rather than re-writing
// keeps `primitives::{rising_edge, falling_edge}` working at the seven call
// sites and in the two testbench tops.
pub use std::io::rising_edge;
pub use std::io::falling_edge;

pub entity counter<#uint WIDTH>(
    clk: clock,
    rst: bool,
) -> uint<WIDTH> {
    reg(clk) value: uint<WIDTH> reset(rst: 0) = value +. 1;
    value
}
